---
import RootLayout from '../layouts/RootLayout.astro';

const projects = [
  {
    title: 'HYPE-BOX Platform',
    category: 'Full-Stack Architecture',
    year: '2026',
    description: 'Enterprise photobooth kiosk OS, real-time WebSocket backend, and multi-tenant vendor management portal.',
    tags: ['React', 'Laravel', 'Electron', 'SQLite'],
  },
  {
    title: 'High-Performance SEO Engine',
    category: 'Frontend Engineering',
    year: '2026',
    description: 'Zero-JS static site architecture with React islands, dynamic sitemaps, and rich Schema.org metadata.',
    tags: ['Astro', 'React', 'Tailwind CSS', 'Schema.org'],
  },
];
---

<RootLayout
  title="Portfolio Index | Project Archive & Case Studies"
  description="Comprehensive index of engineering projects, web architectures, and production applications."
>
  <div class="space-y-6">
    <div class="border-b border-neutral-200 dark:border-neutral-800 pb-4">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-white">
        Portfolio Index
      </h1>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
        Selected production projects, system architectures, and technical experiments.
      </p>
    </div>

    <div class="space-y-4">
      {projects.map((project) => (
        <article class="p-5 rounded-lg border border-neutral-200 dark:border-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h2 class="text-base font-semibold text-neutral-950 dark:text-white">{project.title}</h2>
            <div class="flex items-center gap-2 text-xs text-neutral-500">
              <span>{project.category}</span>
              <span>•</span>
              <span>{project.year}</span>
            </div>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">
            {project.description}
          </p>
          <div class="flex flex-wrap gap-1.5 mt-4">
            {project.tags.map((tag) => (
              <span class="text-xs px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-800">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</RootLayout>
