---
import RootLayout from "../layouts/RootLayout.astro";
import KioskButton from "../components/KioskButton.astro";
import SquareWaveLoader from "../components/SquareWaveLoader.astro";
import StatusBadge from "../components/StatusBadge.astro";
import MetricCard from "../components/MetricCard.astro";
import ProjectTile from "../components/ProjectTile.astro";
---

<RootLayout
  title="Component Library | Editorial & Systems UI Primitives"
  description="Design system, typography specimens, color tokens, and UI primitives architected for this Portfolio."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-16">
    <!-- Header -->
    <header class="border-b border-neutral-200 dark:border-neutral-800 pb-8">
      <h1
        class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white"
      >
        Component Library
      </h1>
      <p
        class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl font-normal"
      >
        A showcase of typography, color tokens, and interactive UI primitives.
      </p>
    </header>

    <!-- 01 / Color Tokens -->
    <section class="space-y-6">
      <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2
          class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
        >
          01 / Color Tokens
        </h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        <!-- Neon Green Accent -->
        <div class="flex flex-col gap-2">
          <div
            class="w-full aspect-video bg-[#52FF1A] border border-black/10 shadow-[0_0_20px_rgba(82,255,26,0.3)]"
          >
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Accent Neon</span
            >
            <span class="font-mono text-[11px] text-neutral-500">#52FF1A</span>
          </div>
        </div>

        <!-- Primary Background -->
        <div class="flex flex-col gap-2">
          <div
            class="w-full aspect-video bg-[#fcfbf9] dark:bg-[#0e0e0e] border border-neutral-300 dark:border-neutral-700"
          >
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Surface Base</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >#fcfbf9 / #0e0e0e</span
            >
          </div>
        </div>

        <!-- Ink Text -->
        <div class="flex flex-col gap-2">
          <div
            class="w-full aspect-video bg-[#1a1a1a] dark:bg-[#e5e5e5] border border-neutral-300 dark:border-neutral-700"
          >
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Text Primary</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >#1a1a1a / #e5e5e5</span
            >
          </div>
        </div>

        <!-- Secondary Surface -->
        <div class="flex flex-col gap-2">
          <div
            class="w-full aspect-video bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300 dark:border-neutral-700"
          >
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Surface Card</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >#f6f4ee / #141414</span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- 02 / Buttons -->
    <section class="space-y-6">
      <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2
          class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
        >
          02 / Buttons (CTA, Primary, Secondary)
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- CTA Variant -->
        <div class="flex flex-col gap-4">
          <div class="flex flex-col items-start">
            <KioskButton variant="cta">INCIPE SESSIONEM</KioskButton>
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >CTA Pulse</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >variant="cta" • Syne 700</span
            >
          </div>
        </div>

        <!-- Primary Variant -->
        <div class="flex flex-col gap-4">
          <div class="flex flex-col items-start">
            <KioskButton variant="primary">CONFIRMA ET IMPRIME</KioskButton>
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Primary Solid</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >variant="primary" • Syne 700</span
            >
          </div>
        </div>

        <!-- Secondary Variant -->
        <div class="flex flex-col gap-4">
          <div class="flex flex-col items-start">
            <KioskButton variant="secondary">REDI AD PINACOTHECAM</KioskButton>
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Secondary Dashed</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >variant="secondary" • Syne 700</span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- 03 / Loaders -->
    <section class="space-y-6">
      <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2
          class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
        >
          03 / Loaders (Square Wave)
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        <!-- Accent Neon Loader -->
        <div class="flex flex-col gap-4">
          <div class="h-28 flex items-center justify-start">
            <SquareWaveLoader color="#52FF1A" size={14} gap={8} />
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Square Wave / Accent</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >count=5 • size=14 • #52FF1A</span
            >
          </div>
        </div>

        <!-- Surface Contrast Loader -->
        <div class="flex flex-col gap-4">
          <div
            class="h-28 flex items-center justify-start text-neutral-900 dark:text-white"
          >
            <SquareWaveLoader size={14} gap={8} />
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Square Wave / Ink</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >count=5 • size=14 • currentColor</span
            >
          </div>
        </div>

        <!-- Micro Loader -->
        <div class="flex flex-col gap-4">
          <div
            class="h-28 flex items-center justify-start text-neutral-500 dark:text-neutral-400"
          >
            <SquareWaveLoader count={4} size={8} gap={5} />
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Square Wave / Micro</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >count=4 • size=8 • currentColor</span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- 04 / Typography -->
    <section class="space-y-8">
      <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2
          class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
        >
          04 / Typography Hierarchy
        </h2>
      </div>

      <div class="space-y-12">
        <!-- Display & Headings (Syne) -->
        <div class="space-y-6">
          <div class="flex items-center gap-2">
            <span
              class="font-mono text-xs font-semibold text-neutral-400 uppercase tracking-wider"
              >04.1 — Display & Headings</span
            >
          </div>

          <div
            class="space-y-8 border-l-2 border-neutral-200 dark:border-neutral-800 pl-6"
          >
            <!-- H1 Display -->
            <div class="flex flex-col gap-2">
              <h1
                class="text-4xl sm:text-5xl font-extrabold tracking-tight text-neutral-950 dark:text-white"
              >
                Systemata Visualia Architectata
              </h1>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Heading 1 / Display</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >Syne 800 • text-4xl sm:text-5xl • tracking-tight</span
                >
              </div>
            </div>

            <!-- H2 Section -->
            <div class="flex flex-col gap-2">
              <h2
                class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-950 dark:text-white"
                style="font-family: var(--font-heading);"
              >
                Architectura Editorialis et Interfacies
              </h2>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Heading 2 / Section</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >Syne 700 • text-2xl sm:text-3xl • tracking-tight</span
                >
              </div>
            </div>

            <!-- H3 Subtitle -->
            <div class="flex flex-col gap-2">
              <h3
                class="text-lg sm:text-xl font-bold tracking-normal text-neutral-950 dark:text-white"
              >
                Elementa Interactiva et Fundamenta Telemetriae
              </h3>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Heading 3 / Subtitle</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >Syne 700 • text-lg sm:text-xl</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Body & Editorial (Outfit) -->
        <div class="space-y-6">
          <div class="flex items-center gap-2">
            <span
              class="font-mono text-xs font-semibold text-neutral-400 uppercase tracking-wider"
              >04.2 — Body & Editorial Text</span
            >
          </div>

          <div
            class="space-y-8 border-l-2 border-neutral-200 dark:border-neutral-800 pl-6"
          >
            <!-- Body Lead -->
            <div class="flex flex-col gap-2">
              <p
                class="text-lg sm:text-xl text-neutral-800 dark:text-neutral-200 font-normal leading-relaxed max-w-3xl"
              >
                Portfolio summae efficacitatis cum Astro et Tailwind CSS v4
                constructum, typographiam severam cum experimentis technicis
                coniungens.
              </p>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Body Lead / Intro</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >Outfit 400 • text-lg sm:text-xl • leading-relaxed</span
                >
              </div>
            </div>

            <!-- Body Regular -->
            <div class="flex flex-col gap-2">
              <p
                class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 font-normal leading-relaxed max-w-3xl"
              >
                Elementa pura et distincta, ad celeriter onerandum, rhythmum
                typographicum severum, nihil oneris runtime, et formas
                flexibiles aptata.
              </p>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Body Regular / Paragraph</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >Outfit 400 • text-sm sm:text-base • leading-relaxed</span
                >
              </div>
            </div>

            <!-- Body Small / Caption -->
            <div class="flex flex-col gap-2">
              <p
                class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 font-normal"
              >
                Schema structum ad machinas quaerendi, prae-generatio statica,
                et fines hydrationis instantanei.
              </p>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Body Small / Caption</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >Outfit 400 • text-xs sm:text-sm</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 / Status Badges -->
    <section class="space-y-6">
      <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2
          class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
        >
          05 / Status Badges (High-Contrast Solid)
        </h2>
      </div>

      <div class="space-y-8">
        <!-- High Contrast Badges -->
        <div class="flex flex-col gap-4">
          <div class="flex flex-wrap items-center gap-3">
            <StatusBadge variant="accent">STATUS_VIVUS</StatusBadge>
            <StatusBadge variant="neutral">VERSIO_STABILIS</StatusBadge>
            <StatusBadge variant="warning">SYNCHRONIZATIO</StatusBadge>
            <StatusBadge variant="danger">NON_CONNEXUM</StatusBadge>
            <StatusBadge variant="info">STAGIO_PROBATIO</StatusBadge>
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Solid Status Variants</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >rounded (4px) • high-contrast solid • Outfit Bold text-xs</span
            >
          </div>
        </div>

        <!-- Compact Technical Tags -->
        <div class="flex flex-col gap-4">
          <div class="flex flex-wrap items-center gap-2.5">
            <StatusBadge variant="accent" size="sm">0KB JS PRIMUM</StatusBadge>
            <StatusBadge variant="neutral" size="sm">ASTRO v5</StatusBadge>
            <StatusBadge variant="neutral" size="sm">TAILWIND v4</StatusBadge>
            <StatusBadge variant="info" size="sm">REACT 19</StatusBadge>
            <StatusBadge variant="warning" size="sm">VERSIO CANARIA</StatusBadge
            >
            <StatusBadge variant="danger" size="sm">DEPRECATUM</StatusBadge>
          </div>
          <div class="flex flex-col">
            <span
              class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
              >Compact Tech Stack Badges</span
            >
            <span class="font-mono text-[11px] text-neutral-500"
              >size="sm" • rounded (4px) • text-[10px] tracking-wider</span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- 06 / Metric Cards -->
    <section class="space-y-6">
      <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2
          class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
        >
          06 / Metric Cards (Editorial Telemetry)
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <MetricCard
          label="01 // LIGHTHOUSE PERF"
          value="100/100"
          trend="OPTIMUM"
          subtext="Optimisatio, Praestantia, et Mores Optimi"
          accent={true}
        />
        <MetricCard
          label="02 // JS RUNTIME PAYLOAD"
          value="0 KB"
          badge="STATIC_SSR"
          badgeVariant="accent"
          subtext="Nihil oneris JavaScript in pagina oneranda"
        />
        <MetricCard
          label="03 // ANIMATION BUDGET"
          value="60 FPS"
          badge="HARDWARE_ACCEL"
          badgeVariant="info"
          subtext="Formae GPU acceleratae et physica motus"
        />
      </div>
    </section>

    <!-- 07 / Project Tiles -->
    <section class="space-y-6">
      <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2
          class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
        >
          07 / Project Tiles (Case Study Cards)
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <ProjectTile
          title="HYPE-BOX SYSTEMA TABERNAE"
          category="01 // SYSTEMA INTERACTIVUM"
          description="Programma tabernae photographicae tactu directum, cum motu sexaginta imaginum per secundum et ordine sine interrete firmo."
          status="STATUS_VIVUS"
          statusVariant="accent"
          tags={["ELECTRON", "REACT 19", "TAILWIND v4", "SQLITE"]}
        />
        <ProjectTile
          title="PORTA CURATORIS TABERNAE"
          category="02 // PLATFORMA CURATIONIS"
          description="Analytica summae praestantiae, gubernatio telemetriae tabernae, designator formarum, et ordinatio solutionum."
          status="VERSIO_STABILIS"
          statusVariant="neutral"
          tags={["LARAVEL 13", "REVERB", "FILAMENT", "MIDTRANS"]}
        />
      </div>
    </section>

    <!-- 08 / Directory & Tree Index Pattern -->
    <section class="space-y-10">
      <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2
          class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
        >
          08 / Directory & Tree Index Pattern (With Brand Logo Headers)
        </h2>
      </div>

      <!-- Category 1: Typography Logo Header (5 items) -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span
            class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100 uppercase tracking-wider"
          >
            Sample Cat 01 — Typography Logo Header
          </span>
          <span class="font-mono text-[11px] text-neutral-500"
            >brand type mark • Syne 700 titles • 5 items</span
          >
        </div>

        <div
          class="border border-neutral-300/80 dark:border-neutral-800 bg-[#f6f4ee] dark:bg-[#141414] p-5 sm:p-7 space-y-6 font-sans rounded-md"
        >
          <!-- Top Logo Header: Typography Logo -->
          <div
            class="flex items-center gap-3 pb-4 border-b border-neutral-200/80 dark:border-neutral-800/80"
          >
            <div
              class="text-xl sm:text-2xl font-black tracking-tight text-neutral-950 dark:text-white leading-none"
              style="font-family: 'Syne', sans-serif;"
            >
              HYPE-BOX
            </div>
            <span
              class="text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 font-semibold pl-3 border-l border-neutral-300 dark:border-neutral-700"
            >
              CLASSIS SYSTEMATIS
            </span>
          </div>

          <!-- Items 1 to 5 -->
          <!-- Item 1 -->
          <div class="space-y-1.5 group">
            <div
              class="flex items-center gap-2 sm:gap-2.5 flex-wrap sm:flex-nowrap min-w-0"
            >
              <span
                class="text-neutral-400 dark:text-neutral-600 select-none font-sans font-medium text-sm shrink-0"
                >├──</span
              >
              <span
                class="text-xs text-neutral-500 font-semibold font-sans shrink-0"
                >2026</span
              >
              <h3
                class="text-sm sm:text-base text-neutral-950 dark:text-white group-hover:text-[#52FF1A] transition-colors font-sans"
                style="font-family: 'Syne', sans-serif; font-weight: 700;"
              >
                <a
                  href="https://navoyovan.github.io/hypebox/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline focus:outline-none inline-flex items-center gap-1.5"
                >
                  <span>HYPE-BOX Pagina Prima</span>
                  <span
                    class="opacity-0 -translate-x-1.5 translate-y-0.5 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-200 ease-out text-neutral-400 dark:text-neutral-500 group-hover:!text-[#52FF1A]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-3.5 h-3.5 sm:w-4 sm:h-4"
                      viewBox="0 0 24 24"
                      stroke-width="2.5"
                      stroke="currentColor"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                      <path d="M17 7l-10 10"></path>
                      <path d="M8 7l9 0l0 9"></path>
                    </svg>
                  </span>
                </a>
              </h3>
            </div>
            <div
              class="pl-7 sm:pl-8 text-[11px] text-neutral-400 dark:text-neutral-500 flex items-center gap-1.5 font-sans flex-wrap"
            >
              <span class="text-neutral-300 dark:text-neutral-700 select-none"
                >└──</span
              >
              <span
                class="text-neutral-400 dark:text-neutral-600 font-medium shrink-0 mr-1"
                >stack:</span
              >
              <span
                class="text-neutral-500 dark:text-neutral-400 flex items-center flex-wrap"
              >
                <span>Astro</span>
                <span
                  class="text-neutral-300 dark:text-neutral-700 mx-1.5 select-none text-[8px]"
                  >•</span
                >
                <span>Tailwind CSS v4</span>
              </span>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="space-y-1.5 group">
            <div
              class="flex items-center gap-2 sm:gap-2.5 flex-wrap sm:flex-nowrap min-w-0"
            >
              <span
                class="text-neutral-400 dark:text-neutral-600 select-none font-sans font-medium text-sm shrink-0"
                >├──</span
              >
              <span
                class="text-xs text-neutral-500 font-semibold font-sans shrink-0"
                >2026</span
              >
              <h3
                class="text-sm sm:text-base text-neutral-950 dark:text-white group-hover:text-[#52FF1A] transition-colors font-sans"
                style="font-family: 'Syne', sans-serif; font-weight: 700;"
              >
                Taberna Photographica
              </h3>
            </div>
            <div
              class="pl-7 sm:pl-8 text-[11px] text-neutral-400 dark:text-neutral-500 flex items-center gap-1.5 font-sans flex-wrap"
            >
              <span class="text-neutral-300 dark:text-neutral-700 select-none"
                >└──</span
              >
              <span
                class="text-neutral-400 dark:text-neutral-600 font-medium shrink-0 mr-1"
                >stack:</span
              >
              <span
                class="text-neutral-500 dark:text-neutral-400 flex items-center flex-wrap"
              >
                <span>Electron</span>
                <span
                  class="text-neutral-300 dark:text-neutral-700 mx-1.5 select-none text-[8px]"
                  >•</span
                >
                <span>React 19</span>
                <span
                  class="text-neutral-300 dark:text-neutral-700 mx-1.5 select-none text-[8px]"
                  >•</span
                >
                <span>Anime.js</span>
                <span
