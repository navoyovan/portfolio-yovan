---
// Hero.astro — Pure server-rendered static Hero with Syne 900 and clean editorial row spacing
interface Props {
  firstName?: string;
  middleName?: string;
  lastName?: string;
}

const {
  firstName = "yovan",
  middleName = "gunardio",
  lastName = "darmawan",
} = Astro.props;
---

<section
  id="greeting"
  class="hero-loading relative min-h-[70vh] flex items-center justify-start z-10 py-16 sm:py-24 w-full overflow-hidden"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex flex-col items-start z-10"
  >
    <div
      class="hero-title-group select-none flex flex-col leading-none -ml-2 sm:-ml-6 md:-ml-10 lg:-ml-16 xl:-ml-20"
      style="padding-left: var(--anchor, clamp(1.5rem, 3.5vw, 3rem)); --anchor: clamp(1.5rem, 3.5vw, 3rem);"
    >
      <!-- Row 1: < yovan /> -->
      <h1
        id="hero-h1"
        class="hero-h1 relative inline-flex items-baseline whitespace-nowrap leading-[0.9] m-0 p-0 text-neutral-950 dark:text-white"
        style="font-family: 'Syne', sans-serif; font-weight: 900; letter-spacing: -0.04em; margin-bottom: clamp(0.15rem, 0.6vw, 0.5rem);"
      >
        <span
          id="hero-bracket-l"
          class="hero-h1-bracket-l absolute right-full mr-[0.1em] select-none text-neutral-950 dark:text-white"
          style="bottom: 0.15em; opacity: 0.6; font-weight: 900;">&lt;</span
        >
        <span id="hero-title-text">{firstName}</span>
        <span
          id="hero-bracket-r"
          class="hero-h1-bracket-r ml-[0.1em] self-end select-none text-neutral-950 dark:text-white"
          style="margin-bottom: 0.15em; opacity: 0.6; font-weight: 900;"
          >&nbsp;/&gt;</span
        >
      </h1>

      <!-- Row 2: gunardio; -->
      <h2
        id="hero-h2"
        class="hero-h2 inline-flex items-baseline whitespace-nowrap border-none p-0 m-0 leading-[0.95] text-neutral-950 dark:text-white"
        style="font-family: 'Syne', sans-serif; font-weight: 700; letter-spacing: -0.03em; margin-bottom: clamp(0.15rem, 0.5vw, 0.4rem);"
      >
        <span>{middleName}</span>
        <span
          class="hero-h2-semi text-neutral-950 dark:text-white"
          style="opacity: 0.6; margin-left: 0.05em; font-weight: 700;">;</span
        >
      </h2>

      <!-- Row 3: // darmawan -->
      <h3
        id="hero-h3"
        class="hero-h3 relative inline-flex items-baseline whitespace-nowrap p-0 m-0 leading-[1]"
        style="font-family: 'Syne', sans-serif; font-weight: 400; letter-spacing: 0.06em;"
      >
        <span
          class="hero-h3-slashes text-[#52FF1A] mr-[0.25em] select-none"
          style="font-weight: 400;">//</span
        >
        <span style="color: var(--text-secondary); opacity: 0.45;"
          >{lastName}</span
        >
      </h3>
    </div>
  </div>
</section>

<script>
  const initHero = () => {
    const greeting = document.getElementById("greeting");
    if (greeting && greeting.classList.contains("hero-loading")) {
      setTimeout(() => {
        greeting.classList.remove("hero-loading");
      }, 2000);
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHero);
  } else {
    initHero();
  }
  document.addEventListener("astro:page-load", initHero);
</script>
