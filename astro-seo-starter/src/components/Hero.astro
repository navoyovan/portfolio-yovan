---
// Hero.astro — Pure server-rendered static Hero with Syne 900 and extra-tight row spacing
interface Props {
  firstName?: string;
  middleName?: string;
  lastName?: string;
}

const {
  firstName = 'yovan',
  middleName = 'gunardio',
  lastName = 'darmawan'
} = Astro.props;
---

<section
  id="greeting"
  class="relative min-h-[75vh] flex items-center justify-start z-10 py-16 sm:py-24 w-full overflow-hidden"
>
  <div
    class="w-full flex flex-col items-start z-10"
    style="margin-left: clamp(2.5rem, 9vw, 13rem); margin-top: clamp(1rem, 5vh, 4rem);"
  >
    <div
      class="hero-title-group select-none flex flex-col leading-none"
      style="padding-left: var(--anchor, clamp(3rem, 8vw, 7rem)); --anchor: clamp(3rem, 8vw, 7rem);"
    >
      <!-- Row 1: < yovan /> -->
      <h1
        id="hero-h1"
        class="hero-h1 relative inline-flex items-baseline whitespace-nowrap leading-[0.82] m-0 p-0 text-neutral-950 dark:text-white"
        style="font-family: 'Syne', sans-serif; font-weight: 900; letter-spacing: -0.04em; margin-bottom: clamp(-2.35rem, -4.6vw, -1.35rem);"
      >
        <span
          id="hero-bracket-l"
          class="hero-h1-bracket-l absolute right-full mr-[0.1em] select-none text-neutral-950 dark:text-white"
          style="bottom: 0.15em; opacity: 0.6; font-weight: 900;"
        >&lt;</span>
        <span id="hero-title-text">{firstName}</span>
        <span
          id="hero-bracket-r"
          class="hero-h1-bracket-r ml-[0.1em] self-end select-none text-neutral-950 dark:text-white"
          style="margin-bottom: 0.15em; opacity: 0.6; font-weight: 900;"
        >&nbsp;/&gt;</span>
      </h1>

      <!-- Row 2: gunardio; -->
      <h2
        id="hero-h2"
        class="hero-h2 inline-flex items-baseline whitespace-nowrap border-none p-0 m-0 leading-[0.82] text-neutral-950 dark:text-white"
        style="font-family: 'Syne', sans-serif; font-weight: 900; letter-spacing: -0.03em; margin-bottom: clamp(-0.45rem, -1vw, -0.2rem);"
      >
        <span>{middleName}</span>
        <span
          class="hero-h2-semi text-neutral-950 dark:text-white"
          style="opacity: 0.6; margin-left: 0.05em; font-weight: 900;"
        >;</span>
      </h2>

      <!-- Row 3: // darmawan -->
      <h3
        id="hero-h3"
        class="hero-h3 relative inline-flex items-baseline whitespace-nowrap p-0 m-0 leading-[0.95]"
        style="font-family: 'Syne', sans-serif; font-weight: 400; letter-spacing: 0.06em;"
      >
        <span
          class="hero-h3-slashes text-[#52FF1A] mr-[0.25em] select-none"
          style="font-weight: 400;"
        >//</span>
        <span
          style="color: var(--text-secondary); opacity: 0.45;"
        >{lastName}</span>
      </h3>
    </div>
  </div>
</section>
