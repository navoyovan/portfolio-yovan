---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Component Library', href: '/component-library' },
  { label: 'Portfolio Index', href: '/portfolio-index' },
];
---

<header class="w-full border-b border-neutral-200 bg-white/80 backdrop-blur-md dark:border-neutral-800 dark:bg-neutral-950/80 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <div class="flex items-center">
      <a
        href="/"
        aria-label="Home"
        class="text-sm sm:text-base font-extrabold tracking-tight text-neutral-950 dark:text-white hover:opacity-80 transition-opacity"
        style="font-family: var(--font-heading);"
      >
        &lt;&nbsp;yovan&nbsp;/&gt;
      </a>
    </div>

    <nav aria-label="Main Navigation">
      <ul class="flex items-center gap-1 sm:gap-2">
        {navItems.map((item) => {
          const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'text-xs sm:text-sm font-medium px-3 py-1.5 rounded-md transition-colors',
                  isActive
                    ? 'text-neutral-950 dark:text-white bg-neutral-100 dark:bg-neutral-900 font-semibold'
                    : 'text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white hover:bg-neutral-50 dark:hover:bg-neutral-900/50',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
