---
interface Props {
  city?: string;
  country?: string;
  timezone?: string;
  lat?: number;
  lng?: number;
  zoom?: number;
}

const {
  city = "BOGOR",
  country = "INDONESIA",
  timezone = "UTC+7",
  lat = -6.5971,
  lng = 106.8060,
  zoom = 13,
} = Astro.props;
---

<div
  class="hero-map-widget relative w-full max-w-xl lg:max-w-md mx-0 rounded-lg sm:rounded-xl border border-neutral-300/80 dark:border-neutral-800/80 bg-[#fcfbf9] dark:bg-[#0e0e0e] overflow-hidden shadow-2xl shadow-black/10 dark:shadow-black/60 aspect-square group select-none"
  data-lat={lat}
  data-lng={lng}
  data-zoom={zoom}
>
  <!-- Map Target Canvas (Undraggable & Non-interactive) -->
  <div id="hero-leaflet-map" class="w-full h-full bg-[#e8e6df] dark:bg-[#121212] z-10 pointer-events-none"></div>

  <!-- Floating Location Badge at Top -->
  <div
    id="hero-map-badge"
    class="absolute top-5 left-5 sm:top-6 sm:left-6 z-30 flex items-center gap-2 sm:gap-2.5 px-4 sm:px-4.5 py-2 sm:py-2.5 rounded-full bg-white/80 dark:bg-black/50 backdrop-blur-xl border border-black/10 dark:border-white/15 shadow-lg select-none pointer-events-auto transition-all duration-300"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-neutral-800 dark:text-white/80 shrink-0"
      aria-hidden="true"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
      <path d="M18.364 4.636a9 9 0 0 1 .203 12.519l-.203 .21l-4.243 4.242a3 3 0 0 1 -4.097 .135l-.144 -.135l-4.244 -4.243a9 9 0 0 1 12.728 -12.728zm-6.364 3.364a3 3 0 1 0 0 6a3 3 0 0 0 0 -6" />
    </svg>
    <span
      id="hero-map-location-label"
      class="font-sans text-xs sm:text-sm font-medium text-neutral-900 dark:text-white/90 transition-all duration-200 inline-block"
    >
      Bogor
    </span>
  </div>

  <!-- Floating Circle Zoom Action Button at Bottom -->
  <button
    type="button"
    id="hero-map-zoom-btn"
    aria-label="Toggle Jabodetabek View"
    title="Expand to Jabodetabek"
    class="absolute bottom-5 right-5 sm:bottom-6 sm:right-6 z-30 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white/95 dark:bg-black/90 backdrop-blur-md border border-neutral-300 dark:border-white/15 shadow-xl inline-flex items-center justify-center text-neutral-900 dark:text-white hover:border-neutral-900 dark:hover:border-white hover:text-[#52FF1A] transition-all select-none pointer-events-auto cursor-pointer active:scale-95 group/btn"
  >
    <i
      id="hero-map-zoom-icon"
      class="ti ti-arrows-maximize text-base sm:text-lg group-hover/btn:scale-110 transition-transform"
    ></i>
  </button>
</div>

<style is:global>
  /* Clean Leaflet Overrides */
  .leaflet-container {
    font-family: inherit;
    background: transparent !important;
    cursor: default !important;
  }
  .leaflet-control-attribution {
    display: none !important;
  }
</style>

<script>
  const initLeafletMap = () => {
    const mapEl = document.getElementById('hero-leaflet-map');
    if (!mapEl) return;

    const widget = mapEl.closest('.hero-map-widget') as HTMLElement;
    if (!widget) return;

    const lat = parseFloat(widget.dataset.lat || '-6.5971');
    const lng = parseFloat(widget.dataset.lng || '106.8060');
    const zoom = parseInt(widget.dataset.zoom || '13', 10);

    const loadScript = (src: string): Promise<void> => {
      return new Promise((resolve, reject) => {
        if (document.querySelector(`script[src="${src}"]`)) {
          resolve();
          return;
        }
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => resolve();
        s.onerror = reject;
        document.head.appendChild(s);
      });
    };

    const loadCSS = (href: string) => {
      if (document.querySelector(`link[href="${href}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      document.head.appendChild(link);
    };

    loadCSS('https://unpkg.com/leaflet@1.9.4/dist/leaflet.css');

    loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js').then(() => {
      const L = (window as any).L;
      if (!L) return;

      if ((mapEl as any)._leaflet_map) {
        (mapEl as any)._leaflet_map.remove();
      }

      const map = L.map(mapEl, {
        center: [lat, lng],
        zoom: zoom,
        zoomControl: false,
        attributionControl: false,
        dragging: false,
        touchZoom: false,
        doubleClickZoom: false,
        scrollWheelZoom: false,
        boxZoom: false,
        keyboard: false,
      });

      (mapEl as any)._leaflet_map = map;

      const lightBaseUrl = 'https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png';
      const darkBaseUrl = 'https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png';

      let currentBaseLayer: any = null;

      const updateTileTheme = () => {
        const isDark = document.documentElement.classList.contains('dark');
        const baseUrl = isDark ? darkBaseUrl : lightBaseUrl;

        if (currentBaseLayer) {
          map.removeLayer(currentBaseLayer);
        }

        currentBaseLayer = L.tileLayer(baseUrl, {
          subdomains: 'abcd',
          maxZoom: 19,
        }).addTo(map);
      };

      updateTileTheme();

      // Zoom Out / In Toggle Logic (Bogor <-> Jabodetabek)
      const zoomBtn = document.getElementById('hero-map-zoom-btn');
      const zoomIcon = document.getElementById('hero-map-zoom-icon');
      const locationLabel = document.getElementById('hero-map-location-label');
      let isJabodetabek = false;

      const setLocationText = (text: string) => {
        if (!locationLabel) return;
        locationLabel.style.opacity = '0';
        locationLabel.style.transform = 'translateY(-3px)';
        setTimeout(() => {
          locationLabel.textContent = text;
          locationLabel.style.opacity = '1';
          locationLabel.style.transform = 'translateY(0)';
        }, 150);
      };

      if (zoomBtn && zoomIcon) {
        zoomBtn.addEventListener('click', () => {
          isJabodetabek = !isJabodetabek;
          if (isJabodetabek) {
            // Fly to Jabodetabek wide center and zoom
            map.flyTo([-6.30, 106.85], 10, { duration: 1.2 });
            zoomIcon.className = 'ti ti-arrows-minimize text-base sm:text-lg group-hover/btn:scale-110 transition-transform';
            zoomBtn.setAttribute('title', 'Focus on Kota Bogor');
            setLocationText('Jabodetabek');
          } else {
            // Fly back to Kota Bogor focus
            map.flyTo([lat, lng], zoom, { duration: 1.2 });
            zoomIcon.className = 'ti ti-arrows-maximize text-base sm:text-lg group-hover/btn:scale-110 transition-transform';
            zoomBtn.setAttribute('title', 'Expand to Jabodetabek');
            setLocationText('Bogor');
          }
        });
      }

      const observer = new MutationObserver(() => {
        updateTileTheme();
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLeafletMap);
  } else {
    initLeafletMap();
  }
  document.addEventListener('astro:page-load', initLeafletMap);
</script>
