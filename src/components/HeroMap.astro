---
interface Props {
  city?: string;
  country?: string;
  timezone?: string;
  lat?: number;
  lng?: number;
  zoom?: number;
}

const {
  lat = -6.6120,
  lng = 106.7640,
  zoom = 14,
} = Astro.props;
---

<div
  class="hero-map-background absolute inset-0 w-full h-full overflow-hidden pointer-events-none select-none z-0"
  data-lat={lat}
  data-lng={lng}
  data-zoom={zoom}
  aria-hidden="true"
>
  <!-- Leaflet Map Canvas -->
  <div
    id="hero-leaflet-map"
    class="w-full h-full bg-[#fcfbf9] dark:bg-[#0e0e0e] opacity-90 dark:opacity-80 transition-opacity duration-500"
  ></div>

  <!-- Radial & Linear Gradient Scrims (Minimal left edge protection for typography, maximum map exposure) -->
  <div
    class="absolute inset-y-0 left-0 w-full sm:w-[42%] lg:w-[32%] bg-gradient-to-r from-[#fcfbf9]/80 via-[#fcfbf9]/30 to-transparent dark:from-[#0e0e0e]/85 dark:via-[#0e0e0e]/30 dark:to-transparent pointer-events-none z-[1]"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-[#fcfbf9]/20 via-transparent to-[#fcfbf9] dark:from-[#0e0e0e]/20 dark:via-transparent dark:to-[#0e0e0e] pointer-events-none z-[1]"
  ></div>
</div>

<style is:global>
  /* Clean Leaflet Overrides */
  .leaflet-container {
    font-family: inherit;
    background: transparent !important;
    cursor: default !important;
  }
  .leaflet-control-attribution {
    display: none !important;
  }
</style>

<script>
  const initLeafletMap = () => {
    const mapEl = document.getElementById('hero-leaflet-map');
    if (!mapEl) return;

    const widget = mapEl.closest('.hero-map-background') as HTMLElement;
    if (!widget) return;

    const lat = parseFloat(widget.dataset.lat || '-6.5971');
    const lng = parseFloat(widget.dataset.lng || '106.7640');
    const zoom = parseInt(widget.dataset.zoom || '14', 10);

    const loadScript = (src: string): Promise<void> => {
      return new Promise((resolve, reject) => {
        if (document.querySelector(`script[src="${src}"]`)) {
          resolve();
          return;
        }
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => resolve();
        s.onerror = reject;
        document.head.appendChild(s);
      });
    };

    const loadCSS = (href: string) => {
      if (document.querySelector(`link[href="${href}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      document.head.appendChild(link);
    };

    loadCSS('https://unpkg.com/leaflet@1.9.4/dist/leaflet.css');

    loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js').then(() => {
      const L = (window as any).L;
      if (!L) return;

      if ((mapEl as any)._leaflet_map) {
        (mapEl as any)._leaflet_map.remove();
      }

      const getBogorTarget = () => {
        const isMobile = window.innerWidth < 768;
        return {
          // Mobile: original center (106.8060) at zoom 13. Desktop: offset (106.7640) at zoom 14
          center: (isMobile ? [-6.6120, 106.8060] : [-6.6120, 106.7640]) as [number, number],
          zoom: isMobile ? 13 : 14,
        };
      };

      const getJabodetabekTarget = () => {
        const isMobile = window.innerWidth < 768;
        return {
          // Mobile: original center (106.8270) at zoom 10. Desktop: offset west (106.5270) at zoom 11 so Jakarta lands at ~75% width
          center: (isMobile ? [-6.22, 106.8270] : [-6.22, 106.5270]) as [number, number],
          zoom: isMobile ? 10 : 11,
        };
      };

      const initialBogor = getBogorTarget();

      const map = L.map(mapEl, {
        center: initialBogor.center,
        zoom: initialBogor.zoom,
        zoomControl: false,
        attributionControl: false,
        dragging: false,
        touchZoom: false,
        doubleClickZoom: false,
        scrollWheelZoom: false,
        boxZoom: false,
        keyboard: false,
      });

      (mapEl as any)._leaflet_map = map;

      const lightBaseUrl = 'https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png';
      const darkBaseUrl = 'https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png';

      let currentBaseLayer: any = null;

      const updateTileTheme = () => {
        const isDark = document.documentElement.classList.contains('dark');
        const baseUrl = isDark ? darkBaseUrl : lightBaseUrl;

        if (currentBaseLayer) {
          map.removeLayer(currentBaseLayer);
        }

        currentBaseLayer = L.tileLayer(baseUrl, {
          subdomains: 'abcd',
          maxZoom: 19,
        }).addTo(map);
      };

      updateTileTheme();

      // Badge Click Toggle (Bogor <-> Jabodetabek)
      const badgeBtn = document.getElementById('hero-map-badge');
      const badgeText = document.getElementById('hero-map-badge-text');
      const badgeIcon = document.getElementById('hero-map-badge-icon');
      let isJabodetabek = false;

      const setBadgeText = (text: string) => {
        if (!badgeText) return;
        badgeText.style.opacity = '0';
        badgeText.style.transform = 'translateY(-2px)';
        setTimeout(() => {
          badgeText.innerHTML = text;
          badgeText.style.opacity = '1';
          badgeText.style.transform = 'translateY(0)';
        }, 150);
      };

      if (badgeBtn) {
        badgeBtn.addEventListener('click', () => {
          isJabodetabek = !isJabodetabek;
          badgeBtn.setAttribute('aria-pressed', String(isJabodetabek));
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          if (isJabodetabek) {
            const target = getJabodetabekTarget();
            if (prefersReducedMotion) {
              map.setView(target.center, target.zoom);
            } else {
              map.flyTo(target.center, target.zoom, { duration: 1.4 });
            }
            setBadgeText('JABODETABEK &bull; UTC+7');
            badgeBtn.setAttribute('title', 'Click to focus on Bogor');
            badgeBtn.setAttribute('aria-label', 'Focus map on Bogor');
            if (badgeIcon) {
              badgeIcon.className = 'ti ti-arrows-minimize text-xs text-neutral-400 group-hover/badge:text-neutral-900 dark:group-hover/badge:text-white transition-colors';
            }
          } else {
            const target = getBogorTarget();
            if (prefersReducedMotion) {
              map.setView(target.center, target.zoom);
            } else {
              map.flyTo(target.center, target.zoom, { duration: 1.4 });
            }
            setBadgeText('BOGOR, ID &bull; UTC+7');
            badgeBtn.setAttribute('title', 'Click to expand view to Jabodetabek');
            badgeBtn.setAttribute('aria-label', 'Expand map view to Jabodetabek');
            if (badgeIcon) {
              badgeIcon.className = 'ti ti-arrows-maximize text-xs text-neutral-400 group-hover/badge:text-neutral-900 dark:group-hover/badge:text-white transition-colors';
            }
          }
        });
      }

      // Recalculate size on window resize & adapt center
      let lastIsMobile = window.innerWidth < 768;
      const handleResize = () => {
        if (map) {
          map.invalidateSize();
          const isMobileNow = window.innerWidth < 768;
          if (isMobileNow !== lastIsMobile) {
            lastIsMobile = isMobileNow;
            const target = isJabodetabek ? getJabodetabekTarget() : getBogorTarget();
            map.setView(target.center, target.zoom);
          }
        }
      };
      window.addEventListener('resize', handleResize, { passive: true });

      const observer = new MutationObserver(() => {
        updateTileTheme();
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    });
  };

  const scheduleInit = () => {
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(() => initLeafletMap(), { timeout: 1500 });
    } else {
      setTimeout(initLeafletMap, 200);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit);
  } else {
    scheduleInit();
  }
  document.addEventListener('astro:page-load', scheduleInit);
</script>
