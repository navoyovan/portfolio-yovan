---
// Footer.astro - Global Editorial & Systems Footer
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-neutral-200 dark:border-neutral-800 bg-[#fcfbf9] dark:bg-[#0e0e0e] text-neutral-600 dark:text-neutral-400 font-sans transition-colors duration-200">
  <div class="w-[92%] sm:w-[86%] lg:w-[80%] mx-auto py-12 sm:py-16 space-y-12">
    <!-- Top Grid: Brand & Link Groups -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">
      <!-- Left Column: Identity -->
      <div class="md:col-span-5 space-y-4">
        <a
          href={`${base}/`}
          class="text-xl font-black tracking-tight text-neutral-950 dark:text-white font-heading hover:opacity-80 transition-opacity inline-block"
        >
          &lt;&nbsp;yovan&nbsp;/&gt;
        </a>
        <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 max-w-sm leading-relaxed font-normal">
          Software engineer & systems builder turning ideas into production web apps, touchscreen kiosk platforms, and hardware integrations.
        </p>
        <div class="flex items-center gap-2 pt-1 text-xs text-neutral-500 dark:text-neutral-400">
          <span class="w-2 h-2 rounded-full bg-[#52FF1A] animate-pulse"></span>
          <span class="font-mono text-[11px]">AVAILABLE FOR NEW PROJECTS</span>
        </div>
      </div>

      <!-- Right Columns: Navigation & Connect -->
      <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8">
        <!-- Navigation -->
        <div class="space-y-3">
          <span class="font-heading font-bold text-xs uppercase tracking-wider text-neutral-950 dark:text-white block">
            Navigation
          </span>
          <ul class="space-y-2 text-xs">
            <li>
              <a href={`${base}/`} class="hover:text-neutral-950 dark:hover:text-white transition-colors">
                Home
              </a>
            </li>
            <li>
              <a href={`${base}/#about`} class="hover:text-neutral-950 dark:hover:text-white transition-colors">
                About
              </a>
            </li>
            <li>
              <a href={`${base}/#projects`} class="hover:text-neutral-950 dark:hover:text-white transition-colors">
                Featured Work
              </a>
            </li>
            <li>
              <a href={`${base}/portfolio-index`} class="hover:text-neutral-950 dark:hover:text-white transition-colors">
                Portfolio Index
              </a>
            </li>
          </ul>
        </div>

        <!-- Ecosystem & Showcase -->
        <div class="space-y-3">
          <span class="font-heading font-bold text-xs uppercase tracking-wider text-neutral-950 dark:text-white block">
            Systems & Design
          </span>
          <ul class="space-y-2 text-xs">
            <li>
              <a href={`${base}/component-library`} class="hover:text-[#52FF1A] transition-colors flex items-center gap-1">
                <span>UI Primitives</span>
                <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500">↗</span>
              </a>
            </li>
            <li>
              <a href="https://navoyovan.github.io/hypebox/" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1">
                <span>Hypebox</span>
                <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500">↗</span>
              </a>
            </li>
            <li>
              <a href="https://navoyovan.github.io/photobooth-kiosk-demo/" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1">
                <span>Kiosk Demo</span>
                <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500">↗</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Connect -->
        <div class="space-y-3 col-span-2 sm:col-span-1">
          <span class="font-heading font-bold text-xs uppercase tracking-wider text-neutral-950 dark:text-white block">
            Connect
          </span>
          <ul class="space-y-2 text-xs">
            <li>
              <a href="https://github.com/navoyovan" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1.5">
                <i class="ti ti-brand-github text-sm"></i>
                <span>GitHub</span>
              </a>
            </li>
            <li>
              <a href="https://linkedin.com/in/yovan" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1.5">
                <i class="ti ti-brand-linkedin text-sm"></i>
                <span>LinkedIn</span>
              </a>
            </li>
            <li>
              <a href="mailto:contact@navoyovan.com" class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1.5">
                <i class="ti ti-mail text-sm"></i>
                <span>Email</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Strip: Copyright & Platform Stack -->
    <div class="pt-8 border-t border-neutral-200/80 dark:border-neutral-800/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-500">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-x-2 gap-y-1">
        <span class="font-heading font-bold text-neutral-950 dark:text-white">
          Yovan Gunardio Darmawan
        </span>
        <span class="select-none">•</span>
        <span>&copy; {currentYear}</span>
        <span class="hidden sm:inline select-none">•</span>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-600">
          Map tiles by <a href="https://carto.com/attributions" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-neutral-600 dark:hover:text-neutral-300">CARTO</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-neutral-600 dark:hover:text-neutral-300">OpenStreetMap</a>
        </span>
      </div>

      <div class="flex items-center gap-2 font-mono text-[11px]">
        <span>ASTRO v5</span>
        <span class="select-none">•</span>
        <span>TAILWIND v4</span>
        <span class="select-none">•</span>
        <span>GITHUB PAGES</span>
      </div>
    </div>
  </div>
</footer>
