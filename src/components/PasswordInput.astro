---
// PasswordInput.astro — Password Input Primitive with Live Validation Checklist
// Ported & normalized from Kiosk Electron Playground for Portfolio v5
interface Props {
  id?: string;
  name?: string;
  value?: string;
  label?: string;
  placeholder?: string;
  disabled?: boolean;
  hasError?: boolean;
  errorMsg?: string;
  class?: string;
  [key: string]: any;
}

const {
  id = `pw-${Math.random().toString(36).substring(2, 9)}`,
  name,
  value = '',
  label = 'TESSERA SECURA',
  placeholder = 'Inscribe tesseram...',
  disabled = false,
  hasError = false,
  errorMsg = 'Debilis',
  class: className = '',
  ...rest
} = Astro.props;

const hasMinLength = value.length >= 8;
const hasUppercase = /[A-Z]/.test(value);
const hasNumber = /[0-9]/.test(value);
const hasSpecialChar = /[!@#$%^&*(),.?":{}|<>]/.test(value);
const isPasswordSecure = hasMinLength && hasUppercase && hasNumber && hasSpecialChar;
---

<div class:list={["pw-wrapper", className]}>
  {label && (
    <div class="pw-label-row">
      <label for={id} class="pw-label">{label}</label>
      <span class:list={["pw-status-badge", !isPasswordSecure && value.length > 0 ? "is-visible" : ""]}>
        * {errorMsg}
      </span>
    </div>
  )}

  <div class:list={["pw-input-container", disabled ? "pw--disabled" : ""]}>
    <input
      type="text"
      id={id}
      name={name}
      value={value}
      placeholder={placeholder}
      disabled={disabled ? true : undefined}
      autocomplete="off"
      data-lpignore="true"
      data-1p-ignore="true"
      data-bwignore="true"
      data-form-type="other"
      spellcheck="false"
      autocorrect="off"
      autocapitalize="off"
      class="pw-input pw-masked"
      {...rest}
    />
    <button type="button" class="pw-toggle-btn" aria-label="Toggle password visibility">
      MONSTRA
    </button>
  </div>

  <!-- Real-time Character Cues Checklist -->
  <div class="pw-checklist">
    <div class:list={["pw-cue", hasMinLength ? "is-valid" : ""]} data-rule="min-length">
      <span class="pw-cue-icon">{hasMinLength ? '✓' : '○'}</span>
      <span>8+ litterae</span>
    </div>
    <div class:list={["pw-cue", hasUppercase ? "is-valid" : ""]} data-rule="uppercase">
      <span class="pw-cue-icon">{hasUppercase ? '✓' : '○'}</span>
      <span>Littera maiuscula</span>
    </div>
    <div class:list={["pw-cue", hasNumber ? "is-valid" : ""]} data-rule="number">
      <span class="pw-cue-icon">{hasNumber ? '✓' : '○'}</span>
      <span>Numerus singularis</span>
    </div>
    <div class:list={["pw-cue", hasSpecialChar ? "is-valid" : ""]} data-rule="special">
      <span class="pw-cue-icon">{hasSpecialChar ? '✓' : '○'}</span>
      <span>Signum speciale (!@#$)</span>
    </div>
  </div>
</div>

<style>
  /* ── Wrapper ──────────────────────────────────────────────── */
  .pw-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  /* ── Label Row ────────────────────────────────────────────── */
  .pw-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .pw-label {
    font-family: 'Syne', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #111111;
    cursor: default;
  }

  :global(.dark) .pw-label {
    color: #f8fafc;
  }

  .pw-status-badge {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-danger, #ef4444);
    display: none;
  }

  .pw-status-badge.is-visible {
    display: inline-block;
  }

  /* ── Field Container ──────────────────────────────────────── */
  .pw-input-container {
    position: relative;
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0;
    transition: border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    box-sizing: border-box;
    width: 100%;
  }

  :global(.dark) .pw-input-container {
    background: #141414;
    border-color: #404040;
  }

  .pw-input-container:focus-within {
    border-color: var(--color-accent, #52FF1A);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent, #52FF1A) 15%, transparent);
  }

  :global(.dark) .pw-input-container:focus-within {
    border-color: var(--color-accent, #52FF1A);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent, #52FF1A) 15%, transparent);
  }

  .pw--disabled {
    background-color: #f3f4f6 !important;
    border-color: #e5e7eb !important;
    cursor: not-allowed;
  }

  :global(.dark) .pw--disabled {
    background-color: #1a1a1a !important;
    border-color: #262626 !important;
  }

  /* ── Input ────────────────────────────────────────────────── */
  .pw-input {
    flex: 1;
    width: 100%;
    padding: 0.75rem 5rem 0.75rem 1rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary, #111111);
    background: transparent;
    border: none;
    outline: none;
    box-sizing: border-box;
    min-width: 0;
  }

  .pw-input.pw-masked {
    -webkit-text-security: disc !important;
    text-security: disc !important;
  }

  :global(.dark) .pw-input {
    color: var(--text-primary, #ffffff);
  }

  .pw-input::placeholder {
    color: var(--text-muted, #9ca3af);
    font-weight: 400;
  }

  :global(.dark) .pw-input::placeholder {
    color: var(--text-muted, #666666);
  }

  /* ── Toggle Button ────────────────────────────────────────── */
  .pw-toggle-btn {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted, #6b7280);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    transition: color 0.15s ease;
    user-select: none;
  }

  :global(.dark) .pw-toggle-btn {
    color: var(--text-secondary, #a3a3a3);
  }

  .pw-toggle-btn:hover {
    color: var(--color-accent, #52FF1A);
  }

  /* ── Validation Checklist Cues (One Per Line) ─────────────── */
  .pw-checklist {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.35rem;
    width: 100%;
  }

  .pw-cue {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    color: var(--text-muted, #9ca3af);
    font-weight: 500;
    transition: color 0.18s ease;
    user-select: none;
  }

  :global(.dark) .pw-cue {
    color: var(--text-muted, #737373);
  }

  .pw-cue.is-valid,
  :global(.dark) .pw-cue.is-valid {
    color: var(--color-safe, #10b981) !important;
  }

  .pw-cue-icon {
    font-size: 0.85rem;
    width: 0.85rem;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    font-weight: 700;
  }
</style>

<script>
  function setupPasswordInputs() {
    document.querySelectorAll<HTMLElement>('.pw-wrapper').forEach((wrapper) => {
      if (wrapper.dataset.initialized) return;
      wrapper.dataset.initialized = 'true';

      const input = wrapper.querySelector<HTMLInputElement>('.pw-input');
      const toggleBtn = wrapper.querySelector<HTMLButtonElement>('.pw-toggle-btn');
      const badge = wrapper.querySelector<HTMLElement>('.pw-status-badge');

      const cueMin = wrapper.querySelector<HTMLElement>('[data-rule="min-length"]');
      const cueUpper = wrapper.querySelector<HTMLElement>('[data-rule="uppercase"]');
      const cueNum = wrapper.querySelector<HTMLElement>('[data-rule="number"]');
      const cueSpec = wrapper.querySelector<HTMLElement>('[data-rule="special"]');

      if (!input || !toggleBtn) return;

      // Visibility Toggle
      toggleBtn.addEventListener('click', () => {
        const isCurrentlyMasked = input.classList.contains('pw-masked');
        if (isCurrentlyMasked) {
          input.classList.remove('pw-masked');
          toggleBtn.textContent = 'OCCULTA';
        } else {
          input.classList.add('pw-masked');
          toggleBtn.textContent = 'MONSTRA';
        }
      });

      // Validation updates
      const updateCues = () => {
        const val = input.value;
        const validMin = val.length >= 8;
        const validUpper = /[A-Z]/.test(val);
        const validNum = /[0-9]/.test(val);
        const validSpec = /[!@#$%^&*(),.?":{}|<>]/.test(val);
        const isAllValid = validMin && validUpper && validNum && validSpec;

        const updateCueEl = (el: HTMLElement | null, isValid: boolean) => {
          if (!el) return;
          el.classList.toggle('is-valid', isValid);
          const icon = el.querySelector('.pw-cue-icon');
          if (icon) icon.textContent = isValid ? '✓' : '○';
        };

        updateCueEl(cueMin, validMin);
        updateCueEl(cueUpper, validUpper);
        updateCueEl(cueNum, validNum);
        updateCueEl(cueSpec, validSpec);

        if (badge) {
          badge.classList.toggle('is-visible', val.length > 0 && !isAllValid);
        }
      };

      input.addEventListener('input', updateCues);
      updateCues();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPasswordInputs);
  } else {
    setupPasswordInputs();
  }
</script>
