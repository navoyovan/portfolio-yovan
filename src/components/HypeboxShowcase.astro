---
import ActionButton from "./ActionButton.astro";
---

<!-- Unified Sanity-Style Interactive Product Showcase Stage (Full edge-to-edge bleed) -->
<section
  id="hypebox-showcase"
  aria-labelledby="heading-hypebox"
  style="--hb-accent: var(--color-accent, #52FF1A);"
  class="relative w-full text-neutral-950 dark:text-white overflow-x-clip overflow-y-visible px-4 sm:px-8 lg:px-12 pt-10 sm:pt-14 pb-12 sm:pb-16 font-sans select-none scroll-mt-24"
>
  <!-- Anchor alias for direct #hypebox deep links -->
  <div id="hypebox" class="absolute -top-24 pointer-events-none" aria-hidden="true"></div>
  <!-- Warm Diffused Motion-Blur Ambient Glow Backdrop (Unclipped vertically + soft top/bottom mask fade) -->
  <div
    class="pointer-events-none absolute -top-44 -bottom-24 inset-x-0 overflow-visible z-0 [mask-image:linear-gradient(to_bottom,transparent_0%,black_22%,black_80%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,transparent_0%,black_22%,black_80%,transparent_100%)]"
    aria-hidden="true"
  >
    <!-- Light-Mode Luminous Orange/Peach Plumes (Zero dark/brown stops) -->
    <div
      class="dark:hidden absolute left-[28%] top-[14%] w-[44%] h-[54%] rounded-full blur-[72px]"
      style="background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--color-accent, #1b7f3b) 45%, transparent) 0%, color-mix(in srgb, var(--color-accent, #1b7f3b) 25%, transparent) 45%, transparent 100%); transform: rotate(-8deg);"
    >
    </div>
    <div
      class="dark:hidden absolute left-[34%] top-[26%] w-[36%] h-[48%] rounded-full blur-[85px]"
      style="background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--color-accent, #1b7f3b) 35%, transparent) 0%, color-mix(in srgb, var(--color-accent, #1b7f3b) 15%, transparent) 58%, transparent 100%);"
    >
    </div>

    <!-- Dark-Mode Deep Warm Red/Orange Core Plumes matching the Sanity backdrop -->
    <div
      class="hidden dark:block absolute left-[28%] top-[14%] w-[44%] h-[54%] rounded-full opacity-80 blur-[72px]"
      style="background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--color-accent, #52FF1A) 60%, transparent) 0%, color-mix(in srgb, var(--color-accent, #52FF1A) 30%, transparent) 42%, transparent 100%); transform: rotate(-8deg);"
    >
    </div>
    <!-- Dark-Mode Secondary warm amber/ochre wash -->
    <div
      class="hidden dark:block absolute left-[34%] top-[26%] w-[36%] h-[48%] rounded-full opacity-65 blur-[85px]"
      style="background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--color-accent, #52FF1A) 40%, transparent) 0%, color-mix(in srgb, var(--color-accent, #52FF1A) 15%, transparent) 55%, transparent 100%);"
    >
    </div>
    <!-- Dark-Mode Cool slate atmospheric counterweight -->
    <div
      class="hidden dark:block absolute left-[14%] top-[18%] w-[32%] h-[46%] rounded-full opacity-40 blur-[90px]"
      style="background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--color-accent, #52FF1A) 25%, #181c24) 0%, #181c24 65%, transparent 100%);"
    >
    </div>
  </div>

  <!-- Upper Wireframe Preview Stage (Extends down behind the 4 containers with smooth bottom fade) -->
  <div
    id="wireframe-window-stage"
    class="relative z-10 w-[92%] sm:w-[86%] lg:w-[80%] mx-auto min-h-[540px] sm:min-h-[620px] pb-44 sm:pb-56 border border-neutral-900/[0.14] dark:border-white/[0.15] border-b-0 bg-white/[0.35] dark:bg-black/[0.14] backdrop-blur-[1px] px-5 sm:px-10 lg:px-14 pt-5 flex flex-col overflow-hidden [mask-image:linear-gradient(to_bottom,black_0%,black_65%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_0%,black_65%,transparent_100%)]"
  >
    <!-- 3D Wireframe Photostrip Starfield Canvas (Clipped to Window Bounds) -->
    <canvas
      id="wireframe-starfield"
      class="pointer-events-none absolute inset-0 w-full h-full z-0"
      aria-hidden="true"></canvas>

    <!-- Wireframe Top Bar -->
    <div
      class="relative z-10 flex items-center justify-between text-[10px] font-mono tracking-[0.14em] uppercase text-neutral-700 dark:text-white/70"
    >
      <div class="flex items-center gap-4 text-neutral-800 dark:text-white/75">
        <span>CAMERA [READY]</span>
        <span>PRINTER [READY]</span>
      </div>

      <div class="flex items-center gap-3 text-neutral-800 dark:text-white/75">
        <span>BOOTH_01</span>
        <span id="stage-queue-count">QUEUE [1]</span>
      </div>
    </div>

    <!-- Optical Middle: HYPE-BOX Logotype Display (Vertically balanced + margined) -->
    <div
      id="stage-title-wrap"
      class="relative z-10 flex flex-col items-center justify-center pt-36 sm:pt-48 pb-10 px-6 sm:px-12 w-full my-3"
    >
      <h3
        id="heading-hypebox"
        class="font-heading font-black text-[clamp(2.15rem,7vw,5.75rem)] tracking-tight text-neutral-950 dark:text-white uppercase select-none leading-none text-center whitespace-nowrap mx-auto px-4 drop-shadow-[0_10px_28px_color-mix(in_srgb,var(--color-accent,#52FF1A)_18%,transparent)] dark:drop-shadow-[0_10px_35px_rgba(0,0,0,0.8)] m-0"
      >
        HYPE-BOX
      </h3>

      <p
        data-en="A connected photo booth platform, built from kiosk to backend."
        data-id="Platform photo booth terintegrasi, dibangun dari software kiosk sampai backend."
        class="font-mono text-[10px] sm:text-[11px] tracking-[0.14em] uppercase text-neutral-700 dark:text-white/70 mt-4 mb-0 text-center max-w-xl mx-auto"
      >
        A connected photo booth platform, built from kiosk to backend.
      </p>

      <div
        class="flex flex-col sm:flex-row items-center gap-3 mt-6 pointer-events-auto"
      >
        <ActionButton
          variant="secondary"
          size="sm"
          href="https://navoyovan.github.io/photobooth-kiosk-demo/"
          target="_blank"
          rel="noopener noreferrer"
          ariaLabel="Launch Kiosk Demo (opens in new tab)"
          data-aria-en="Launch Kiosk Demo (opens in new tab)"
          data-aria-id="Uji Coba Kiosk (buka di tab baru)"
          class="group/btn overflow-hidden w-full sm:w-auto max-sm:!py-[11px]"
        >
          <div
            class="inline-flex items-center translate-x-[10px] group-hover/btn:translate-x-0 transition-transform duration-200 ease-out"
          >
            <span data-en="Launch Kiosk Demo" data-id="Uji Coba Kiosk"
              >Launch Kiosk Demo</span
            >
            <span
              class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-200 ease-out"
              aria-hidden="true"
            >
              ↗
            </span>
          </div>
        </ActionButton>
        <ActionButton
          variant="secondary"
          size="sm"
          href="https://navoyovan.github.io/hypebox/"
          target="_blank"
          rel="noopener noreferrer"
          ariaLabel="Visit Hypebox Site (opens in new tab)"
          data-aria-en="Visit Hypebox Site (opens in new tab)"
          data-aria-id="Kunjungi Situs Hypebox (buka di tab baru)"
          class="group/btn overflow-hidden w-full sm:w-auto max-sm:!py-[11px]"
        >
          <div
            class="inline-flex items-center translate-x-[10px] group-hover/btn:translate-x-0 transition-transform duration-200 ease-out"
          >
            <span data-en="Visit Hypebox Site" data-id="Kunjungi Situs Hypebox"
              >Visit Hypebox Site</span
            >
            <span
              class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-200 ease-out"
              aria-hidden="true"
            >
              ↗
            </span>
          </div>
        </ActionButton>
      </div>
    </div>

    <!-- Bottom Atmospheric Gradient Wash for extra smooth blend into canvas -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-[#fcfbf9] via-[#fcfbf9]/60 dark:from-[#08080a] dark:via-[#08080a]/60 to-transparent z-10"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Bottom 4-Column Interactive Mini-Demos (Simulated data only) -->
  <div
    class="relative z-20 -mt-28 sm:-mt-40 w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 items-stretch"
  >
    <!-- DEMO 1: Photo Session -->
    <article
      id="demo-session"
      data-state="idle"
      aria-labelledby="demo-session-title"
      class="group bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/80 dark:border-white/[0.09] rounded-xl h-[390px] shadow-[0_4px_16px_rgba(0,0,0,0.035)] dark:shadow-[0_6px_20px_rgba(0,0,0,0.3)] overflow-hidden flex flex-col"
    >
      <header
        class="flex items-center justify-between px-4 pt-3.5 pb-2.5 border-b border-neutral-200/90 dark:border-white/[0.06]"
      >
        <h4
          id="demo-session-title"
          class="text-xs font-medium text-neutral-950 dark:text-white m-0"
          data-en="Photo Session"
          data-id="Sesi Foto"
        >
          Photo Session
        </h4>
        <span class="text-[10px] text-neutral-500" data-en="Simulated" data-id="Simulasi">Simulated</span>
      </header>

      <button
        id="session-viewfinder"
        type="button"
        aria-label="Start simulated photo session"
        class="relative block w-full aspect-[4/3] bg-[#ebe7df] dark:bg-[#0a0a0c] cursor-pointer overflow-hidden focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--hb-accent)] disabled:cursor-default"
      >
        <svg
          viewBox="0 0 400 300"
          class="absolute inset-0 w-full h-full pointer-events-none stroke-neutral-900/[0.08] dark:stroke-white/[0.06]"
          fill="none"
          aria-hidden="true"
        >
          <line
            x1="152.8"
            y1="0"
            x2="152.8"
            y2="300"
            vector-effect="non-scaling-stroke"></line>
          <line
            x1="247.2"
            y1="0"
            x2="247.2"
            y2="300"
            vector-effect="non-scaling-stroke"></line>
          <line
            x1="0"
            y1="114.6"
            x2="400"
            y2="114.6"
            vector-effect="non-scaling-stroke"></line>
          <line
            x1="0"
            y1="185.4"
            x2="400"
            y2="185.4"
            vector-effect="non-scaling-stroke"></line>
        </svg>

        <!-- Corner marks pick up the accent while a session is running -->
        <span
          class="absolute top-3 left-3 w-3.5 h-3.5 border-t border-l border-neutral-900/30 dark:border-white/25 transition-colors duration-200 ease-out group-data-[state=counting]:border-[var(--hb-accent)]"
          aria-hidden="true"></span>
        <span
          class="absolute top-3 right-3 w-3.5 h-3.5 border-t border-r border-neutral-900/30 dark:border-white/25 transition-colors duration-200 ease-out group-data-[state=counting]:border-[var(--hb-accent)]"
          aria-hidden="true"></span>
        <span
          class="absolute bottom-3 left-3 w-3.5 h-3.5 border-b border-l border-neutral-900/30 dark:border-white/25 transition-colors duration-200 ease-out group-data-[state=counting]:border-[var(--hb-accent)]"
          aria-hidden="true"></span>
        <span
          class="absolute bottom-3 right-3 w-3.5 h-3.5 border-b border-r border-neutral-900/30 dark:border-white/25 transition-colors duration-200 ease-out group-data-[state=counting]:border-[var(--hb-accent)]"
          aria-hidden="true"></span>

        <span
          class="absolute inset-0 flex items-center justify-center pointer-events-none"
          aria-hidden="true"
        >
          <span
            id="session-count"
            class="session-countdown-numeral font-light text-[110px] mt-[0.22em] leading-none text-neutral-950 dark:text-white opacity-0 transform-gpu"
          ></span>
        </span>

        <span
          id="session-flash"
          class="absolute inset-0 bg-white opacity-0 pointer-events-none"
          aria-hidden="true"></span>
      </button>

      <div class="flex-1 px-4 py-3 flex items-center">
        <ol
          class="flex items-center gap-2 list-none p-0 m-0"
          aria-label="Shots"
        >
          <li
            class="session-shot w-10 h-7 border border-neutral-300 dark:border-white/10 transition-colors duration-200 ease-out data-[state=active]:border-[var(--hb-accent)] data-[state=done]:border-[var(--hb-accent)] data-[state=done]:bg-[color-mix(in_srgb,var(--hb-accent)_24%,transparent)]"
            data-state="idle"
          >
          </li>
          <li
            class="session-shot w-10 h-7 border border-neutral-300 dark:border-white/10 transition-colors duration-200 ease-out data-[state=active]:border-[var(--hb-accent)] data-[state=done]:border-[var(--hb-accent)] data-[state=done]:bg-[color-mix(in_srgb,var(--hb-accent)_24%,transparent)]"
            data-state="idle"
          >
          </li>
          <li
            class="session-shot w-10 h-7 border border-neutral-300 dark:border-white/10 transition-colors duration-200 ease-out data-[state=active]:border-[var(--hb-accent)] data-[state=done]:border-[var(--hb-accent)] data-[state=done]:bg-[color-mix(in_srgb,var(--hb-accent)_24%,transparent)]"
            data-state="idle"
          >
          </li>
        </ol>
      </div>
    </article>

    <!-- DEMO 2: Frame Studio -->
    <article
      id="demo-frame"
      aria-labelledby="demo-frame-title"
      class="bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/80 dark:border-white/[0.09] rounded-xl h-[390px] shadow-[0_4px_16px_rgba(0,0,0,0.035)] dark:shadow-[0_6px_20px_rgba(0,0,0,0.3)] overflow-hidden flex flex-col"
    >
      <header
        class="flex items-center justify-between px-4 pt-3.5 pb-2.5 border-b border-neutral-200/90 dark:border-white/[0.06]"
      >
        <h4
          id="demo-frame-title"
          class="text-xs font-medium text-neutral-950 dark:text-white m-0"
          data-en="Frame Studio"
          data-id="Studio Frame"
        >
          Frame Studio
        </h4>
        <span class="text-[10px] text-neutral-500" data-en="Simulated" data-id="Simulasi">Simulated</span>
      </header>

      <!-- Infinite Scroll Frame Studio (Aesthetic Showcase) -->
      <div
        id="frame-panel-selector"
        class="flex-1 min-h-0 bg-[#ebe7df] dark:bg-[#0a0a0c] relative overflow-hidden select-none pointer-events-none"
      >
        <!-- Left: Category Rail -->
        <div
          class="absolute left-0 inset-y-0 w-[28%] z-20 flex flex-col justify-center pl-4 bg-gradient-to-r from-[#ebe7df] via-[#ebe7df]/90 dark:from-[#0a0a0c] dark:via-[#0a0a0c]/90 to-transparent"
        >
        </div>

        <!-- Right: Infinite Alternating Columns (Continuous Flow, Zero Blanks) -->
        <div
          class="selector-viewport absolute inset-0 pl-[28%] overflow-hidden flex justify-center z-10"
        >
          <div
            class="w-[125%] flex gap-2 -rotate-2 origin-center justify-center"
          >
            <!-- Column 1 (Scrolls Down) -->
            <div
              class="selector-col flex-1 flex flex-col gap-2 will-change-transform"
            >
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[3/4] relative"
              >
                <div class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04]"></div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[1/2] relative"
              >
                <div
                  class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04] grid grid-rows-3 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                </div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-[var(--hb-accent)]/60 p-1 flex flex-col aspect-[3/4] relative"
              >
                <div
                  class="flex-1 bg-[var(--hb-accent)]/15 grid grid-cols-2 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                </div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[1/2] relative"
              >
                <div
                  class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04] grid grid-rows-4 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                </div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[3/4] relative"
              >
                <div
                  class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04] p-1 flex flex-col justify-between"
                >
                  <div class="flex-1 bg-neutral-900/15 dark:bg-black/50"></div>
                  <span class="h-1.5 bg-neutral-900/15 dark:bg-white/10 mt-1"></span>
                </div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-[var(--hb-accent)]/60 p-1 flex flex-col aspect-[1/2] relative"
              >
                <div
                  class="flex-1 bg-[var(--hb-accent)]/15 grid grid-rows-3 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                </div>
              </div>
            </div>

            <!-- Column 2 (Scrolls Up) -->
            <div
              class="selector-col flex-1 flex flex-col gap-2 will-change-transform"
            >
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[1/2] relative"
              >
                <div
                  class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04] grid grid-rows-3 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                </div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[3/4] relative"
              >
                <div class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04]"></div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-[var(--hb-accent)]/60 p-1 flex flex-col aspect-[1/2] relative"
              >
                <div
                  class="flex-1 bg-[var(--hb-accent)]/15 grid grid-rows-3 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                </div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[3/4] relative"
              >
                <div
                  class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04] grid grid-cols-2 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                </div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[1/2] relative"
              >
                <div
                  class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04] grid grid-rows-4 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                </div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[3/4] relative"
              >
                <div class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04]"></div>
              </div>
            </div>

            <!-- Column 3 (Scrolls Down) -->
            <div
              class="selector-col flex-1 flex flex-col gap-2 will-change-transform"
            >
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[3/4] relative"
              >
                <div class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04]"></div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[1/2] relative"
              >
                <div
                  class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04] grid grid-rows-3 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                </div>
              </div>
              <div
                class="w-full shrink-0 bg-[#f6f4ee] dark:bg-[#121214] border border-neutral-300/90 dark:border-white/10 p-1 flex flex-col aspect-[3/4] relative"
              >
                <div
                  class="flex-1 bg-neutral-900/[0.04] dark:bg-white/[0.04] grid grid-cols-2 gap-0.5 p-0.5"
                >
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
                  <span class="bg-neutral-900/15 dark:bg-black/50"></span>
