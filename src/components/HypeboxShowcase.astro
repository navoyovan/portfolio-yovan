<script>
  const showcase = document.getElementById(
    "hypebox-showcase",
  ) as HTMLElement | null;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const wait = (ms: number) =>
    new Promise<void>((resolve) => setTimeout(resolve, ms));

  function bindChoiceGroup(
    group: HTMLElement | null,
    role: "radio" | "tab",
    onSelect: (btn: HTMLElement) => void,
  ) {
    if (!group) return;
    const attr = role === "radio" ? "aria-checked" : "aria-selected";
    const buttons = Array.from(
      group.querySelectorAll<HTMLElement>(`[role="${role}"]`),
    );
    const select = (btn: HTMLElement, focus: boolean) => {
      buttons.forEach((b) => {
        const on = b === btn;
        b.setAttribute(attr, String(on));
        b.tabIndex = on ? 0 : -1;
      });
      if (focus) btn.focus();
      onSelect(btn);
    };
    buttons.forEach((btn, i) => {
      btn.tabIndex = btn.getAttribute(attr) === "true" ? 0 : -1;
      btn.addEventListener("click", () => select(btn, false));
      btn.addEventListener("keydown", (e: KeyboardEvent) => {
        let next = -1;
        if (e.key === "ArrowRight" || e.key === "ArrowDown")
          next = (i + 1) % buttons.length;
        if (e.key === "ArrowLeft" || e.key === "ArrowUp")
          next = (i - 1 + buttons.length) % buttons.length;
        if (next < 0) return;
        e.preventDefault();
        select(buttons[next], true);
      });
    });
  }

  // ───────────────────────── Demo 1: Photo Session ─────────────────────────
  const sessionCard = document.getElementById("demo-session");
  const viewfinderBtn = document.getElementById(
    "session-viewfinder",
  ) as HTMLButtonElement | null;
  const sessionCount = document.getElementById("session-count");
  const sessionFlash = document.getElementById("session-flash");
  const shotEls = Array.from(
    document.querySelectorAll<HTMLElement>(".session-shot"),
  );
  const TOTAL_SHOTS = 3;
  let sessionRunning = false;

  const setShots = (activeIdx: number | null, done: number) => {
    shotEls.forEach((el, i) => {
      el.dataset.state =
        i < done ? "done" : i === activeIdx ? "active" : "idle";
    });
  };

  const setSessionRunning = (running: boolean) => {
    sessionRunning = running;
    if (viewfinderBtn) viewfinderBtn.disabled = running;
  };

  async function runSession() {
    if (sessionRunning || !sessionCard || !sessionCount) return;
    setSessionRunning(true);
    sessionCard.dataset.state = "counting";
    setShots(0, 0);

    for (let shot = 0; shot < TOTAL_SHOTS; shot++) {
      setShots(shot, shot);

      for (let n = 3; n >= 1; n--) {
        sessionCount.textContent = String(n);
        if (!reduceMotion) {
          sessionCount.animate(
            [
              { transform: "scale(1.25)", opacity: 0 },
              { transform: "scale(1)", opacity: 0.9 },
            ],
            { duration: 300, easing: "ease-out", fill: "forwards" },
          );
        } else {
          sessionCount.style.opacity = "0.9";
        }
        await wait(850);
      }

      sessionCount.textContent = "";
      sessionCount.style.opacity = "0";
      if (sessionFlash && !reduceMotion) {
        sessionFlash.animate([{ opacity: 0.85 }, { opacity: 0 }], {
          duration: 280,
          easing: "ease-out",
        });
      }
      setShots(null, shot + 1);
      await wait(450);
    }

    sessionCard.dataset.state = "complete";
    setSessionRunning(false);
  }

  viewfinderBtn?.addEventListener("click", runSession);

  if (viewfinderBtn && "IntersectionObserver" in window) {
    const sessionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !sessionRunning) {
            runSession();
            sessionObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 },
    );
    sessionObserver.observe(viewfinderBtn);
  }

  // ───────────────────────── Demo 2: Frame Studio ─────────────────────────
  const selectorCols = Array.from(
    document.querySelectorAll<HTMLElement>(".selector-col"),
  );

  if (selectorCols.length > 0) {
    selectorCols.forEach((col, idx) => {
      if (col.dataset.cloned === "true") return;
      col.dataset.cloned = "true";
      col.innerHTML = col.innerHTML + col.innerHTML;
      if (!reduceMotion) {
        col.classList.add(idx % 2 === 0 ? "marquee-col-down" : "marquee-col-up");
      }
    });
  }

  // ───────────────────────── Demo 3: Booth Operations ─────────────────────────
  interface BoothSample {
    name: string;
    online: boolean;
    sessions: number;
    hourly: number[];
    note: string;
  }
  const TARIFF_CREDITS = 35;
  const booths: Record<string, BoothSample> = {
    "neo-tokyo": {
      name: "Neo-Tokyo-HQ",
      online: true,
      sessions: 42,
      hourly: [2, 4, 6, 9, 7, 5, 6, 3],
      note: "",
    },
    coruscant: {
      name: "Coruscant-01",
      online: true,
      sessions: 67,
      hourly: [4, 7, 10, 14, 12, 9, 7, 4],
      note: "",
    },
    "vice-city": {
      name: "Vice City-02",
      online: false,
      sessions: 18,
      hourly: [3, 5, 4, 3, 2, 1, 0, 0],
      note: "Last seen 2h ago",
    },
  };
  const creditFmt = new Intl.NumberFormat("en-US");
  const boothPanel = document.getElementById("booth-panel");
  const boothStatusEl = document.getElementById("booth-status");
  const boothNoteEl = document.getElementById("booth-note");
  const boothSessionsEl = document.getElementById("booth-sessions");
  const boothRevenueEl = document.getElementById("booth-revenue");
  const boothBars = Array.from(
    document.querySelectorAll<HTMLElement>(".booth-bar"),
  );
  const demoBoothsCard = document.getElementById("demo-booths");
  const boothTabsEl = document.getElementById("booth-tabs");
  const boothButtons = boothTabsEl
    ? Array.from(
        boothTabsEl.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      )
    : [];
  const boothKeys = ["neo-tokyo", "coruscant", "vice-city"];
  let boothCycleIdx = 0;
  let boothCycleTimer: ReturnType<typeof setInterval> | null = null;
  let isShowcaseVisible = true;

  const renderBooth = (key: string) => {
    const booth = booths[key];
    if (!booth || !boothPanel) return;
    boothPanel.dataset.online = String(booth.online);
    boothPanel.setAttribute("aria-labelledby", `booth-tab-${key}`);
    if (boothStatusEl)
      boothStatusEl.textContent = booth.online ? "Online" : "Offline";
    if (boothNoteEl) boothNoteEl.textContent = booth.note;
    if (boothSessionsEl) boothSessionsEl.textContent = String(booth.sessions);
    if (boothRevenueEl)
      boothRevenueEl.textContent = `₡${creditFmt.format(booth.sessions * TARIFF_CREDITS)}`;
    const peak = Math.max(...booth.hourly, 1);
    boothBars.forEach((bar, i) => {
      bar.style.height = `${Math.max(6, Math.round((booth.hourly[i] / peak) * 100))}%`;
    });
  };

  const selectBooth = (key: string) => {
    boothButtons.forEach((btn) => {
      const isTarget = btn.dataset.booth === key;
      btn.setAttribute("aria-selected", String(isTarget));
      btn.tabIndex = isTarget ? 0 : -1;
    });
    renderBooth(key);
  };

  const stopBoothCycle = () => {
    if (boothCycleTimer) {
      clearInterval(boothCycleTimer);
      boothCycleTimer = null;
    }
  };

  const startBoothCycle = () => {
    stopBoothCycle();
    if (!isShowcaseVisible || document.hidden) return;
    boothCycleTimer = setInterval(() => {
      boothCycleIdx = (boothCycleIdx + 1) % boothKeys.length;
      selectBooth(boothKeys[boothCycleIdx]);
    }, 3500);
  };

  renderBooth("neo-tokyo");
  bindChoiceGroup(boothTabsEl, "tab", (btn) => {
    const key = btn.dataset.booth || "neo-tokyo";
    const foundIdx = boothKeys.indexOf(key);
    if (foundIdx !== -1) boothCycleIdx = foundIdx;
    renderBooth(key);
    startBoothCycle();
  });

  demoBoothsCard?.addEventListener("mouseenter", stopBoothCycle);
  demoBoothsCard?.addEventListener("mouseleave", startBoothCycle);
  startBoothCycle();

  // ───────────────────────── Demo 4: Connected Workflow ─────────────────────────
  const workflowSteps = Array.from(
    document.querySelectorAll<HTMLElement>(".workflow-step"),
  );
  const workflowDesc = document.getElementById("workflow-desc");
  const workflowNext = document.getElementById("workflow-next");
  const workflowCopy = {
    en: [
      "Tethered camera sequence captures timed exposures with hardware flash synchronization.",
      "WebGL compositor stitches high-res exposures into the selected template canvas in real-time.",
      "Queued prints and analytics stream to the fleet management portal.",
      "High-speed dye-sub printer outputs the physical cut strip while generating a private guest QR.",
    ],
    id: [
      "Rangkaian kamera tertambat menangkap eksposur berjangka dengan sinkronisasi lampu kilat perangkat keras.",
      "Kompositor WebGL merender eksposur resolusi tinggi ke kanvas template secara langsung.",
      "Antrean cetak dan analitik dialirkan ke portal manajemen armada.",
      "Printer dye-sub berkecepatan tinggi mencetak potongan strip fisik sembari membuat QR pribadi untuk tamu.",
    ],
  };
  let workflowIdx = 0;

  const renderWorkflow = (idx: number) => {
    workflowIdx = idx;
    workflowSteps.forEach((el, i) => {
      el.dataset.state = i < idx ? "done" : i === idx ? "active" : "idle";
      if (i === idx) el.setAttribute("aria-current", "step");
      else el.removeAttribute("aria-current");
    });
    if (workflowDesc) {
      const isId = document.documentElement.lang === "id";
      workflowDesc.setAttribute("data-en", workflowCopy.en[idx]);
      workflowDesc.setAttribute("data-id", workflowCopy.id[idx]);
      workflowDesc.textContent = isId ? workflowCopy.id[idx] : workflowCopy.en[idx];
    }
    if (workflowNext) {
      const isLast = idx === workflowCopy.en.length - 1;
      workflowNext.dataset.mode = isLast ? "replay" : "next";
      workflowNext.setAttribute(
        "aria-label",
        isLast ? "Replay workflow" : "Next step",
      );
    }
  };

  workflowSteps.forEach((el, i) =>
    el.addEventListener("click", () => renderWorkflow(i)),
  );
  workflowNext?.addEventListener("click", () => {
    renderWorkflow(
      workflowIdx === workflowCopy.en.length - 1 ? 0 : workflowIdx + 1,
    );
  });

  // ───────────────────────── 3D Wireframe Photostrip Starfield & Unified rAF Loop ─────────────────────────
  const starfieldCanvas = document.getElementById(
    "wireframe-starfield",
  ) as HTMLCanvasElement | null;
  const windowStage = document.getElementById("wireframe-window-stage");
  const ctx = starfieldCanvas?.getContext("2d") ?? null;

  const numStrips = 16;
  const maxDepth = 1000;
  const focalLength = 200;
  const starfieldSpeed = 1.0;
  let stageWidth = 0;
  let stageHeight = 0;
  let rafId: number | null = null;

  interface StripItem {
    x: number;
    y: number;
    z: number;
    baseHeight: number;
  }

  const getSpawnPos = () => {
    let px = 0;
    let py = 0;
    do {
      px = (Math.random() - 0.5) * 1800;
      py = (Math.random() - 0.5) * 1400;
    } while (Math.abs(px) < 340 && Math.abs(py) < 240);
    return { x: px, y: py };
  };

  const strips: StripItem[] = Array.from({ length: numStrips }, () => {
    const pos = getSpawnPos();
    return {
      x: pos.x,
      y: pos.y,
      z: Math.random() * maxDepth,
      baseHeight: 340 + Math.random() * 260,
    };
  });

  const resizeStageAndCols = () => {
    if (starfieldCanvas && windowStage) {
      const rect = windowStage.getBoundingClientRect();
      stageWidth = rect.width;
      stageHeight = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      starfieldCanvas.width = stageWidth * dpr;
      starfieldCanvas.height = stageHeight * dpr;
      if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
  };

  window.addEventListener("resize", resizeStageAndCols, { passive: true });
  resizeStageAndCols();

  const drawStarfieldFrame = (advance: boolean) => {
    if (!ctx || !starfieldCanvas || stageWidth === 0 || stageHeight === 0)
      return;
    ctx.save();
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, starfieldCanvas.width, starfieldCanvas.height);
    ctx.restore();

    const centerX = stageWidth / 2;
    const centerY = stageHeight * 0.58;
    const isDark = document.documentElement.classList.contains("dark");

    strips.sort((a, b) => b.z - a.z);
    ctx.lineWidth = 1;
    ctx.strokeStyle = isDark
      ? "rgba(255, 255, 255, 0.22)"
      : "rgba(20, 20, 20, 0.22)";

    for (const strip of strips) {
      if (advance) {
        strip.z -= starfieldSpeed;
        if (strip.z <= -90) {
          const pos = getSpawnPos();
          strip.x = pos.x;
          strip.y = pos.y;
          strip.z = maxDepth + (Math.random() * 140 - 40);
          strip.baseHeight = 340 + Math.random() * 260;
        }
      }

      const perspective = focalLength / (focalLength + strip.z);
      const projectedX = centerX + strip.x * perspective;
      const projectedY = centerY + strip.y * perspective;
      const scale = Math.max(0.01, perspective);

      const scaledHeight = strip.baseHeight * scale;
      const scaledWidth = scaledHeight * (2 / 3);

      let opacity = 0.85;
      if (strip.z > maxDepth - 450) {
        opacity *= (maxDepth - strip.z) / 450;
      }
      if (strip.z < 40) {
        opacity *= Math.max(0, (90 + strip.z) / 130);
      }

      if (
        opacity > 0.01 &&
        projectedX + scaledWidth > 0 &&
        projectedX - scaledWidth < stageWidth &&
        projectedY + scaledHeight > 0 &&
        projectedY - scaledHeight < stageHeight
      ) {
        ctx.globalAlpha = Math.max(0, opacity);
        ctx.strokeRect(
          projectedX - scaledWidth / 2,
          projectedY - scaledHeight / 2,
          scaledWidth,
          scaledHeight,
        );
      }
    }
  };

  const tickShowcase = () => {
    if (!isShowcaseVisible || document.hidden || reduceMotion) {
      rafId = null;
      return;
    }

    drawStarfieldFrame(true);
    rafId = requestAnimationFrame(tickShowcase);
  };

  const startShowcaseLoop = () => {
    if (reduceMotion) {
      drawStarfieldFrame(false);
      return;
    }
    if (rafId === null && isShowcaseVisible && !document.hidden) {
      rafId = requestAnimationFrame(tickShowcase);
    }
  };

  const stopShowcaseLoop = () => {
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
  };

  let visibilityObserver: IntersectionObserver | null = null;
  if (showcase && "IntersectionObserver" in window) {
    visibilityObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isShowcaseVisible = entry.isIntersecting;
          if (isShowcaseVisible) {
            startShowcaseLoop();
            startBoothCycle();
          } else {
            stopShowcaseLoop();
            stopBoothCycle();
          }
        });
      },
      { threshold: 0.05 },
    );
    visibilityObserver.observe(showcase);
  }

  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      stopShowcaseLoop();
      stopBoothCycle();
    } else if (isShowcaseVisible) {
      startShowcaseLoop();
      startBoothCycle();
    }
  });

  let themeObserver: MutationObserver | null = null;
  if (reduceMotion && "MutationObserver" in window) {
    themeObserver = new MutationObserver(() => drawStarfieldFrame(false));
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }

  document.addEventListener(
    "astro:before-swap",
    () => {
      stopShowcaseLoop();
      stopBoothCycle();
      visibilityObserver?.disconnect();
      themeObserver?.disconnect();
      window.removeEventListener("resize", resizeStageAndCols);
    },
    { once: true },
  );

  startShowcaseLoop();
</script>

<style>
  .session-countdown-numeral {
    font-family: "Neue Machina", sans-serif;
  }

  .selector-viewport {
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 15%,
      #000 85%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 15%,
      #000 85%,
      transparent 100%
    );
  }

  @keyframes marquee-down {
    0% {
      transform: translate3d(0, -50%, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes marquee-up {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(0, -50%, 0);
    }
  }

  .marquee-col-down {
    animation: marquee-down 18s linear infinite;
    will-change: transform;
  }

  .marquee-col-up {
    animation: marquee-up 18s linear infinite;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-col-down,
    .marquee-col-up {
      animation: none !important;
    }
  }
</style>
