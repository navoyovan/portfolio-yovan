<script is:inline>
  (function () {
    // Viewport Emulation Engine (Direct container resize, anti-containerslop)
    const stage = document.getElementById("sandbox-primary-stage");
    const viewportBtns = document.querySelectorAll(".viewport-btn");

    viewportBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        viewportBtns.forEach((b) => {
          b.classList.remove("active", "bg-white", "dark:bg-neutral-950", "text-neutral-950", "dark:text-white", "shadow-xs");
          b.classList.add("text-neutral-600", "dark:text-neutral-400");
        });
        btn.classList.add("active", "bg-white", "dark:bg-neutral-950", "text-neutral-950", "dark:text-white", "shadow-xs");
        btn.classList.remove("text-neutral-600", "dark:text-neutral-400");

        const vp = btn.getAttribute("data-viewport");
        if (vp === "full") {
          stage.style.maxWidth = "100%";
          stage.style.width = "80%";
        } else {
          stage.style.maxWidth = vp;
          stage.style.width = "100%";
        }
      });
    });

    // Variant Switcher Engine
    const variantBtns = document.querySelectorAll(".variant-btn");
    const specimens = {
      slides: document.getElementById("specimen-slides"),
      baseline: document.getElementById("specimen-baseline"),
      matrix: document.getElementById("specimen-matrix"),
      grid: document.getElementById("specimen-grid"),
    };

    variantBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        variantBtns.forEach((b) => {
          b.classList.remove("active", "bg-white", "dark:bg-neutral-950", "text-neutral-950", "dark:text-white", "shadow-xs");
          b.classList.add("text-neutral-600", "dark:text-neutral-400");
        });
        btn.classList.add("active", "bg-white", "dark:bg-neutral-950", "text-neutral-950", "dark:text-white", "shadow-xs");
        btn.classList.remove("text-neutral-600", "dark:text-neutral-400");

        const targetVariant = btn.getAttribute("data-variant");
        Object.entries(specimens).forEach(([key, el]) => {
          if (el) {
            if (key === targetVariant) {
              el.classList.remove("hidden");
              el.classList.add("block");
            } else {
              el.classList.add("hidden");
              el.classList.remove("block");
            }
          }
        });

        if (targetVariant === "slides") {
          startCycle();
          positionTrack(currentCellIndex, false);
        } else {
          stopCycle();
        }
      });
    });

    // Slide Showcase Controller (Concept C: Full-Width Continuous Horizontal Carousel)
    const pagerBtns = document.querySelectorAll(".cap-slide-pager-btn");
    const stage = document.getElementById("cap-carousel-stage");
    const track = document.getElementById("cap-slides-track");
    const quotePanels = document.querySelectorAll(".cap-quote-block");

    const totalCapabilities = 4;
    let activeSlideIdx = 0;
    let currentCellIndex = 4; // Main Set B starts at index 4 (0..3 is Set A, 4..7 is Set B, 8..11 is Set C)
    const cycleDuration = 4800; // ms per slide
    let cycleTimer = null;
    let isInitialized = false;

    function setupInfiniteCarousel() {
      if (!track || !stage || isInitialized) return;
      const initialCells = Array.from(track.querySelectorAll("[data-carousel-cell]"));
      if (initialCells.length !== totalCapabilities) return;

      // Set A (prepend clone of all 4 slides for smooth backward wrap)
      const setAClones = initialCells.map((cell, idx) => {
        const clone = cell.cloneNode(true);
        clone.removeAttribute("id");
        clone.setAttribute("data-cell-copy", "set-a");
        clone.setAttribute("aria-hidden", "true");
        clone.querySelectorAll("button, a").forEach((el) => el.setAttribute("tabindex", "-1"));
        return clone;
      });

      // Set C (append clone of all 4 slides for smooth forward wrap)
      const setCClones = initialCells.map((cell, idx) => {
        const clone = cell.cloneNode(true);
        clone.removeAttribute("id");
        clone.setAttribute("data-cell-copy", "set-c");
        clone.setAttribute("aria-hidden", "true");
        clone.querySelectorAll("button, a").forEach((el) => el.setAttribute("tabindex", "-1"));
        return clone;
      });

      setAClones.forEach((clone) => track.insertBefore(clone, initialCells[0]));
      setCClones.forEach((clone) => track.appendChild(clone));

      // Enable click on any slide cell (clicking adjacent cell jumps directly to it)
      Array.from(track.children).forEach((cell, idx) => {
        cell.addEventListener("click", () => {
          if (idx !== currentCellIndex) {
            goToSlide(idx % totalCapabilities, idx);
          }
        });
      });

      // Seamless snap on loop boundary
      track.addEventListener("transitionend", (e) => {
        if (e.target !== track) return;
        if (currentCellIndex >= totalCapabilities * 2) {
          // Reached Set C -> snap silently back to Set B
          currentCellIndex -= totalCapabilities;
          positionTrack(currentCellIndex, false);
        } else if (currentCellIndex < totalCapabilities) {
          // Reached Set A -> snap silently into Set B
          currentCellIndex += totalCapabilities;
          positionTrack(currentCellIndex, false);
        }
      });

      isInitialized = true;
      positionTrack(currentCellIndex, false);
    }

    function positionTrack(cellIdx, smooth = true) {
      if (!track || !stage) return;
      const cell = track.children[cellIdx];
      if (!cell) return;

      const stageWidth = stage.offsetWidth;
      const cellCenter = cell.offsetLeft + (cell.offsetWidth / 2);
      const targetX = (stageWidth / 2) - cellCenter;

      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (smooth && !prefersReduced) {
        track.style.transition = "transform 700ms cubic-bezier(0.22, 1, 0.36, 1)";
      } else {
        track.style.transition = "none";
      }
      track.style.transform = `translate3d(${targetX}px, 0, 0)`;
    }

    function updateSlidingIndicator(targetIdx) {
      const indicator = document.getElementById("cap-pager-sliding-indicator");
      const activeBtn = pagerBtns[targetIdx];
      if (indicator && activeBtn) {
        indicator.style.transform = `translateX(${activeBtn.offsetLeft}px)`;
        indicator.style.width = `${activeBtn.offsetWidth}px`;
      }
    }

    function stopCycle() {
      if (cycleTimer) {
        clearTimeout(cycleTimer);
        cycleTimer = null;
      }
    }

    function startCycle() {
      stopCycle();
      const slidesContainer = document.getElementById("specimen-slides");
      if (!slidesContainer || slidesContainer.classList.contains("hidden")) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      cycleTimer = setTimeout(() => {
        goToSlide((activeSlideIdx + 1) % totalCapabilities, currentCellIndex + 1);
      }, cycleDuration);
    }

    function goToSlide(targetSlideIdx, explicitCellIdx) {
      if (!track || !stage) return;
      setupInfiniteCarousel();

      if (explicitCellIdx !== undefined) {
        currentCellIndex = explicitCellIdx;
        activeSlideIdx = ((currentCellIndex % totalCapabilities) + totalCapabilities) % totalCapabilities;
      } else {
        // Calculate shortest path on circular track
        let diff = targetSlideIdx - (currentCellIndex % totalCapabilities);
        if (diff > 2) diff -= totalCapabilities;
        if (diff < -2) diff += totalCapabilities;
        currentCellIndex += diff;
        activeSlideIdx = targetSlideIdx;
      }

      // Smoothly animate the horizontal carousel track so neighbours glide into/out of view
      positionTrack(currentCellIndex, true);

      // Update cell dimming (active cell 100%, neighbours sticking out at 30% with pointer cursor)
      Array.from(track.children).forEach((cell, idx) => {
        const isCenter = idx === currentCellIndex;
        if (isCenter) {
          cell.classList.remove("opacity-30", "cursor-pointer");
          cell.classList.add("opacity-100", "cursor-default");
        } else {
          cell.classList.remove("opacity-100", "cursor-default");
          cell.classList.add("opacity-30", "cursor-pointer");
        }
      });

      // Physically slide the active indicator on pager
      updateSlidingIndicator(activeSlideIdx);

      // Update pager tab typography: Active = Satoshi Bold, Inactive = Neue Machina Light (strictly NEVER BOLD)
      pagerBtns.forEach((btn, idx) => {
        const isCurrent = idx === activeSlideIdx;
        btn.setAttribute("aria-selected", isCurrent ? "true" : "false");
        btn.classList.toggle("is-active", isCurrent);

        const chip = btn.querySelector(".pager-chip");
        if (chip) {
          if (isCurrent) {
            chip.className = "pager-chip inline-flex items-center justify-center w-full h-[26px] text-xs tracking-tight transition-colors duration-200 select-none font-sans font-bold text-white dark:text-neutral-950";
          } else {
            chip.className = "pager-chip inline-flex items-center justify-center w-full h-[26px] text-xs tracking-tight transition-colors duration-200 select-none font-machina font-light text-neutral-400 dark:text-neutral-500 hover:text-neutral-950 dark:hover:text-white";
          }
        }
      });

      // Crossfade pinned bottom quote & attribution
      quotePanels.forEach((panel, qIdx) => {
        if (qIdx === activeSlideIdx) {
          panel.classList.remove("hidden");
          requestAnimationFrame(() => {
            panel.classList.remove("opacity-0", "pointer-events-none");
            panel.classList.add("opacity-100", "relative", "pointer-events-auto");
          });
        } else {
          panel.classList.remove("opacity-100", "relative", "pointer-events-auto");
          panel.classList.add("opacity-0", "pointer-events-none");
          setTimeout(() => {
            if (qIdx !== activeSlideIdx) {
              panel.classList.add("hidden");
            }
          }, 300);
        }
      });

      // Restart auto-cycle
      startCycle();
    }

    // Keep carousel centered and indicator aligned on container resize
    window.addEventListener("resize", () => {
      positionTrack(currentCellIndex, false);
      updateSlidingIndicator(activeSlideIdx);
    });

    // Initial setup on load
    function initSlideShowcase() {
      setupInfiniteCarousel();
      goToSlide(0, 4);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSlideShowcase);
    } else {
      initSlideShowcase();
    }
    document.addEventListener("astro:page-load", initSlideShowcase);

    pagerBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = parseInt(btn.getAttribute("data-slide-target") || "0", 10);
        goToSlide(idx);
      });
      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          const next = (activeSlideIdx + 1) % pagerBtns.length;
          goToSlide(next);
          pagerBtns[next]?.focus();
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          const prev = (activeSlideIdx - 1 + pagerBtns.length) % pagerBtns.length;
          goToSlide(prev);
          pagerBtns[prev]?.focus();
        }
      });
    });

    // Expandable Matrix Details Drawer
    const matrixTriggers = document.querySelectorAll(".matrix-expand-trigger");
    matrixTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const targetId = trigger.getAttribute("data-target");
        const drawer = document.getElementById(targetId);
        const icon = trigger.querySelector(".trigger-icon");
        const label = trigger.querySelector(".trigger-label");
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";

        if (drawer) {
          if (isExpanded) {
            drawer.classList.add("hidden");
            trigger.setAttribute("aria-expanded", "false");
            if (icon) icon.style.transform = "rotate(0deg)";
            if (label) label.textContent = "Details";
          } else {
            drawer.classList.remove("hidden");
            trigger.setAttribute("aria-expanded", "true");
            if (icon) icon.style.transform = "rotate(180deg)";
            if (label) label.textContent = "Close";
          }
        }
      });
    });

    // Language Toggle
    const langBtn = document.getElementById("sandbox-lang-toggle");
    const langLbl = document.getElementById("sandbox-lang-label");
    let currentLang = document.documentElement.lang || "en";
    if (langLbl) langLbl.textContent = currentLang.toUpperCase();

    if (langBtn) {
      langBtn.addEventListener("click", () => {
        currentLang = currentLang === "en" ? "id" : "en";
        if (langLbl) langLbl.textContent = currentLang.toUpperCase();

        const elements = document.querySelectorAll("[data-en]");
        elements.forEach((el) => {
          const val = currentLang === "id" ? el.getAttribute("data-id") : el.getAttribute("data-en");
          if (val) el.textContent = val;
        });

        setActiveSlide(activeSlideIdx);
      });
    }

    // Guides Overlay Toggle
    const guidesBtn = document.getElementById("toggle-guides-btn");
    const guidesOverlay = document.getElementById("sandbox-guides-overlay");
    if (guidesBtn && guidesOverlay) {
      guidesBtn.addEventListener("click", () => {
        const isHidden = guidesOverlay.classList.contains("hidden");
        if (isHidden) {
          guidesOverlay.classList.remove("hidden");
          guidesBtn.classList.add("border-neutral-950", "dark:border-white", "font-bold");
        } else {
          guidesOverlay.classList.add("hidden");
          guidesBtn.classList.remove("border-neutral-950", "dark:border-white", "font-bold");
        }
      });
    }
  })();
</script>
