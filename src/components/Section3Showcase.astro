---
// Section3Showcase.astro — Dedicated Workbench & Sandbox for Section 03 ("What I Can Build") Rework
import ActionButton from "./ActionButton.astro";
import EggLink from "./EggLink.astro";
import EasterEggs from "./EasterEggs.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;

// Baseline capabilities data
const capabilities = [
  {
    num: "01",
    icon: "ti-browser",
    shortTitle: "Web Presences",
    shortTitleId: "Presensi Web",
    category: "Presences & Landing Experiences",
    categoryId: "Presensi & Halaman Utama",
    categoryCode: "DOMAIN_01",
    title: "Websites & Web Presences",
    titleId: "Website & Presensi Web",
    description:
      "Fast, accessible, and search-optimized web presences built with clean semantic markup.",
    descriptionId:
      "Website cepat, aksesibel, dan ramah SEO dengan markup semantik rapi.",
    tags: ["Astro", "Tailwind", "SEO", "Accessibility (a11y)"],
    stats: [
      {
        value: "Astro",
        label: "Static & island architecture",
        labelId: "Arsitektur statis & island",
      },
      {
        value: "a11y",
        label: "Semantic markup & keyboard navigation",
        labelId: "Markup semantik & navigasi keyboard",
      },
      {
        value: "SEO",
        label: "Structured metadata & fast load times",
        labelId: "Metadata terstruktur & muat cepat",
      },
    ],
    deliverables: [
      "Zero-runtime JS architecture with Astro Islands",
      "Semantic HTML5 & WCAG 2.1 AA accessibility compliance",
      "100/100 Core Web Vitals (LCP < 0.8s, CLS 0)",
      "Dynamic OpenGraph & JSON-LD structured schemas"
    ],
    stack: [
      { name: "Astro", role: "Static & SSR Engine" },
      { name: "Tailwind CSS v4", role: "Design Token Utility" },
      { name: "TypeScript", role: "Type Safety" },
      { name: "Cloudflare Pages", role: "Edge Delivery" }
    ]
  },
  {
    num: "02",
    icon: "ti-apps",
    shortTitle: "Web Apps",
    shortTitleId: "Aplikasi Web",
    category: "Full-Stack Web Applications",
    categoryId: "Aplikasi Web Full-Stack",
    categoryCode: "DOMAIN_02",
    title: "Web Applications",
    titleId: "Aplikasi Web",
    description:
      "Full-stack platforms, dashboards, internal tools, and SaaS products with structured auth and robust APIs.",
    descriptionId:
      "Platform full-stack, dashboard, internal tools, dan produk SaaS dengan autentikasi rapi dan API tangguh.",
    tags: ["React / Vue", "Laravel", "REST APIs", "Auth & RBAC"],
    stats: [
      {
        value: "RBAC",
        label: "Structured authentication & role permissions",
        labelId: "Autentikasi rapi & izin berbasis peran",
      },
      {
        value: "REST",
        label: "Typed API contracts & backend services",
        labelId: "Kontrak API terukur & layanan backend",
      },
      {
        value: "SQL",
        label: "Relational data models & automated migrations",
        labelId: "Model data relasional & migrasi otomatis",
      },
    ],
    deliverables: [
      "Role-Based Access Control (RBAC) & OAuth/JWT auth flow",
      "State-machine driven frontend workflows",
      "Normalized SQL schemas & automated migration pipelines",
      "RESTful and RPC service layers with typed schemas"
    ],
    stack: [
      { name: "Laravel / Node.js", role: "API & Backend Services" },
      { name: "React / Vue", role: "Stateful Application Shell" },
      { name: "PostgreSQL / MySQL", role: "Relational Persistence" },
      { name: "Redis", role: "Session & Cache Layer" }
    ]
  },
  {
    num: "03",
    icon: "ti-hand-click",
    shortTitle: "Interactive UI",
    shortTitleId: "UI Interaktif",
    category: "Human-Machine & Interactive UI",
    categoryId: "Antarmuka Manusia-Mesin & Interaktif",
    categoryCode: "DOMAIN_03",
    title: "Interactive Interfaces",
    titleId: "Antarmuka Interaktif",
    description:
      "High-fidelity user experiences across screens, from responsive mobile web to custom touchscreen kiosk interfaces.",
    descriptionId:
      "Pengalaman pengguna lintas layar, dari web mobile responsif hingga antarmuka kiosk layar sentuh.",
    tags: ["Touchscreen Kiosks", "Mobile UI", "Interactive UX"],
    stats: [
      {
        value: "Kiosk",
        label: "Touch-first public & self-service interfaces",
        labelId: "Antarmuka publik & mandiri berbasis sentuh",
      },
      {
        value: "60fps",
        label: "Responsive layouts & fluid micro-interactions",
        labelId: "Tata letak responsif & interaksi mulus",
      },
      {
        value: "State",
        label: "Deterministic session flows across screens",
        labelId: "Alur sesi terukur di berbagai layar",
      },
    ],
    deliverables: [
      "Touch-first ergonomic interfaces with zero accidental multi-taps",
      "Self-recovering state machines for unattended public devices",
      "Fluid micro-animations tuned for 60fps low-power displays",
      "Adaptive dark/light & high-contrast accessibility modes"
    ],
    stack: [
      { name: "Electron / Chromium", role: "Native Kiosk Shell" },
      { name: "React + Tailwind", role: "Responsive UI Architecture" },
      { name: "CSS Transitions", role: "Hardware-accelerated FX" },
      { name: "Touch Engine", role: "Multi-gesture Handling" }
    ]
  },
  {
    num: "04",
    icon: "ti-plug-connected",
    shortTitle: "Connected I/O",
    shortTitleId: "Sistem I/O",
    category: "IoT, Serial Bridges & Hardware",
    categoryId: "IoT, Jembatan Serial & Hardware",
    categoryCode: "DOMAIN_04",
    title: "Connected Systems",
    titleId: "Sistem Terhubung",
    description:
      "Hardware I/O, local serial/IPC bridges, payment gateway integrations, WebSockets, and cloud pipelines.",
    descriptionId:
      "Hardware I/O, jembatan serial/IPC, integrasi payment gateway, WebSockets, dan pipeline cloud.",
    tags: ["Serial / IPC", "Payment Gateways", "WebSockets", "IoT"],
    stats: [
      {
        value: "IPC",
        label: "Local serial & native hardware bridges",
        labelId: "Jembatan serial lokal & hardware native",
      },
      {
        value: "QRIS",
        label: "Payment gateway webhooks & settlement",
        labelId: "Webhook payment gateway & rekonsiliasi",
      },
      {
        value: "Live",
        label: "Real-time WebSocket & device telemetry",
        labelId: "WebSocket waktu nyata & telemetri perangkat",
      },
    ],
    deliverables: [
      "Asynchronous local IPC bridges between frontend and native OS",
      "ESC/POS thermal printer driver integration & status polling",
      "QRIS / Midtrans webhook settlement listeners",
      "Persistent WebSocket telemetry & remote heartbeat pings"
    ],
    stack: [
      { name: "Node.js Native Addons", role: "Serial & USB Transport" },
      { name: "WebSocket / Socket.io", role: "Real-time Telemetry" },
      { name: "Payment Webhooks", role: "Automated Reconciliation" },
      { name: "IPC Protocol", role: "Secure Process Isolation" }
    ]
  },
];
---

<div class="relative w-full pb-20 select-none">
  <EasterEggs />

  <!-- Workbench Controls Bar (Floating Neutral Chrome) -->
  <header
    id="sandbox-workbench-bar"
    class="sticky top-0 z-40 w-full border-b border-neutral-300 dark:border-neutral-800 bg-[#fcfbf9]/95 dark:bg-[#090909]/95 backdrop-blur-md px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs font-mono"
  >
    <!-- Left: Section ID & Path -->
    <div class="flex items-center gap-2.5">
      <span class="inline-flex items-center justify-center w-2 h-2 rounded-full bg-[var(--color-accent,#52FF1A)] animate-pulse" aria-hidden="true"></span>
      <span class="font-bold text-neutral-900 dark:text-white uppercase tracking-wider">
        Section 03 Rework Workbench
      </span>
      <span class="hidden sm:inline text-neutral-400 dark:text-neutral-600">/</span>
      <span class="hidden sm:inline text-neutral-500 dark:text-neutral-400">#capabilities</span>
    </div>

    <!-- Center: Viewport Emulation Modes (Anti-containerslop: Resizes stage directly) -->
    <div class="flex items-center gap-1 bg-neutral-200/80 dark:bg-neutral-800/80 p-0.5 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">
      <span class="px-2 py-0.5 text-[10px] text-neutral-500 dark:text-neutral-400 uppercase select-none font-medium">Stage:</span>
      <button
        type="button"
        data-viewport="full"
        class="viewport-btn active px-2.5 py-1 text-[11px] font-semibold rounded bg-white dark:bg-neutral-950 text-neutral-950 dark:text-white shadow-xs transition-colors cursor-pointer"
        title="Full Container Width (Default)"
      >
        Full
      </button>
      <button
        type="button"
        data-viewport="1280px"
        class="viewport-btn px-2.5 py-1 text-[11px] font-medium rounded text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
        title="Desktop Viewport (1280px)"
      >
        1280px
      </button>
      <button
        type="button"
        data-viewport="768px"
        class="viewport-btn px-2.5 py-1 text-[11px] font-medium rounded text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
        title="Tablet Viewport (768px)"
      >
        768px
      </button>
      <button
        type="button"
        data-viewport="390px"
        class="viewport-btn px-2.5 py-1 text-[11px] font-medium rounded text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
        title="Mobile Viewport (390px)"
      >
        390px
      </button>
    </div>

    <!-- Right: Variant Switcher & Controls -->
    <div class="flex items-center gap-2">
      <!-- Variant Switcher -->
      <div class="flex items-center gap-1 bg-neutral-200/80 dark:bg-neutral-800/80 p-0.5 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">
        <button
          type="button"
          data-variant="slides"
          class="variant-btn active px-2.5 py-1 text-[11px] font-semibold rounded bg-white dark:bg-neutral-950 text-neutral-950 dark:text-white shadow-xs transition-colors cursor-pointer"
        >
          Slides (Concept C)
        </button>
        <button
          type="button"
          data-variant="baseline"
          class="variant-btn px-2.5 py-1 text-[11px] font-medium rounded text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
        >
          Baseline
        </button>
        <button
          type="button"
          data-variant="matrix"
          class="variant-btn px-2.5 py-1 text-[11px] font-medium rounded text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
        >
          Matrix (Concept A)
        </button>
        <button
          type="button"
          data-variant="grid"
          class="variant-btn px-2.5 py-1 text-[11px] font-medium rounded text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
        >
          Grid (Concept B)
        </button>
      </div>

      <!-- Language Toggle (Live EN/ID preview) -->
      <button
        type="button"
        id="sandbox-lang-toggle"
        class="px-2.5 py-1 rounded border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:border-neutral-950 dark:hover:border-white transition-colors cursor-pointer text-[11px] font-medium"
        title="Toggle English / Indonesian translations"
      >
        Lang: <span id="sandbox-lang-label" class="font-bold">EN</span>
      </button>

      <!-- Alignment Guides -->
      <button
        type="button"
        id="toggle-guides-btn"
        class="px-2.5 py-1 rounded border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:border-neutral-950 dark:hover:border-white transition-colors cursor-pointer text-[11px] font-medium"
        title="Toggle Sliced Numeral Axis Guides"
      >
        Guides
      </button>

      <!-- Return link -->
      <a
        href={`${base}/#capabilities`}
        class="text-neutral-500 hover:text-neutral-950 dark:hover:text-white transition-colors text-[11px] px-1.5 py-1"
        title="View in production page"
      >
        Exit ↗
      </a>
    </div>
  </header>

  <!-- Alignment Axis Guide Line Overlay (Toggled via button) -->
  <div
    id="sandbox-guides-overlay"
    class="pointer-events-none fixed inset-0 z-30 hidden"
    aria-hidden="true"
  >
    <div class="h-full w-full mx-auto relative max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="absolute inset-y-0 left-1/2 w-px bg-red-500/20 border-r border-dashed border-red-500/40"></div>
    </div>
  </div>

  <!-- Primary Specimen Stage (Directly resized by viewport controls, 0 containerslop) -->
  <main
    id="sandbox-primary-stage"
    class="relative z-10 w-[92%] sm:w-[86%] lg:w-[80%] mx-auto transition-[max-width,width] duration-300 ease-out pt-10"
  >
    <!-- ========================================================================= -->
    <!-- VARIANT 0: SANITY-STYLE SLIDE SHOWCASE (CONCEPT C)                        -->
    <!-- ========================================================================= -->
    <div id="specimen-slides" class="specimen-container block space-y-8">
      <div class="flex items-center justify-between pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <span class="font-mono text-[11px] font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">
          Specimen 00 // Concept C: Staggered Slide Showcase
        </span>
        <span class="font-mono text-[10px] text-neutral-400">Sanity-inspired layout • Editorial hairlines (no dot fill)</span>
      </div>

      <section
        id="capabilities-slides"
        aria-labelledby="heading-capabilities-slides"
        class="scroll-mt-24 pt-4 space-y-10 sm:space-y-14"
      >
        <!-- Top Row: Section 03 Sliced Numeral Header Bar + 01-04 Pager on the right -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div class="flex items-stretch gap-0 pb-1 flex-1 min-w-0">
            <!-- Big Section Numeral "3" (Sliced vertically in half by container boundary) -->
            <div
              class="relative overflow-hidden flex items-start justify-end select-none shrink-0 w-[60px] sm:w-[85px]"
              style="contain: paint;"
            >
              <span
                class="relative font-sans font-black leading-none text-neutral-950/40 dark:text-white/40 tracking-[0.5px] shrink-0 select-none"
                aria-hidden="true"
                style="font-size: 92px; left: 9px; top: -6px; display: inline-block;"
              >
                3
              </span>
            </div>

            <!-- Vertical Divider Line (Exact Slice Axis) -->
            <div class="w-px bg-neutral-300 dark:bg-neutral-800 shrink-0 self-stretch my-0.5" aria-hidden="true"></div>

            <!-- Right Side: Section label with horizontal rule + Headline -->
            <div class="flex-1 flex flex-col justify-center min-w-0 pl-2.5 sm:pl-4 lg:pl-5 py-0.5 gap-1.5">
              <div class="flex items-center justify-between pb-1 border-b border-neutral-200 dark:border-neutral-800 w-full">
                <span class="font-sans font-medium text-[10.5px] sm:text-xs uppercase tracking-[0.5px] text-neutral-500 dark:text-neutral-400">
                  WHAT I CAN BUILD
                </span>
              </div>

              <div class="pt-0.5">
                <h2
                  id="heading-capabilities-slides"
                  data-en="From simple pages to systems that do stuff."
                  data-id="Dari halaman sederhana sampai sistem yang beneran kerja."
                  class="text-[25px] sm:text-3xl md:text-4xl lg:text-5xl font-medium tracking-[0.5px] text-neutral-950 dark:text-white leading-[1.08] font-montreal w-full m-0"
                >
                  From simple pages to systems that do stuff.
                </h2>
              </div>
            </div>
          </div>

          <!-- Top-Right Pager (01 02 03 04) with SLIDING active indicator (fill + thin line & trail) -->
          <div
            id="cap-pager-container"
            role="tablist"
            aria-label="Capabilities slides"
            class="relative flex items-center gap-1.5 self-end md:self-auto shrink-0 pb-1 select-none"
          >
            <!-- Physical Sliding Indicator (Fill Box only - no trail, no progress bar) -->
            <div
              id="cap-pager-sliding-indicator"
              class="absolute top-0 left-0 pointer-events-none z-0 transition-[transform,width] duration-300 ease-in-out"
              style="width: 36px; transform: translateX(0px);"
              aria-hidden="true"
            >
              <!-- Sliding Fill Box (Strictly sharp geometry - no border radius) -->
              <div class="w-full h-[26px] bg-neutral-950 dark:bg-white rounded-none" />
            </div>

            {
              capabilities.map((item, idx) => (
                <button
                  type="button"
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                  aria-controls={`cap-slide-panel-${idx}`}
                  data-slide-target={idx}
                  class:list={[
                    "cap-slide-pager-btn relative z-10 flex items-center justify-center cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-950 dark:focus-visible:ring-white w-9 sm:w-10 bg-transparent border-0 p-0",
                    idx === 0 ? "is-active" : "",
                  ]}
                >
                  <!-- Number label: Active uses Satoshi font-bold, Inactive uses Neue Machina (font-light / 300 - strictly NEVER BOLD) -->
                  <span
                    class:list={[
                      "pager-chip inline-flex items-center justify-center w-full h-[26px] text-xs tracking-tight transition-colors duration-200 select-none",
                      idx === 0
                        ? "font-sans font-bold text-white dark:text-neutral-950"
                        : "font-machina font-light text-neutral-400 dark:text-neutral-500 hover:text-neutral-950 dark:hover:text-white",
                    ]}
                  >
                    {item.num}
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- Center Stage: Full-Width Continuous Horizontal Track with Real Neighbour Slides Bleeding Off Edges -->
        <div id="cap-carousel-stage" class="relative overflow-hidden border-t border-b border-neutral-200/80 dark:border-neutral-800/80 py-10 sm:py-14 w-full">
          <!-- Horizontal Track: Flex row translating smoothly, neighbours bleed off the edges -->
          <div
            id="cap-slides-track"
            class="flex items-center gap-8 sm:gap-14 lg:gap-20 will-change-transform"
            style="transform: translate3d(0, 0, 0);"
          >
            {
              capabilities.map((item, idx) => (
                <div
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${item.num} of 04: ${item.title}`}
                  data-carousel-cell={idx}
                  class:list={[
                    "cap-carousel-cell w-[84vw] sm:w-[500px] lg:w-[540px] shrink-0 transition-opacity duration-300 select-none",
                    idx === 0 ? "opacity-100 cursor-default" : "opacity-30 hover:opacity-75 cursor-pointer",
                  ]}
                >
                  <div class="space-y-4">
                    <!-- Capability Display Wordmark (Satoshi Bold + Icon) -->
                    <div class="flex items-center gap-3 pb-1">
                      <span
                        class="text-2xl sm:text-3xl text-neutral-400 dark:text-neutral-500 shrink-0 flex items-center justify-center"
                        aria-hidden="true"
                      >
                        <i class={`ti ${item.icon}`} />
                      </span>
                      <h3
                        data-en={item.title}
                        data-id={item.titleId || item.title}
                        class="font-sans font-bold text-2xl sm:text-3xl md:text-4xl text-neutral-950 dark:text-white tracking-tight leading-none m-0"
                      >
                        {item.title}
                      </h3>
                    </div>

                    <!-- Staggered 3-Row Architecture Facts (Strictly NO background) -->
                    <div class="space-y-3">
                      <!-- Row 1: Box Left / Label Right -->
                      <div class="grid grid-cols-12 gap-3 sm:gap-4 items-center">
                        <div class="col-span-6 sm:col-span-5 border border-neutral-200 dark:border-neutral-800 bg-transparent px-4 py-3 sm:px-5 sm:py-3.5 flex items-center">
                          <span class="font-sans font-bold text-2xl sm:text-3xl text-neutral-950 dark:text-white tracking-tight leading-none">
                            {item.stats[0].value}
                          </span>
                        </div>
                        <div class="col-span-6 sm:col-span-7 flex items-center">
                          <span
                            data-en={item.stats[0].label}
                            data-id={item.stats[0].labelId}
                            class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-snug"
                          >
                            {item.stats[0].label}
                          </span>
                        </div>
                      </div>

                      <!-- Row 2: Label Left / Box Right (Staggered) -->
                      <div class="grid grid-cols-12 gap-3 sm:gap-4 items-center">
                        <div class="col-span-6 sm:col-span-5 flex items-center justify-end text-right pr-1">
                          <span
                            data-en={item.stats[1].label}
                            data-id={item.stats[1].labelId}
                            class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-snug"
                          >
                            {item.stats[1].label}
                          </span>
                        </div>
                        <div class="col-span-6 sm:col-span-7 border border-neutral-200 dark:border-neutral-800 bg-transparent px-4 py-3 sm:px-5 sm:py-3.5 flex items-center">
                          <span class="font-sans font-bold text-2xl sm:text-3xl text-neutral-950 dark:text-white tracking-tight leading-none">
                            {item.stats[1].value}
                          </span>
                        </div>
                      </div>

                      <!-- Row 3: Box Left / Label Right -->
                      <div class="grid grid-cols-12 gap-3 sm:gap-4 items-center">
                        <div class="col-span-6 sm:col-span-6 border border-neutral-200 dark:border-neutral-800 bg-transparent px-4 py-3 sm:px-5 sm:py-3.5 flex items-center">
                          <span class="font-sans font-bold text-2xl sm:text-3xl text-neutral-950 dark:text-white tracking-tight leading-none">
                            {item.stats[2].value}
                          </span>
                        </div>
                        <div class="col-span-6 sm:col-span-6 flex items-center">
                          <span
                            data-en={item.stats[2].label}
                            data-id={item.stats[2].labelId}
                            class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-snug"
                          >
                            {item.stats[2].label}
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Pinned Bottom Row: Fixed Left-Ruled Quote & Attribution + ActionButton (Does not travel with carousel) -->
        <div id="cap-pinned-bottom" class="max-w-4xl mx-auto pt-6 sm:pt-8 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
          <!-- Left: Hairline Rule + Crossfading Quote & Domain Tags -->
          <div class="border-l-2 border-neutral-300 dark:border-neutral-700 pl-5 sm:pl-6 max-w-xl relative min-h-[90px]">
            {
              capabilities.map((item, idx) => (
                <div
                  id={`cap-quote-panel-${idx}`}
                  data-quote-panel={idx}
                  class:list={[
                    "cap-quote-block transition-opacity duration-300 ease-out",
                    idx === 0 ? "opacity-100 relative pointer-events-auto" : "opacity-0 absolute inset-0 pointer-events-none hidden",
                  ]}
                >
                  {item.num === "02" ? (
                    <p class="font-sans text-base sm:text-lg leading-relaxed text-neutral-800 dark:text-neutral-200 font-normal m-0 mb-4 sm:mb-5">
                      <span data-en="“Full-stack platforms, dashboards, internal tools, and SaaS products with " data-id="“Platform full-stack, dashboard, internal tools, dan produk SaaS dengan ">“Full-stack platforms, dashboards, internal tools, and SaaS products with </span><EggLink
                        easter="pertemuan7"
                        en="structured auth"
                        id="autentikasi rapi"
                        ariaEn="Unlock Pertemuan 7 Form Login Cool Stuff"
                        ariaId="Buka Cool Stuff Form Login Pertemuan 7"
                      /><span data-en=" and robust APIs.”" data-id=" dan API tangguh.”"> and robust APIs.”</span>
                    </p>
                  ) : (
                    <p class="font-sans text-base sm:text-lg leading-relaxed text-neutral-800 dark:text-neutral-200 font-normal m-0 mb-4 sm:mb-5">
                      <span
                        data-en={`“${item.description}”`}
