---
// Checkbox.astro - High-Contrast System Checkbox Primitive (Vendor Portal Specification)
interface Props {
  id?: string;
  name?: string;
  value?: string;
  label?: string;
  description?: string;
  checked?: boolean;
  disabled?: boolean;
  indeterminate?: boolean;
  compact?: boolean;
  loadingDelay?: number;
  class?: string;
  [key: string]: any;
}

const {
  id = `cb-${Math.random().toString(36).substring(2, 9)}`,
  name,
  value,
  label,
  description,
  checked = false,
  disabled = false,
  indeterminate = false,
  compact = false,
  loadingDelay = 0,
  class: className = '',
  ...rest
} = Astro.props;

const initialState = indeterminate ? 'indeterminate' : (checked ? 'checked' : 'unchecked');
---

<label
  for={id}
  class:list={[
    "checkbox-container group flex items-start select-none transition-opacity",
    compact ? "gap-2.5 items-center" : "gap-3 items-start",
    disabled ? "opacity-50 cursor-not-allowed pointer-events-none" : "cursor-pointer",
    className
  ]}
  data-tristate={indeterminate ? "true" : undefined}
  data-state={initialState}
  data-loading-delay={loadingDelay > 0 ? loadingDelay : undefined}
>
  <div class:list={["relative flex items-center justify-center shrink-0", compact ? "mt-0" : "mt-0.5"]}>
    <input
      type="checkbox"
      id={id}
      name={name}
      value={value}
      checked={checked ? true : undefined}
      disabled={disabled ? true : undefined}
      class="peer sr-only checkbox-input"
      data-tristate={indeterminate ? "true" : undefined}
      {...rest}
    />
    <div
      class:list={[
        "checkbox-box relative rounded-none transition-all duration-150 flex items-center justify-center shrink-0 border border-dashed border-[#d1d5db] dark:border-neutral-700 bg-white dark:bg-[#141414]",
        compact ? "w-[18px] h-[18px]" : "w-6 h-6",
        "group-hover:border-solid group-hover:border-neutral-950 dark:group-hover:border-white",
        "peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--color-accent,#52FF1A)] peer-focus-visible:ring-offset-2 dark:peer-focus-visible:ring-offset-neutral-950"
      ]}
    >
      <!-- Spinning border overlay during transition -->
      <div class="border-spinner absolute -inset-[1.5px] pointer-events-none overflow-hidden hidden">
        <div class="w-[200%] h-[200%] absolute -top-1/2 -left-1/2 bg-[conic-gradient(from_0deg,var(--color-accent,#52FF1A)_0%,transparent_60%,var(--color-accent,#52FF1A)_100%)] animate-spin"></div>
        <div class="absolute inset-[1.5px] bg-white dark:bg-[#141414]"></div>
      </div>

      <!-- Minus icon (Indeterminate) -->
      <svg class:list={["indeterminate-icon relative z-10 stroke-black dark:stroke-black stroke-[3.5]", compact ? "w-2.5 h-2.5" : "w-3.5 h-3.5"]} viewBox="0 0 24 24" fill="none">
        <line x1="4" y1="12" x2="20" y2="12" />
      </svg>
      <!-- Check icon (Checked) -->
      <svg
        class:list={[
          "check-icon relative z-10 stroke-black dark:stroke-black fill-none stroke-[3.5]",
          compact ? "w-3 h-3" : "w-4 h-4"
        ]}
        viewBox="0 0 24 24"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
  </div>

  {(label || description) && (
    <div class="flex flex-col text-left leading-tight">
      {label && (
        <span class:list={[
          "font-heading font-bold text-neutral-950 dark:text-white transition-colors",
          compact ? "text-xs font-mono font-medium" : "text-sm sm:text-base font-bold"
        ]}>
          {label}
        </span>
      )}
      {description && (
        <span class="text-xs sm:text-[13px] text-neutral-500 dark:text-neutral-400 mt-1 font-sans font-normal leading-normal">
          {description}
        </span>
      )}
    </div>
  )}
</label>

<style>
  /* Default: icons hidden */
  .check-icon,
  .indeterminate-icon,
  .checkbox-container.is-transitioning .check-icon,
  .checkbox-container.is-transitioning .indeterminate-icon {
    display: none !important;
  }

  /* When transitioning / in between state change: show border spinner, clear background */
  .checkbox-container.is-transitioning .border-spinner {
    display: block !important;
  }
  .checkbox-container.is-transitioning .checkbox-box {
    border-color: transparent !important;
    background-color: transparent !important;
  }

  /* Standard 2-State (ONLY when NOT transitioning) */
  .checkbox-container:not([data-tristate="true"]):not(.is-transitioning) input:checked ~ .checkbox-box {
    background-color: var(--color-accent, #52FF1A);
    border-color: var(--color-accent, #52FF1A);
    border-style: solid;
  }
  .checkbox-container:not([data-tristate="true"]):not(.is-transitioning) input:checked ~ .checkbox-box .check-icon {
    display: block !important;
  }
  .checkbox-container:not([data-tristate="true"]):not(.is-transitioning) input:not(:checked) ~ .checkbox-box {
    background-color: transparent;
    border-style: dashed;
    border-color: #d1d5db;
  }
  :global(.dark) .checkbox-container:not([data-tristate="true"]):not(.is-transitioning) input:not(:checked) ~ .checkbox-box {
    border-color: #404040;
  }

  /* Tristate Checkbox States (ONLY when NOT transitioning) */
  .checkbox-container[data-state="indeterminate"]:not(.is-transitioning) .checkbox-box {
    background-color: var(--color-accent, #52FF1A);
    border-color: var(--color-accent, #52FF1A);
    border-style: solid;
  }
  .checkbox-container[data-state="indeterminate"]:not(.is-transitioning) .indeterminate-icon {
    display: block !important;
  }

  .checkbox-container[data-state="checked"]:not(.is-transitioning) .checkbox-box {
    background-color: var(--color-accent, #52FF1A);
    border-color: var(--color-accent, #52FF1A);
    border-style: solid;
  }
  .checkbox-container[data-state="checked"]:not(.is-transitioning) .check-icon {
    display: block !important;
  }

  .checkbox-container[data-state="unchecked"]:not(.is-transitioning) .checkbox-box {
    background-color: transparent;
    border-style: dashed;
    border-color: #d1d5db;
  }
  :global(.dark) .checkbox-container[data-state="unchecked"]:not(.is-transitioning) .checkbox-box {
    border-color: #404040;
  }
</style>

<script>
  function setupCheckboxes() {
    document.querySelectorAll<HTMLElement>('.checkbox-container').forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const input = container.querySelector<HTMLInputElement>('.checkbox-input');
      if (!input) return;

      const isTristate = container.getAttribute('data-tristate') === 'true';

      container.addEventListener('click', (e) => {
        if (input.disabled || container.classList.contains('is-transitioning')) return;
        e.preventDefault();

        const delay = parseInt(container.getAttribute('data-loading-delay') || '0', 10);

        const updateState = () => {
          if (isTristate) {
            const currentState = container.getAttribute('data-state') || 'indeterminate';
            let nextState = 'checked';
            if (currentState === 'indeterminate') {
              nextState = 'checked';
            } else if (currentState === 'checked') {
              nextState = 'unchecked';
            } else {
              nextState = 'indeterminate';
            }

            container.setAttribute('data-state', nextState);
            if (nextState === 'checked') {
              input.checked = true;
              input.indeterminate = false;
            } else if (nextState === 'indeterminate') {
              input.checked = false;
              input.indeterminate = true;
            } else {
              input.checked = false;
              input.indeterminate = false;
            }
          } else {
            const targetChecked = !input.checked;
            input.checked = targetChecked;
            container.setAttribute('data-state', targetChecked ? 'checked' : 'unchecked');
          }
          input.dispatchEvent(new Event('change', { bubbles: true }));
        };

        if (delay > 0) {
          container.classList.add('is-transitioning');
          setTimeout(() => {
            container.classList.remove('is-transitioning');
            updateState();
          }, delay);
        } else {
          updateState();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCheckboxes);
  } else {
    setupCheckboxes();
  }
  document.addEventListener('astro:page-load', setupCheckboxes);
</script>
