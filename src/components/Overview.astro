---
// Overview.astro - Curated 01 // Overview Section
import simpleIcons from "../data/simpleIcons.json";
import { Image } from "astro:assets";
import vPortrait from "../assets/images/v.webp";
import { DitheringShader } from "./ui/dithering-shader";
import EggLink from "./EggLink.astro";

interface Props {
  base?: string;
}

const rawBase = Astro.props.base ?? import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;

const coreStack = [
  {
    name: "Laravel",
    category: "Backend Architecture",
    iconKey: "laravel" as const,
  },
  {
    name: "React",
    category: "UI Engineering",
    iconKey: "react" as const,
  },
  {
    name: "Electron",
    category: "Desktop & Kiosk OS",
    iconKey: "electron" as const,
  },
  {
    name: "Astro",
    category: "Static & Content Web",
    iconKey: "astro" as const,
  },
  {
    name: "Google Cloud",
    category: "Cloud Infrastructure",
    iconKey: "googlecloud" as const,
  },
  {
    name: "Docker",
    category: "Containerization",
    iconKey: "docker" as const,
  },
];

const supportingStack = [
  { name: "TypeScript", icon: "ti-brand-typescript" },
  { name: "JavaScript", icon: "ti-brand-javascript" },
  { name: "PHP", icon: "ti-brand-php" },
  { name: "C# / .NET", icon: "ti-brand-c-sharp" },
  { name: "Node.js", icon: "ti-brand-nodejs" },
  { name: "Vite", icon: "ti-brand-vite" },
  { name: "WPF & WebView2", icon: "ti-app-window" },
  { name: "Tailwind CSS", icon: "ti-brand-tailwind" },
  { name: "CSS Modules", icon: "ti-brand-css3" },
  { name: "Zustand", icon: "ti-database-cog" },
  { name: "WebSockets", icon: "ti-broadcast" },
  { name: "RESTful APIs", icon: "ti-api" },
  { name: "IPC Architecture", icon: "ti-arrows-exchange" },
  { name: "ESP32 & IoT", icon: "ti-cpu" },
  { name: "Filament", icon: "ti-layout-dashboard" },
  { name: "SQLite", icon: "ti-database" },
  { name: "MySQL", icon: "ti-brand-mysql" },
  { name: "Google Cloud Storage", icon: "ti-cloud-upload" },
  { name: "SNAP API", icon: "ti-credit-card" },
  { name: "Three.js", icon: "ti-brand-threejs" },
  { name: "Framer Motion", icon: "ti-brand-framer-motion" },
  { name: "GSAP", icon: "ti-keyframes" },
  { name: "Anime.js", icon: "ti-sparkles" },
  { name: "Leaflet.js", icon: "ti-map-2" },
  { name: "Chart.js", icon: "ti-chart-line" },
  { name: "Git & GitHub", icon: "ti-brand-github" },
  { name: "GitHub Pages", icon: "ti-brand-git" },
  { name: "OWASP Guidelines", icon: "ti-shield-check" },
  { name: "SEO & Metadata", icon: "ti-search" },
  { name: "Accessibility (a11y)", icon: "ti-accessible" },
];
---

<!-- 01 // OVERVIEW SECTION (Magazine Spread with Side Core Stack) -->
<section
  id="intro"
  aria-labelledby="heading-intro"
  class="scroll-mt-24 pt-0 space-y-12 overview-section"
>
  <div
    class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start pt-0"
  >
    <!-- Left Column: Portrait Photo with Studio Frame -->
    <div
      class="lg:col-span-5 xl:col-span-5 lg:sticky lg:top-24 flex flex-col items-center justify-center pt-0"
      style="transform: translateZ(0);"
    >
      <div
        class="relative w-full max-w-md sm:max-w-lg flex flex-col items-center justify-center border-b border-neutral-300/80 dark:border-neutral-800 overflow-hidden"
        style="transform: translateZ(0);"
      >
        <!-- Corner Registration Greebles -->
        <span aria-hidden="true" class="absolute top-2 left-2 z-20 font-mono text-[10px] leading-none text-neutral-400/60 dark:text-neutral-600 select-none pointer-events-none">┌</span>
        <span aria-hidden="true" class="absolute top-2 right-2 z-20 font-mono text-[10px] leading-none text-neutral-400/60 dark:text-neutral-600 select-none pointer-events-none">┐</span>
        <div aria-hidden="true" class="absolute bottom-0 left-0 z-20 flex items-center pointer-events-none">
          <span class="w-4 h-[2px] bg-[var(--color-accent,#BCFF1C)]"></span>
          <span class="w-4 h-[2px] bg-[var(--color-accent-complementary,#F2003C)]"></span>
          <span class="w-2 h-[2px] bg-neutral-400/50 dark:bg-neutral-600/50"></span>
        </div>

        <!-- Dithering Shader Wave Backdrop -->
        <div
          class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden"
          style="transform: translateZ(0); will-change: transform; backface-visibility: hidden;"
        >
          <DitheringShader
            client:visible
            shape="wave"
            type="8x8"
            pxSize={1}
            speed={0.6}
          />
        </div>

        <Image
          src={vPortrait}
          alt="Portrait of Yovan Gunardio Darmawan"
          width="540"
          height="540"
          class="relative z-10 w-full max-h-[500px] sm:max-h-[540px] object-contain object-bottom select-none pt-4"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div
        class="w-full pt-3 flex items-center justify-between text-xs text-neutral-400 dark:text-neutral-500 font-sans px-1"
      >
        <EggLink
          easter="modpe"
          en="Entity.setRenderType(mob, 3);"
          ariaEn="Unlock ModPE Scripting Cool Stuff"
          ariaId="Buka Cool Stuff Skrip ModPE"
          class="font-mono text-[11px]"
        />
        <div class="flex items-center gap-2">
          <span aria-hidden="true" class="inline-flex items-center gap-1 select-none">
            <span class="w-1.5 h-1.5 bg-[var(--color-accent,#BCFF1C)]"></span>
            <span class="w-1.5 h-1.5 bg-[var(--color-accent-complementary,#F2003C)]"></span>
          </span>
          <EggLink
            easter="brght"
            en="x89"
            ariaEn="Unlock Cognitive Metrics Cool Stuff"
            class="font-mono text-[11px]"
          />
        </div>
      </div>
    </div>

    <!-- Right Column: Editorial Narrative & Stack -->
    <div class="lg:col-span-7 xl:col-span-7 space-y-7">
      <!-- Headline: Satoshi, 36px, line-height: 1.25, normal weight with thin 'world wide web' -->
      <h2
        class="font-sans font-normal text-2xl sm:text-3xl lg:text-[36px] text-neutral-950 dark:text-white leading-[1.25] tracking-tight m-0"
      >
        <span
          data-en="Hello, I'm Yovan. I build things for the "
          data-id="Halo, aku Yovan. Aku bikin ini dan itu buat di "
          >Hello, I'm Yovan. I build things for the
        </span><span
          class="font-light text-neutral-500 dark:text-neutral-400"
          data-en="world wide web"
          data-id="internet">world wide web</span
        ><span
          data-en=" and occasionally things that "
          data-id=" dan sesekali yang "
        >
          and occasionally things that
        </span><span data-en="talk to machines" data-id="nyambung ke hardware"
          >talk to machines</span
        >.
      </h2>

      <!-- Anchor alias for #about -->
      <div
        id="about"
        class="scroll-mt-28 pointer-events-none"
        aria-hidden="true"
      >
      </div>

      <!-- About Narrative (Integrated from Section 05) -->
      <div
        class="space-y-4 pt-1 text-base sm:text-[17px] text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal"
      >
        <p
          data-en="Started out modding Java and Android games; curiosity did the rest. Today I design systems from interface all the way down to bare metal."
          data-id="Berawal dari ngoprek game Java dan Android; rasa penasaran menuntunku dari sana ke sini. Sampai merancang sistem dari antarmuka sampai ke mesin."
          class="m-0"
        >
          Started out modding Java and Android games; curiosity did the rest.
          Today I design systems from interface all the way down to bare metal.
        </p>
      </div>

      <!-- Unboxed Two Columns -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8 lg:gap-10 pt-1 sm:pt-2 pb-2"
      >
        <div class="relative flex flex-col gap-2 sm:gap-2.5 pl-3.5 border-l border-neutral-200 dark:border-neutral-800/90">
          <span aria-hidden="true" class="absolute -left-[1px] top-0 w-[2px] h-3.5 bg-[var(--color-accent,#BCFF1C)]"></span>
          <h3
            class="flex items-center gap-2.5 font-sans font-normal text-base sm:text-lg text-neutral-900 dark:text-white tracking-normal leading-tight m-0"
          >
            <svg
              class="w-[18px] h-[18px] shrink-0 text-[var(--color-accent,#BCFF1C)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
              <path d="M2 12h20"></path>
            </svg>
            <span data-en="The Digital Realm" data-id="Dunia Digital">
              The Digital Realm
            </span>
          </h3>
          <p
            class="font-sans text-[14px] sm:text-[14.5px] leading-relaxed text-neutral-600 dark:text-neutral-400 m-0"
            data-en="Full-stack web applications, interactive dashboards, and client portals built with clean semantic structure."
            data-id="Aplikasi web full-stack, dashboard interaktif, dan portal klien dengan struktur semantik rapi."
          >
            Full-stack web applications, interactive dashboards, and client
            portals built with clean semantic structure.
          </p>
        </div>
        <div class="relative flex flex-col gap-2 sm:gap-2.5 pl-3.5 border-l border-neutral-200 dark:border-neutral-800/90">
          <span aria-hidden="true" class="absolute -left-[1px] top-0 w-[2px] h-3.5 bg-[var(--color-accent-complementary,#F2003C)]"></span>
          <h3
            class="flex items-center gap-2.5 font-sans font-normal text-base sm:text-lg text-neutral-900 dark:text-white tracking-normal leading-tight m-0"
          >
            <svg
              class="w-[18px] h-[18px] shrink-0 text-[var(--color-accent-complementary,#F2003C)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="16" height="16" x="4" y="4" rx="2"></rect>
              <rect width="6" height="6" x="9" y="9" rx="1"></rect>
              <path d="M15 2v2"></path>
              <path d="M15 20v2"></path>
              <path d="M2 15h2"></path>
              <path d="M2 9h2"></path>
              <path d="M20 15h2"></path>
              <path d="M20 9h2"></path>
              <path d="M9 2v2"></path>
              <path d="M9 20v2"></path>
            </svg>
            <span data-en="The Physical Layer" data-id="Lapisan Fisik">
              The Physical Layer
            </span>
          </h3>
          <p
            class="font-sans text-[14px] sm:text-[14.5px] leading-relaxed text-neutral-600 dark:text-neutral-400 m-0"
          >
            <span
              data-en="Touchscreen kiosks, connected "
              data-id="Touchscreen kiosk, "
              >Touchscreen kiosks, connected
            </span><EggLink
              easter="gpio"
              en="microcontrollers"
              id="mikrokontroler"
              ariaEn="Unlock GPIO16 Cool Stuff"
              ariaId="Buka Cool Stuff GPIO16"
            /><span
              data-en=" (ESP32), payment gateways, and direct serial/IPC protocols."
              data-id=" terhubung (ESP32), payment gateway, dan protokol serial/IPC."
            >
              (ESP32), payment gateways, and direct serial/IPC protocols.</span
            >
          </p>
        </div>
      </div>

      <!-- Tech Stack Layout (Original unboxed breathing grid down below) -->
      <div
        class="relative pt-6 border-t border-neutral-200/80 dark:border-neutral-800/80"
      >
        <!-- Intersection Crosshair Greebles on Divider -->
        <span aria-hidden="true" class=" absolute -top-[6px] -left-1 font-mono text-[10px] leading-none text-neutral-400/70 dark:text-neutral-600 select-none pointer-events-none">+</span>
        <span aria-hidden="true" class="absolute -top-[6px] -right-1 font-mono text-[10px] leading-none text-neutral-400/70 dark:text-neutral-600 select-none pointer-events-none">+</span>

        <!-- Core Stack Header -->
        <div class="flex items-center justify-between pb-4">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="w-1.5 h-1.5 bg-[var(--color-accent,#BCFF1C)]"></span>
            <h3
              class="font-sans font-medium text-[10.5px] sm:text-xs uppercase tracking-[0.5px] text-neutral-400 dark:text-neutral-300 m-0"
            >
              Core Stack
            </h3>
          </div>
          <div class="flex items-center gap-2.5">
            <span aria-hidden="true" class="hidden sm:inline-flex items-center gap-0.5 select-none">
              <span class="w-2.5 h-1 bg-[var(--color-accent,#BCFF1C)]"></span>
              <span class="w-6 h-1 bg-[var(--color-accent-complementary,#F2003C)]/80"></span>
            </span>
            <span
              class="font-sans text-[11px] text-neutral-400 dark:text-neutral-400 font-medium"
            >
              {coreStack.length} core • {supportingStack.length} supporting
            </span>
          </div>
        </div>

        <!-- Core Stack (Icon-as-Object: Unboxed, Breathing Grid) -->
        <ul
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-y-6 gap-x-4 sm:gap-x-6 list-none m-0 p-0"
          aria-label="Core Technologies"
        >
          {
            coreStack.map((tech, idx) => (
              <li class="relative flex flex-col space-y-2.5 group cursor-default">
                <div class="h-10 sm:h-11 flex items-end justify-between pr-2">
                  <div class="w-8 h-8 sm:w-9 sm:h-9 text-neutral-400 dark:text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white transition-colors duration-200 flex items-center justify-center">
                    <svg
                      role="img"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="w-full h-full"
                      aria-hidden="true"
                    >
                      <path
                        d={
                          simpleIcons[tech.iconKey as keyof typeof simpleIcons]
                        }
                      />
                    </svg>
                  </div>
                  <span
                    aria-hidden="true"
                    class:list={[
                      "font-mono text-[9px] leading-none opacity-40 group-hover:opacity-100 transition-opacity select-none",
                      idx % 2 === 0
                        ? "text-[var(--color-accent,#BCFF1C)]"
                        : "text-[var(--color-accent-complementary,#F2003C)]",
                    ]}
                  >
                    0{idx + 1}
                  </span>
                </div>
                <div class="space-y-0.5">
                  <div class="font-sans font-medium text-sm sm:text-base text-neutral-950 dark:text-white tracking-tight m-0">
                    {tech.name}
                  </div>
                  <div class="font-sans text-[11px] sm:text-xs text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors duration-200 leading-tight m-0">
                    {tech.category}
                  </div>
                </div>
              </li>
            ))
          }
        </ul>

        <!-- Ecosystem & Supporting Tools (Magazine Layout) -->
        <div class="pt-6 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span aria-hidden="true" class="w-1.5 h-1.5 bg-[var(--color-accent-complementary,#F2003C)]"></span>
              <h3
                class="font-sans font-medium text-[10.5px] sm:text-xs uppercase tracking-[0.5px] text-neutral-400 dark:text-neutral-300 m-0"
              >
                Ecosystem & Supporting Tools
              </h3>
            </div>
            <span
              class="font-sans text-[11px] text-neutral-400 dark:text-neutral-400 font-medium"
            >
              {supportingStack.length} tools
            </span>
          </div>
          <ul
            class="flex flex-wrap items-center gap-x-4 gap-y-2 list-none m-0 p-0"
            aria-label="Ecosystem and Supporting Technologies"
          >
            {
              supportingStack.map((tech) => {
                return (
                  <li class="inline-flex items-center gap-1.5 text-xs text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors group">
                    <i
                      class={`ti ${tech.icon} text-sm text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors`}
                      aria-hidden="true"
                    />
                    <span class="font-sans font-medium">{tech.name}</span>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
