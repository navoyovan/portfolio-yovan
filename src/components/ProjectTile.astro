---
interface Props {
  title: string;
  category?: string;
  description?: string;
  href?: string;
  imageSrc?: string;
  imageAlt?: string;
  status?: string;
  statusVariant?: 'accent' | 'neutral' | 'warning' | 'danger' | 'info';
  tags?: string[];
  actionText?: string;
  class?: string;
  [key: string]: any;
}

import StatusBadge from './StatusBadge.astro';

const {
  title,
  category = 'FEATURED SYSTEM',
  description,
  href = '#',
  imageSrc,
  imageAlt = title,
  status,
  statusVariant = 'accent',
  tags = [],
  actionText = 'VIEW CASE STUDY',
  class: className = '',
  ...rest
} = Astro.props;
---

<article
  class:list={[
    'group relative flex flex-col bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300/80 dark:border-neutral-800 transition-all duration-200 hover:border-neutral-400 dark:hover:border-neutral-600 overflow-hidden',
    className
  ]}
  {...rest}
>
  <!-- Media / Viewfinder Container -->
  <div class="relative w-full aspect-[16/10] bg-neutral-200/60 dark:bg-neutral-900 overflow-hidden border-b border-neutral-200/80 dark:border-neutral-800/80">
    {imageSrc ? (
      <img
        src={imageSrc}
        alt={imageAlt}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
      />
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center p-6 relative select-none">
        {/* Viewfinder Corner Registration Marks */}
        <span class="absolute top-3 left-3 font-sans text-xs text-neutral-400 dark:text-neutral-600 select-none">┌</span>
        <span class="absolute top-3 right-3 font-sans text-xs text-neutral-400 dark:text-neutral-600 select-none">┐</span>
        <span class="absolute bottom-3 left-3 font-sans text-xs text-neutral-400 dark:text-neutral-600 select-none">└</span>
        <span class="absolute bottom-3 right-3 font-sans text-xs text-neutral-400 dark:text-neutral-600 select-none">┘</span>

        <div class="w-12 h-12 border border-neutral-300 dark:border-neutral-800 flex items-center justify-center mb-2 group-hover:border-[#52FF1A]/50 transition-colors">
          <span class="font-sans text-sm text-neutral-400 dark:text-neutral-500 group-hover:text-[#52FF1A] transition-colors">+</span>
        </div>
        <span class="font-sans text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-600 font-semibold">
          SYSTEM PREVIEW FRAME
        </span>
      </div>
    )}

    <!-- Floating Top Status Badge -->
    {status && (
      <div class="absolute top-3 left-3 z-10">
        <StatusBadge variant={statusVariant} size="sm">
          {status}
        </StatusBadge>
      </div>
    )}
  </div>

  <!-- Content Section -->
  <div class="p-6 flex flex-col flex-1 gap-4">
    <!-- Category Tag -->
    <span class="font-sans text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold">
      {category}
    </span>

    <!-- Syne Title -->
    <h3
      class="text-xl sm:text-2xl font-bold text-neutral-950 dark:text-white tracking-tight leading-tight group-hover:text-[#52FF1A] transition-colors font-heading"
    >
      <a href={href} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <!-- Outfit Description -->
    {description && (
      <p class="font-sans text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal">
        {description}
      </p>
    )}

    <!-- Tags Row -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-2">
        {tags.map((tag) => (
          <span class="font-sans text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2.5 py-0.5 rounded">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Action Link Footer -->
    <div class="mt-auto pt-4 border-t border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-between">
      <span class="font-sans text-xs font-bold uppercase tracking-wider text-neutral-950 dark:text-white group-hover:text-[#52FF1A] transition-colors flex items-center gap-1.5">
        {actionText}
        <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
      </span>
    </div>
  </div>
</article>
