---
interface Props {
  title: string;
  category?: string;
  description?: string;
  descriptionId?: string;
  href?: string;
  imageSrc?: string;
  imageAlt?: string;
  iframeSrc?: string;
  iframeScale?: number;
  previewBg?: string;
  status?: string;
  statusVariant?: 'accent' | 'neutral' | 'warning' | 'danger' | 'info';
  tags?: string[];
  actionText?: string;
  actionVariant?: 'dashed' | 'solid' | 'cta' | 'danger';
  metaText?: string;
  fileName?: string;
  footerName?: string;
  date?: string;
  dateLabel?: string;
  class?: string;
  [key: string]: any;
}

import StatusBadge from './StatusBadge.astro';
import HoverExpandButton from './HoverExpandButton.astro';

const {
  title,
  category = 'FEATURED SYSTEM',
  description,
  descriptionId,
  href = '#',
  imageSrc,
  imageAlt = title,
  iframeSrc,
  iframeScale = 0.28,
  previewBg,
  status,
  statusVariant = 'accent',
  tags = [],
  actionText = 'VIEW CASE STUDY',
  actionVariant = 'solid',
  metaText,
  fileName,
  footerName,
  date,
  dateLabel,
  class: className = '',
  ...rest
} = Astro.props;

const displayFooterName = footerName || fileName || metaText;
const displayDate = date || dateLabel;
const isExternal = typeof href === 'string' && href.startsWith('http');
const titleId = `tile-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article
  aria-labelledby={titleId}
  class:list={[
    'group relative flex flex-col bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300/80 dark:border-neutral-800 transition-all duration-200 hover:border-neutral-400 dark:hover:border-neutral-600 overflow-hidden shadow-sm',
    className
  ]}
  {...rest}
>
  <!-- Media / Viewfinder Container (Adapted from Easter Egg Modal) -->
  <div
    class:list={[
      'relative w-full aspect-[16/9.5] overflow-hidden border-b border-neutral-300/80 dark:border-neutral-800/80 select-none flex items-center justify-center',
      previewBg ? previewBg : 'bg-neutral-200/60 dark:bg-neutral-900'
    ]}
  >
    {iframeSrc ? (
      <iframe
        src={iframeSrc}
        title={title}
        class="border-0 pointer-events-none select-none shrink-0"
        style={`width: 1440px; height: 855px; transform: scale(${iframeScale}); transform-origin: center center;`}
        loading="lazy"
      />
    ) : imageSrc ? (
      <img
        src={imageSrc}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
      />
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center relative select-none overflow-hidden" aria-hidden="true">
        <svg class="absolute inset-0 w-full h-full text-neutral-300 dark:text-neutral-800/80" preserveAspectRatio="none" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <line x1="0" y1="100" x2="100" y2="0" stroke="currentColor" stroke-width="0.5" />
        </svg>
      </div>
    )}

    <!-- Floating Top Status Badge -->
    {status && (
      <div class="absolute top-2.5 left-2.5 z-10">
        <StatusBadge variant={statusVariant} size="sm">
          {status}
        </StatusBadge>
      </div>
    )}
  </div>

  <!-- Content Section (Compact Easter Egg Card Format) -->
  <div class="p-4 sm:p-5 flex flex-col flex-1 gap-3">
    <!-- Category Tag -->
    <p class="font-sans text-[11px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold m-0">
      {category}
    </p>

    <!-- Syne Title -->
    <h3
      id={titleId}
      class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight leading-tight group-hover:text-[var(--color-accent,#52FF1A)] transition-colors font-heading m-0"
    >
      {title}
    </h3>

    <!-- Outfit Description -->
    {description && (
      <p
        data-en={description}
        data-id={descriptionId || description}
        class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal m-0 line-clamp-5 h-[calc(1.625em*5)]"
      >
        {description}
      </p>
    )}

    <!-- Tags Row -->
    {tags.length > 0 && (
      <div class="tile-marquee-wrapper relative overflow-hidden min-w-0 pt-1">
        <div class="tile-marquee-track inline-flex items-center">
          <ul class="tile-marquee-content inline-flex items-center gap-1.5 sm:gap-2 list-none p-0 m-0 shrink-0" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <span class="font-sans text-[9px] sm:text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded inline-block">
                  {tag}
                </span>
              </li>
            ))}
            <li class="tile-dot-trailing" aria-hidden="true"></li>
          </ul>
        </div>
      </div>
    )}

    <!-- Action Link / Metadata Footer -->
    <div class="mt-auto pt-3.5 border-t border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-between gap-3 min-w-0">
      {displayFooterName ? (
        <div class="tile-marquee-wrapper relative overflow-hidden min-w-0 flex-1">
          <div class="tile-marquee-track inline-flex items-center">
            <div class="tile-marquee-content inline-flex items-center text-neutral-400 dark:text-neutral-500 whitespace-nowrap shrink-0 font-mono text-[11px]">
              <span>{displayFooterName}</span>
              <span class="tile-dot-trailing text-neutral-400 dark:text-neutral-600 select-none text-[8px] mx-2.5" aria-hidden="true">
                •
              </span>
            </div>
          </div>
        </div>
      ) : (
        <span></span>
      )}

      {displayDate && (
        <span class="font-mono text-[10px] sm:text-[11px] text-neutral-400 dark:text-neutral-500 whitespace-nowrap shrink-0">
          {displayDate}
        </span>
      )}

      {actionText && (
        <HoverExpandButton
          href={href}
          label={actionText}
          size="micro"
          variant={actionVariant}
          expandDirection="left"
          rotateIcon={false}
          ariaLabel={`${actionText}: ${title}${isExternal ? ' (opens in new tab)' : ''}`}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          class="shrink-0 ml-auto z-10"
        >
          <svg
            slot="icon"
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {isExternal ? (
              <>
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M17 7l-10 10" />
                <path d="M8 7l9 0l0 9" />
              </>
            ) : (
              <>
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </>
            )}
          </svg>
        </HoverExpandButton>
      )}
    </div>
  </div>
</article>

<style is:global>
  @keyframes tile-marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .tile-marquee-wrapper:not(.is-overflowing) .tile-dot-trailing {
    display: none !important;
  }

  .tile-marquee-wrapper.is-overflowing {
    mask-image: linear-gradient(to right, black calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black calc(100% - 24px), transparent 100%);
  }

  .tile-marquee-track {
    display: inline-flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  .tile-marquee-wrapper:hover .tile-marquee-track,
  .group:hover .tile-marquee-track,
  .tile-marquee-wrapper:focus-within .tile-marquee-track {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-marquee-track {
      animation: none !important;
      transform: none !important;
    }
    .tile-marquee-wrapper {
      mask-image: none !important;
      -webkit-mask-image: none !important;
      overflow-x: auto !important;
    }
  }
</style>

<script>
  function initTileMarquees(targetContainer?: HTMLElement | Document) {
    const root = targetContainer || document;
    const wrappers = root.querySelectorAll<HTMLElement>(".tile-marquee-wrapper");

    wrappers.forEach((wrapper) => {
      const track = wrapper.querySelector<HTMLElement>(".tile-marquee-track");
      const content = wrapper.querySelector<HTMLElement>(".tile-marquee-content");

      if (!track || !content) return;

      const containerWidth = wrapper.clientWidth;
      if (containerWidth === 0) return;

      const existingClone = track.querySelector(".tile-marquee-clone");
      if (existingClone) {
        existingClone.remove();
      }
      wrapper.classList.remove("is-overflowing");
      track.style.animation = "none";

      const contentWidth = content.scrollWidth;

      if (contentWidth > containerWidth + 2) {
        wrapper.classList.add("is-overflowing");

        const clone = content.cloneNode(true) as HTMLElement;
        clone.classList.add("tile-marquee-clone");
        clone.setAttribute("aria-hidden", "true");
        track.appendChild(clone);

        const duration = Math.max(8, contentWidth / 26);
        track.style.animationName = "tile-marquee-scroll";
        track.style.animationDuration = `${duration}s`;
        track.style.animationTimingFunction = "linear";
        track.style.animationIterationCount = "infinite";
      }
    });
  }

  if (typeof window !== "undefined") {
    let resizeTimer: number | null = null;
    let lastWidth = window.innerWidth;

    const onResize = () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => initTileMarquees(), 150);
    };

    document.addEventListener("DOMContentLoaded", () => initTileMarquees());
    window.addEventListener("resize", onResize, { passive: true });
    document.addEventListener("astro:page-load", () => initTileMarquees());
    initTileMarquees();
  }
</script>
