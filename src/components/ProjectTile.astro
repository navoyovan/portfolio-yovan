---
interface Props {
  title: string;
  category?: string;
  description?: string;
  href?: string;
  imageSrc?: string;
  imageAlt?: string;
  iframeSrc?: string;
  iframeScale?: number;
  previewBg?: string;
  status?: string;
  statusVariant?: 'accent' | 'neutral' | 'warning' | 'danger' | 'info';
  tags?: string[];
  actionText?: string;
  metaText?: string;
  class?: string;
  [key: string]: any;
}

import StatusBadge from './StatusBadge.astro';

const {
  title,
  category = 'FEATURED SYSTEM',
  description,
  href = '#',
  imageSrc,
  imageAlt = title,
  iframeSrc,
  iframeScale = 0.28,
  previewBg,
  status,
  statusVariant = 'accent',
  tags = [],
  actionText = 'VIEW CASE STUDY',
  metaText,
  class: className = '',
  ...rest
} = Astro.props;

const isExternal = typeof href === 'string' && href.startsWith('http');
const titleId = `tile-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article
  aria-labelledby={titleId}
  class:list={[
    'group relative flex flex-col bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300/80 dark:border-neutral-800 transition-all duration-200 hover:border-neutral-400 dark:hover:border-neutral-600 overflow-hidden shadow-sm',
    className
  ]}
  {...rest}
>
  <!-- Media / Viewfinder Container (Adapted from Easter Egg Modal) -->
  <div
    class:list={[
      'relative w-full aspect-[16/9.5] overflow-hidden border-b border-neutral-300/80 dark:border-neutral-800/80 select-none flex items-center justify-center',
      previewBg ? previewBg : 'bg-neutral-200/60 dark:bg-neutral-900'
    ]}
  >
    {iframeSrc ? (
      <iframe
        src={iframeSrc}
        title={title}
        class="border-0 pointer-events-none select-none shrink-0"
        style={`width: 1440px; height: 855px; transform: scale(${iframeScale}); transform-origin: center center;`}
        loading="lazy"
      />
    ) : imageSrc ? (
      <img
        src={imageSrc}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
      />
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center relative select-none overflow-hidden" aria-hidden="true">
        <svg class="absolute inset-0 w-full h-full text-neutral-300 dark:text-neutral-800/80" preserveAspectRatio="none" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <line x1="0" y1="100" x2="100" y2="0" stroke="currentColor" stroke-width="0.5" />
        </svg>
      </div>
    )}

    <!-- Floating Top Status Badge -->
    {status && (
      <div class="absolute top-2.5 left-2.5 z-10">
        <StatusBadge variant={statusVariant} size="sm">
          {status}
        </StatusBadge>
      </div>
    )}
  </div>

  <!-- Content Section (Compact Easter Egg Card Format) -->
  <div class="p-4 sm:p-5 flex flex-col flex-1 gap-3">
    <!-- Category Tag -->
    <p class="font-sans text-[11px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold m-0">
      {category}
    </p>

    <!-- Syne Title -->
    <h3
      id={titleId}
      class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight leading-tight group-hover:text-[#52FF1A] transition-colors font-heading m-0"
    >
      {title}
    </h3>

    <!-- Outfit Description -->
    {description && (
      <p class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal m-0">
        {description}
      </p>
    )}

    <!-- Tags Row -->
    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 pt-1 list-none p-0 m-0" aria-label="Tags">
        {tags.map((tag) => (
          <li>
            <span class="font-sans text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2.5 py-1 rounded inline-block">
              {tag}
            </span>
          </li>
        ))}
      </ul>
    )}

    <!-- Action Link / Metadata Footer -->
    <div class="mt-auto pt-3.5 border-t border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-between gap-3">
      {metaText ? (
        <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500 truncate">
          {metaText}
        </span>
      ) : (
        <span></span>
      )}
      {actionText && (
        <a
          href={href}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          aria-label={`${actionText}: ${title}${isExternal ? ' (opens in new tab)' : ''}`}
          class="group/action relative z-10 font-sans text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 hover:text-[#52FF1A] transition-colors flex items-center gap-1 shrink-0 ml-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A] rounded px-1"
        >
          <span class="group-hover/action:underline underline-offset-4 decoration-[#52FF1A]">
            {actionText}
          </span>
          <span class="inline-block opacity-0 -translate-x-1.5 transition-all duration-200 group-hover/action:opacity-100 group-hover/action:translate-x-0" aria-hidden="true">
            {isExternal ? '↗' : '→'}
          </span>
        </a>
      )}
    </div>
  </div>
</article>
