---
// ActionButton.astro - Normalized Web & Editorial Button Primitive
interface Props {
  variant?: 'primary' | 'cta' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  href,
  class: className = '',
  type = 'button',
  id,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const sizeStyles = {
  sm: 'px-5 py-2.5 text-xs tracking-wider',
  md: 'px-7 py-3.5 text-sm sm:text-base tracking-wider',
  lg: 'px-9 py-4 text-base sm:text-lg tracking-widest',
};

const baseStyles = 'uppercase inline-flex items-center justify-center leading-none select-none no-underline cursor-pointer rounded-none transition-[transform,background-color,color,border-color,opacity] duration-150 ease-out disabled:opacity-35 disabled:cursor-not-allowed disabled:pointer-events-none active:scale-[0.98] active:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A] focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950';

const variantStyles = {
  cta: "font-heading font-bold bg-[#52FF1A] text-black animate-kiosk-pulse hover:bg-[#42e012] hover:shadow-[0_0_20px_rgba(82,255,26,0.35)] active:bg-[#38c20e] active:scale-[0.98] border-none",
  primary: "font-heading font-bold bg-neutral-950 text-white hover:bg-neutral-800 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200 active:scale-[0.98] border-none",
  secondary: "font-heading font-bold bg-transparent text-neutral-900 dark:text-neutral-100 border border-dashed border-neutral-400 dark:border-neutral-600 hover:border-solid hover:border-neutral-950 dark:hover:border-white hover:bg-neutral-900/5 dark:hover:bg-white/10 active:scale-[0.98]"
};
---

<Tag
  id={id}
  href={href}
  type={!href ? type : undefined}
  disabled={!href && disabled ? true : undefined}
  class:list={[baseStyles, sizeStyles[size], variantStyles[variant], className]}
  {...rest}
>
  <slot />
</Tag>
