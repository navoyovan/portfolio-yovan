---
// HoverExpandButton.astro - Kinetic Expand-on-Hover Micro Action Trigger ported to Portfolio v5
interface Props {
  label?: string;
  variant?: 'dashed' | 'solid' | 'cta' | 'danger';
  size?: 'md' | 'micro';
  expandDirection?: 'left' | 'right';
  rotateIcon?: boolean;
  active?: boolean;
  disabled?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  ariaLabel?: string;
  class?: string;
  [key: string]: any;
}

const {
  label = 'ACTIO',
  variant = 'dashed',
  size = 'md',
  expandDirection = 'left',
  rotateIcon = true,
  active = false,
  disabled = false,
  href,
  type = 'button',
  id,
  ariaLabel,
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const isMicro = size === 'micro';

const sizeClasses = isMicro
  ? 'h-8 min-w-[32px] px-0 text-[10px] rounded-lg'
  : 'h-11 min-w-[44px] px-0 text-xs rounded-xl';

const variantClasses = {
  dashed: active
    ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-950 border border-solid border-[var(--color-accent,#52FF1A)] font-bold'
    : 'bg-[#fcfbf9] text-neutral-900 dark:bg-[#141414] dark:text-neutral-100 border border-dashed border-neutral-300 dark:border-neutral-700 hover:border-neutral-950 dark:hover:border-white hover:bg-white dark:hover:bg-neutral-900 shadow-sm',
  solid: active
    ? 'bg-neutral-900 text-white dark:bg-white dark:text-neutral-950 border border-solid border-[var(--color-accent,#52FF1A)] font-bold'
    : 'bg-[#fcfbf9] text-neutral-900 dark:bg-[#141414] dark:text-neutral-100 border border-solid border-neutral-300 dark:border-neutral-700 hover:border-neutral-950 dark:hover:border-white hover:bg-white dark:hover:bg-neutral-900 shadow-sm',
  cta: 'bg-[var(--color-accent,#52FF1A)] text-black border border-black/20 hover:bg-[var(--color-accent-hover,#42e012)] font-bold shadow-sm',
  danger: 'bg-transparent text-red-600 dark:text-red-400 border border-red-300 dark:border-red-800/80 hover:bg-red-600 hover:text-white hover:border-red-600',
};

const textMarginClasses = expandDirection === 'right'
  ? 'group-hover/expand:ml-2 group-hover/expand:mr-0 group-focus-visible/expand:ml-2 group-[.is-expanded]/expand:ml-2 group-[.is-expanded]/expand:mr-0'
  : 'group-hover/expand:mr-2 group-hover/expand:ml-0 group-focus-visible/expand:mr-2 group-[.is-expanded]/expand:mr-2 group-[.is-expanded]/expand:ml-0';

const iconAnimClasses = rotateIcon
  ? 'group-hover/expand:rotate-180 group-focus-visible/expand:rotate-180 group-[.is-expanded]/expand:rotate-180'
  : 'group-hover/expand:translate-x-0.5 group-focus-visible/expand:translate-x-0.5 group-[.is-expanded]/expand:translate-x-0.5';
---

<Tag
  id={id}
  href={href && !disabled ? href : undefined}
  type={!href ? type : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  aria-label={ariaLabel || label}
  class:list={[
    'hover-expand-btn group/expand relative inline-flex items-center justify-center font-heading font-bold tracking-wider uppercase select-none cursor-pointer overflow-hidden transition-[background-color,border-color,padding,box-shadow,color] duration-300 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]',
    sizeClasses,
    variantClasses[variant],
    isMicro ? '[&.is-expanded]:px-2.5 hover:px-2.5 focus-visible:px-2.5 group-hover/expand:px-2.5' : '[&.is-expanded]:px-3.5 hover:px-3.5 focus-visible:px-3.5 group-hover/expand:px-3.5',
    disabled ? 'opacity-40 cursor-not-allowed pointer-events-none' : '',
    className,
  ]}
  data-hover-expand
  data-direction={expandDirection}
  {...rest}
>
  {
    expandDirection === 'right' ? (
      <>
        <span class:list={["expand-icon inline-flex items-center justify-center shrink-0 transition-transform duration-300 ease-out", iconAnimClasses]}>
          <slot name="icon">
            <svg class={isMicro ? "w-3.5 h-3.5" : "w-4 h-4"} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </slot>
        </span>
        <span
          class:list={[
            'expand-label max-w-0 opacity-0 overflow-hidden whitespace-nowrap transition-[max-width,opacity,margin] duration-300 ease-out group-hover/expand:max-w-[200px] group-hover/expand:opacity-100 group-focus-visible/expand:max-w-[200px] group-focus-visible/expand:opacity-100 group-[.is-expanded]/expand:max-w-[200px] group-[.is-expanded]/expand:opacity-100',
            textMarginClasses
          ]}
        >
          {label}
        </span>
      </>
    ) : (
      <>
        <span
          class:list={[
            'expand-label max-w-0 opacity-0 overflow-hidden whitespace-nowrap transition-[max-width,opacity,margin] duration-300 ease-out group-hover/expand:max-w-[200px] group-hover/expand:opacity-100 group-focus-visible/expand:max-w-[200px] group-focus-visible/expand:opacity-100 group-[.is-expanded]/expand:max-w-[200px] group-[.is-expanded]/expand:opacity-100',
            textMarginClasses
          ]}
        >
          {label}
        </span>
        <span class:list={["expand-icon inline-flex items-center justify-center shrink-0 transition-transform duration-300 ease-out", iconAnimClasses]}>
          <slot name="icon">
            <svg class={isMicro ? "w-3.5 h-3.5" : "w-4 h-4"} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </slot>
        </span>
      </>
    )
  }
</Tag>

<script>
  function initHoverExpandButtons() {
    const buttons = document.querySelectorAll<HTMLElement>('[data-hover-expand]');
    buttons.forEach((btn) => {
      let timeoutId: number | undefined;

      const expand = () => {
        if (timeoutId) {
          clearTimeout(timeoutId);
          timeoutId = undefined;
        }
        btn.classList.add('is-expanded');
      };

      const collapse = () => {
        if (timeoutId) clearTimeout(timeoutId);
        timeoutId = window.setTimeout(() => {
          btn.classList.remove('is-expanded');
          timeoutId = undefined;
        }, 800);
      };

      btn.removeEventListener('mouseenter', expand);
      btn.removeEventListener('mouseleave', collapse);
      btn.removeEventListener('focus', expand);
      btn.removeEventListener('blur', collapse);

      btn.addEventListener('mouseenter', expand);
      btn.addEventListener('mouseleave', collapse);
      btn.addEventListener('focus', expand);
      btn.addEventListener('blur', collapse);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHoverExpandButtons);
  } else {
    initHoverExpandButtons();
  }
  document.addEventListener('astro:page-load', initHoverExpandButtons);
</script>
