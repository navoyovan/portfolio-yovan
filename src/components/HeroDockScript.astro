---
// HeroDockScript.astro — Exact scroll-docking animation engine from hype-box
---

<script>
  function initHeroDock() {
    const heroTitle = document.getElementById("hero-title");
    const navLogo = document.getElementById("navbar-logo");
    const wrapper = document.getElementById("hero-title-wrapper");

    // If no hero on page (e.g. subpages), make navbar logo visible
    if (!heroTitle || !wrapper) {
      if (navLogo) {
        navLogo.classList.remove("text-transparent", "pointer-events-none");
        navLogo.classList.add("text-neutral-950", "dark:text-white");
      }
      return;
    }

    if (!navLogo) return;

    let isScrolled = false;
    let targetTransform = "";
    let initialTop = 0;
    let initialLeft = 0;
    let initialWidth = 0;
    let initialHeight = 0;

    const calculateRects = () => {
      // Re-mount temporarily to wrapper if needed to measure true flow rect
      if (heroTitle.parentNode !== wrapper) {
        wrapper.appendChild(heroTitle);
      }

      heroTitle.style.position = "relative";
      heroTitle.style.top = "auto";
      heroTitle.style.left = "auto";
      heroTitle.style.width = "auto";
      heroTitle.style.height = "auto";
      heroTitle.style.transform = "none";
      heroTitle.style.margin = "0";

      const currentScrollY = window.scrollY || 0;
      const currentScrollX = window.scrollX || 0;

      const wRect = wrapper.getBoundingClientRect();
      const nRect = navLogo.getBoundingClientRect();
      const h1Elem = document.getElementById("hero-h1");

      initialTop = wRect.top + currentScrollY;
      initialLeft = wRect.left + currentScrollX;
      initialWidth = wRect.width;
      initialHeight = wRect.height;

      // Lock to fixed with exact wrapper coordinates
      heroTitle.style.position = "fixed";
      heroTitle.style.top = initialTop + "px";
      heroTitle.style.left = initialLeft + "px";
      heroTitle.style.width = initialWidth + "px";
      heroTitle.style.height = initialHeight + "px";
      heroTitle.style.transformOrigin = "left center";
      heroTitle.style.zIndex = "60"; // above navbar (z-50)

      const h1Width = h1Elem ? h1Elem.offsetWidth : initialWidth;
      const scale = nRect.width / (h1Width || 1);

      const navLeft = nRect.left;
      const navCenterY = nRect.top + nRect.height / 2;
      const wrapLeft = initialLeft;
      const wrapCenterY = initialTop + initialHeight / 2;

      const deltaX = navLeft - wrapLeft;
      const deltaY = navCenterY - wrapCenterY;

      targetTransform = `translate(${deltaX}px, ${deltaY}px) scale(${scale})`;

      // Move to body to escape overflow-hidden clipping from parent section
      document.body.appendChild(heroTitle);

      if (isScrolled) {
        heroTitle.style.transition = "none";
        heroTitle.style.transform = targetTransform;
      } else {
        heroTitle.style.transition = "none";
        heroTitle.style.transform = `translate(0px, -${currentScrollY}px) scale(1)`;
      }
    };

    // Always wait for web fonts to load to get true un-shifted typography dimensions
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        calculateRects();
      });
    } else {
      calculateRects();
    }

    setTimeout(calculateRects, 100);
    setTimeout(calculateRects, 500);

    let lastWidth = window.innerWidth;
    window.addEventListener("resize", () => {
      if (Math.abs(window.innerWidth - lastWidth) > 20) {
        lastWidth = window.innerWidth;
        calculateRects();
      }
    });

    const handleScroll = () => {
      const scrollY = window.scrollY || 0;
      const currentTitleTop = initialTop - scrollY;
      const topThreshold = window.innerHeight * 0.1;
      const shouldDock = currentTitleTop <= topThreshold;

      if (shouldDock) {
        if (!isScrolled) {
          isScrolled = true;
          heroTitle.style.transition = "transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)";
          heroTitle.style.transform = targetTransform;
        }
      } else {
        if (isScrolled) {
          isScrolled = false;
          heroTitle.style.transition = "transform 0.45s cubic-bezier(0.16, 1, 0.3, 1)";
          heroTitle.style.transform = `translate(0px, -${scrollY}px) scale(1)`;
        } else {
          heroTitle.style.transform = `translate(0px, -${scrollY}px) scale(1)`;
        }
      }
    };

    heroTitle.addEventListener("transitionend", (e) => {
      if (e.propertyName === "transform" && !isScrolled) {
        heroTitle.style.transition = "none";
        const scrollY = window.scrollY || 0;
        heroTitle.style.transform = `translate(0px, -${scrollY}px) scale(1)`;
      }
    });

    window.addEventListener("scroll", handleScroll, { passive: true });

    heroTitle.addEventListener("click", (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroDock);
  } else {
    initHeroDock();
  }
  document.addEventListener("astro:page-load", initHeroDock);
</script>
