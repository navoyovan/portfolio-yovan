---
// Hero.astro — Pure server-rendered static Hero with Syne 900 and clean editorial row spacing
import ActionButton from './ActionButton.astro';

interface Props {
  firstName?: string;
  middleName?: string;
  lastName?: string;
}

const {
  firstName = "yovan",
  middleName = "gunardio",
  lastName = "darmawan",
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<section
  id="greeting"
  class="hero-loading relative min-h-[70vh] flex items-center justify-start z-10 py-16 sm:py-24 w-full overflow-hidden"
>
  <div
    class="w-[92%] sm:w-[86%] lg:w-[80%] mx-auto w-full flex flex-col items-start z-10"
  >
    <div
      class="hero-title-group select-none flex flex-col leading-none pl-10 sm:pl-0"
    >
      <!-- Row 1: < yovan /> -->
      <h1
        id="hero-h1"
        class="hero-h1 relative inline-flex items-baseline whitespace-nowrap leading-[0.9] m-0 p-0 text-neutral-950/90 dark:text-white/90 font-heading font-black"
        style="letter-spacing: -0.04em; margin-bottom: 0;"
      >
        <span
          id="hero-bracket-l"
          class="hero-h1-bracket-l absolute right-full mr-[0.1em] select-none text-neutral-950 dark:text-white"
          style="bottom: 0.15em; opacity: 0.6; font-weight: 900;">&lt;</span
        >
        <span id="hero-title-text">{firstName}</span>
        <span
          id="hero-bracket-r"
          class="hero-h1-bracket-r ml-[0.1em] self-end select-none text-neutral-950 dark:text-white"
          style="margin-bottom: 0.15em; opacity: 0.6; font-weight: 900;"
          >&nbsp;/&gt;</span
        >
      </h1>

      <!-- Row 2: gunardio; -->
      <h2
        id="hero-h2"
        class="hero-h2 inline-flex items-baseline whitespace-nowrap border-none p-0 m-0 leading-[0.95] text-neutral-950/85 dark:text-white/85 font-heading font-black"
        style="letter-spacing: -0.03em; margin-top: clamp(-0.6rem, -1.2vw, -0.3rem); margin-bottom: clamp(0.2rem, 0.6vw, 0.5rem);"
      >
        <span>{middleName}</span>
        <span
          class="hero-h2-semi text-neutral-950 dark:text-white"
          style="opacity: 0.6; margin-left: 0.05em; font-weight: 900;">;</span
        >
      </h2>

      <!-- Row 3: // darmawan -->
      <h3
        id="hero-h3"
        class="hero-h3 relative inline-flex items-baseline whitespace-nowrap p-0 m-0 leading-[1] font-heading font-normal"
        style="letter-spacing: 0.06em;"
      >
        <span
          class="hero-h3-slashes text-[#52FF1A] mr-[0.25em] select-none"
          style="opacity: 0.6; font-weight: 400;">//</span
        >
        <span class="text-neutral-700/80 dark:text-neutral-300/80"
          >{lastName}</span
        >
      </h3>
    </div>

    <!-- Editorial Subtitle & Quick Action Pills -->
    <div class="mt-8 sm:mt-10 max-w-2xl space-y-6 pl-10 sm:pl-0">
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 font-normal leading-relaxed">
        Developer & systems builder turning ideas into working products — spanning web applications, touchscreen kiosk operating systems, and physical hardware.
      </p>

      <div class="space-y-4 pt-1">
        <div class="flex items-center gap-2.5">
          <a
            href="https://github.com/navoyovan"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Profile"
            class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-dashed border-neutral-400 dark:border-neutral-600 hover:border-solid hover:border-neutral-900 dark:hover:border-white hover:bg-neutral-900/5 dark:hover:bg-white/10 inline-flex items-center justify-center text-neutral-800 dark:text-neutral-200 transition-[transform,background-color,color,border-color] duration-150 active:scale-95"
          >
            <i class="ti ti-brand-github text-base sm:text-lg"></i>
          </a>

          <a
            href="https://linkedin.com/in/yovan"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn Profile"
            class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-dashed border-neutral-400 dark:border-neutral-600 hover:border-solid hover:border-neutral-900 dark:hover:border-white hover:bg-neutral-900/5 dark:hover:bg-white/10 inline-flex items-center justify-center text-neutral-800 dark:text-neutral-200 transition-[transform,background-color,color,border-color] duration-150 active:scale-95"
          >
            <i class="ti ti-brand-linkedin text-base sm:text-lg"></i>
          </a>

          <a
            href="mailto:contact@navoyovan.com"
            aria-label="Send Email"
            class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-dashed border-neutral-400 dark:border-neutral-600 hover:border-solid hover:border-neutral-900 dark:hover:border-white hover:bg-neutral-900/5 dark:hover:bg-white/10 inline-flex items-center justify-center text-neutral-800 dark:text-neutral-200 transition-[transform,background-color,color,border-color] duration-150 active:scale-95"
          >
            <i class="ti ti-mail text-base sm:text-lg"></i>
          </a>
        </div>

        <div class="flex items-center gap-3 sm:gap-4 flex-wrap">
          <ActionButton variant="primary" size="sm" href="#projects">
            FEATURED WORK
          </ActionButton>

          <ActionButton variant="secondary" size="sm" href={`${base}/portfolio-index`}>
            PORTFOLIO INDEX
          </ActionButton>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const initHero = () => {
    const greeting = document.getElementById("greeting");
    if (greeting && greeting.classList.contains("hero-loading")) {
      setTimeout(() => {
        greeting.classList.remove("hero-loading");
      }, 500);
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHero);
  } else {
    initHero();
  }
  document.addEventListener("astro:page-load", initHero);
</script>
