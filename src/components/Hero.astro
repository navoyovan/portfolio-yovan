---
// Hero.astro — Pure server-rendered static Astro component for 0kb baseline JS
interface Props {
  firstName?: string;
  middleName?: string;
  lastName?: string;
}

const {
  firstName = 'yovan',
  middleName = 'gunardio',
  lastName = 'darmawan'
} = Astro.props;
---

<section
  id="greeting"
  class="relative min-h-[80vh] flex items-center justify-start z-10 py-16 w-full overflow-hidden"
>
  <div
    class="w-full flex flex-col items-start z-10"
    style="margin-left: clamp(2.5rem, 9vw, 13rem); margin-top: clamp(1.5rem, 6vh, 6rem);"
  >
    <div
      class="text-left"
      style="--anchor: clamp(3rem, 8vw, 7rem);"
    >
      <div
        class="hero-text-identity select-none flex flex-col leading-none mb-6"
        style="padding-left: var(--anchor);"
      >
        <!-- Row 1: < yovan /> (Hype-box Docking Target) -->
        <div
          id="hero-title-wrapper"
          class="relative inline-flex items-center"
          style="height: clamp(4rem, 11.3vw, 8rem); margin-bottom: clamp(-0.8rem, -2vw, -0.3rem);"
        >
          <a
            id="hero-title"
            href="#greeting"
            class="inline-flex items-center no-underline"
            style="color: var(--text-primary);"
          >
            <h1
              id="hero-h1"
              class="relative font-bold inline-flex items-baseline whitespace-nowrap leading-[0.95] m-0 p-0"
              style="font-family: var(--font-heading); font-weight: 800; letter-spacing: -0.04em; font-size: clamp(4rem, 11.3vw, 8rem);"
            >
              <span
                id="hero-bracket-l"
                class="absolute right-full mr-[0.12em] select-none"
                style="color: var(--text-primary); font-size: clamp(2.6rem, 7.3vw, 5rem); bottom: 0.15em; opacity: 0.6;"
              >&lt;</span>
              <span id="hero-title-text">{firstName}</span>
              <span
                id="hero-bracket-r"
                class="ml-[0.1em] self-end select-none"
                style="color: var(--text-primary); font-size: clamp(2.6rem, 7.3vw, 5rem); margin-bottom: 0.15em; opacity: 0.6;"
              >&nbsp;/&gt;</span>
            </h1>
          </a>
        </div>

        <!-- Row 2: gunardio; -->
        <h2
          class="inline-flex items-baseline whitespace-nowrap border-none p-0 m-0"
          style="font-family: var(--font-heading); font-weight: 800; letter-spacing: -0.03em; color: var(--text-primary); font-size: clamp(3.3rem, 8.6vw, 6rem); margin-bottom: clamp(0.5rem, 1vw, 0.75rem);"
        >
          <span>{middleName}</span>
          <span
            style="color: var(--text-primary); opacity: 0.6; margin-left: 0.05em; font-size: clamp(2.6rem, 7.3vw, 5rem);"
          >;</span>
        </h2>

        <!-- Row 3: // darmawan -->
        <h3
          class="relative inline-flex items-baseline whitespace-nowrap p-0 m-0"
          style="font-family: var(--font-heading); font-weight: normal; letter-spacing: 0.06em; font-size: clamp(1.8rem, 5vw, 3.3rem);"
        >
          <span
            style="font-weight: bold; color: #52FF1A; margin-right: 0.25em;"
          >//</span>
          <span
            style="color: var(--text-secondary); opacity: 0.45;"
          >{lastName}</span>
        </h3>
      </div>
    </div>
  </div>
</section>
