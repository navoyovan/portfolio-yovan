---
import { absoluteUrl, pageUrl, AUTHOR_NAME, SITE_ROOT } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string | URL;
  type?: 'website' | 'article';
  keywords?: string[];
  schema?: Record<string, any>;
  noindex?: boolean;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    author?: string;
    tags?: string[];
  };
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const {
  title = `${AUTHOR_NAME} | Software Engineer & Builder`,
  description = 'High-performance web platforms, touchscreen kiosks, and full-stack systems built with Astro, Tailwind CSS, and React.',
  image = '/og-default.png',
  imageAlt,
  canonicalURL = pageUrl(Astro.url.pathname),
  type = 'website',
  keywords = ['Astro', 'SEO', 'Web Performance', 'Tailwind CSS', 'Portfolio', 'Full-Stack', 'Systems Engineering', 'Laravel', 'Electron'],
  schema,
  noindex = false,
  article,
} = Astro.props;

const siteTitle = title.includes('Yovan') ? title : `${title} | Yovan`;
const formattedImageURL = absoluteUrl(image);
const isDefaultOgImage = image.includes('og-default.png');
const resolvedImageAlt = imageAlt ?? siteTitle;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Yovan Gunardio Darmawan',
    alternateName: 'Yovan',
    jobTitle: 'Software Engineer & Systems Builder',
    description: description,
    email: 'mailto:yovangunardio@gmail.com',
    url: SITE_ROOT,
    image: formattedImageURL,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'ID',
      addressRegion: 'Bogor, West Java',
    },
    sameAs: [
      'https://github.com/navoyovan',
      'https://linkedin.com/in/yovan-g-d-22379ba7/',
    ],
    knowsAbout: [
      'Astro',
      'React',
      'Tailwind CSS',
      'Laravel',
      'Electron',
      'WebSockets',
      'TypeScript',
      'Systems Engineering',
      'Google Cloud Platform',
      'Search Engine Optimization (SEO)',
      'Web Accessibility (a11y)',
    ],
  },
};

const finalSchema = schema || defaultSchema;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg?v=8`} />
<link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png?v=8`} />
<link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png?v=8`} />
<link rel="icon" href={`${base}/favicon.ico?v=8`} />
<link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png?v=8`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
<meta name="generator" content={Astro.generator} />

<!-- Robots / Indexing -->
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large" />
)}

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={formattedImageURL} />
{isDefaultOgImage && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta property="og:image:alt" content={resolvedImageAlt} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={AUTHOR_NAME} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={formattedImageURL} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

<!-- Article Metadata -->
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    <meta property="article:author" content={article.author ?? AUTHOR_NAME} />
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- RSS Autodiscovery -->
<link rel="alternate" type="application/rss+xml" title={`${AUTHOR_NAME} — Blog`} href={`${base}/blog/rss.xml`} />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(finalSchema)} />
