---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  type?: 'website' | 'article';
  keywords?: string[];
  schema?: Record<string, any>;
  noindex?: boolean;
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const {
  title = 'Yovan Gunardio Darmawan | Software Engineer & Builder',
  description = 'High-performance web platforms, touchscreen kiosks, and full-stack systems built with Astro, Tailwind CSS, and React.',
  image = '/og-default.png',
  canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url),
  type = 'website',
  keywords = ['Astro', 'SEO', 'Web Performance', 'Tailwind CSS', 'Portfolio', 'Full-Stack', 'Systems Engineering', 'Laravel', 'Electron'],
  schema,
  noindex = false,
} = Astro.props;

const siteTitle = title.includes('Yovan') ? title : `${title} | Yovan`;
const resolvedImagePath = image.startsWith('/') ? `${base}${image}` : image;
const formattedImageURL = new URL(resolvedImagePath, Astro.site || Astro.url).toString();
const siteUrl = Astro.site?.toString() || Astro.url.origin;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Yovan Gunardio Darmawan',
    alternateName: 'Yovan',
    jobTitle: 'Software Engineer & Systems Builder',
    description: description,
    email: 'mailto:yovangunardio@gmail.com',
    url: siteUrl,
    image: formattedImageURL,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'ID',
      addressRegion: 'Bogor, West Java',
    },
    sameAs: [
      'https://github.com/navoyovan',
      'https://linkedin.com/in/yovan-g-d-22379ba7/',
    ],
    knowsAbout: [
      'Astro',
      'React',
      'Tailwind CSS',
      'Laravel',
      'Electron',
      'WebSockets',
      'TypeScript',
      'Systems Engineering',
      'Google Cloud Platform',
      'Search Engine Optimization (SEO)',
      'Web Accessibility (a11y)',
    ],
  },
};

const finalSchema = schema || defaultSchema;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg?v=7`} />
<link rel="icon" type="image/webp" href={`${base}/favicon.webp?v=7`} />
<link rel="icon" href={`${base}/favicon.ico`} />
<link rel="apple-touch-icon" href={`${base}/favicon.svg?v=7`} />
<meta name="generator" content={Astro.generator} />

<!-- Robots / Indexing -->
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={formattedImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={siteTitle} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="Yovan Gunardio Darmawan" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(finalSchema)} />
