---
import fallbackData from "../data/github-contributions-all.json";

interface ContributionDay {
  date: string;
  count: number;
  level: number;
  placeholder?: boolean;
}

let allContributions: ContributionDay[] = fallbackData.contributions;

try {
  const res = await fetch(
    "https://github-contributions-api.jogruber.de/v4/navoyovan",
    {
      signal: AbortSignal.timeout(2500),
      headers: { "User-Agent": "navoyovan-portfolio-build" },
    },
  );
  if (res.ok) {
    const json = await res.json();
    if (json?.contributions && json.contributions.length > 0) {
      allContributions = json.contributions;
    }
  }
} catch {
  // Gracefully use local cached fallback
}

const todayStr = new Date().toISOString().split("T")[0];

// Sort chronologically ascending
const sorted = allContributions
  .slice()
  .sort((a, b) => a.date.localeCompare(b.date));

// Filter up to today
const filtered = sorted.filter((c) => c.date <= todayStr);

// Align first date to previous Sunday so every column starts on Sunday
const [startYear, startMonth, startDay] = filtered[0].date
  .split("-")
  .map(Number);
const firstDayOfWeek = new Date(startYear, startMonth - 1, startDay).getDay();
const days: ContributionDay[] = [];
for (let i = 0; i < firstDayOfWeek; i++) {
  days.push({ date: "", count: 0, level: 0, placeholder: true });
}
days.push(...filtered);

// Pad end of last week calculation (used for joined cell)
const remainder = days.length % 7;
const padCount = remainder === 0 ? 0 : 7 - remainder;

const availableWeeks = Math.ceil(days.length / 7);

// Build all full multi-year 7-day columns (~314 weeks / 5,000+ px)
const weeks: ContributionDay[][] = [];
for (let w = 0; w < availableWeeks; w++) {
  const sliceStart = w * 7;
  weeks.push(days.slice(sliceStart, sliceStart + 7));
}
---

<section
  id="github-contrib-section"
  aria-label="GitHub Contributions Telemetry"
  class="relative w-full max-w-full bg-gradient-to-b from-transparent via-transparent to-[#fcfbf9] dark:to-[#0e0e0e] p-0 mt-6 sm:mt-8 mb-0 overflow-hidden select-none"
  style="
    --cell: 14px;
    --gap: 2px;
    --pad: 6px;
    --cell-inner: 14px;
    height: calc(7 * var(--cell-inner) + 6 * var(--gap) + 2 * var(--pad) + 18px);
  "
>
  <!-- Top Registration Bar Greeble (Volt + Crimson Thermal Scale) -->
  <div
    aria-hidden="true"
    class="w-[92%] sm:w-[86%] lg:w-[80%] mx-auto flex items-center justify-between h-[18px] text-[9px] font-mono text-neutral-400 dark:text-neutral-600 pointer-events-none select-none"
  >
    <div class="flex items-center gap-1.5">
      <span>+</span>
      <span class="w-2 h-[2px] bg-[var(--color-accent,#BCFF1C)]"></span>
      <span class="w-2 h-[2px] bg-[var(--color-accent-complementary,#F2003C)]"></span>
      <span class="tracking-wider uppercase">GH // COMMITS</span>
    </div>
    <div class="flex items-center gap-1">
      <span class="pr-0.5">L1</span>
      <span class="w-2 h-2 rounded-[1px] bg-[var(--color-accent-complementary,#F2003C)]/45"></span>
      <span class="w-2 h-2 rounded-[1px] bg-[var(--color-accent-complementary,#F2003C)]/85"></span>
      <span class="w-2 h-2 rounded-[1px] bg-[var(--color-accent,#BCFF1C)]/65"></span>
      <span class="w-2 h-2 rounded-[1px] bg-[var(--color-accent,#BCFF1C)]"></span>
      <span class="pl-0.5">L4</span>
      <span class="pl-1">+</span>
    </div>
  </div>

  <!-- Heatmap: Borderless grid with top mask fade and right-anchored latest view -->
  <div
    class="relative w-full h-[calc(100%-18px)] overflow-hidden"
    style="
      -webkit-mask-image: linear-gradient(to bottom, transparent, black 35%, black 100%);
      mask-image: linear-gradient(to bottom, transparent, black 35%, black 100%);
    "
  >
    <div
      id="github-contrib-scroll"
      class="w-full h-full overflow-x-auto scrollbar-none flex justify-end items-center"
      style="padding: var(--pad);"
    >
      <div
        id="github-contrib-grid"
        role="img"
        aria-label="GitHub contribution activity over the last two years"
        class="flex flex-row h-full select-none gap-[var(--gap)] shrink-0 w-max"
      >
        {
          weeks.map((weekDays, wIndex) => {
            const isLastWeek = wIndex === weeks.length - 1;
            return (
              <div class="gcd-col">
                {weekDays.map((day) => {
                  if (day.placeholder) {
                    return (
                      <span
                        class="gcd-cell opacity-0 pointer-events-none"
                        aria-hidden="true"
                      />
                    );
                  }

                  return (
                    <span
                      class="gcd-cell"
                      data-c={day.count}
                      data-d={day.date}
                      data-l={day.level || undefined}
                    />
                  );
                })}
                {isLastWeek && padCount > 0 && (
                  <span
                    class="gcd-cell-joined"
                    data-tooltip="Rest of the week"
                    style={`height: calc(${padCount} * var(--cell-inner) + ${padCount - 1} * var(--gap));`}
                    aria-label="Rest of the week"
                  />
                )}
              </div>
            );
          })
        }

      </div>
    </div>

    <!-- Editorial Name Overlay: Yovan; Gunardio. (Hidden for now per request) -->
    <div
      class="hidden absolute inset-y-0 left-0 items-center pl-4 sm:pl-8 lg:pl-12 pointer-events-none select-none z-20"
      aria-hidden="true"
    >
      <div
        class="font-machina font-light tracking-tight text-neutral-950 dark:text-white drop-shadow-[0_2px_10px_rgba(255,255,255,0.85)] dark:drop-shadow-[0_2px_14px_rgba(0,0,0,0.95)]"
        style="
          font-size: calc(2.5 * var(--cell));
          line-height: calc(3 * var(--cell));
        "
      >
        <div>
          Yovan<span
            class="text-[var(--color-accent,#BCFF1C)]"
            >;</span>
        </div>
        <div class="text-neutral-500 dark:text-neutral-400">Gunardio.</div>
      </div>
    </div>

    <!-- Bottom Edge Gradient Overlay: Blends grid cells seamlessly into the footer background color -->
    <div
      class="absolute bottom-0 inset-x-0 h-14 bg-gradient-to-b from-transparent to-[#fcfbf9] dark:to-[#0e0e0e] pointer-events-none z-10"
      aria-hidden="true"
    >
    </div>
  </div>
</section>

<style is:global>
  #github-contrib-grid {
    --gcd-empty: #ebedf0;
    --gcd-l1: rgba(242, 0, 60, 0.35);
    --gcd-l2: rgba(242, 0, 60, 0.75);
    --gcd-l3: rgba(166, 230, 21, 0.85);
    --gcd-l4: var(--color-accent, #BCFF1C);
    --gcd-glow-l4: none;
  }

  .dark #github-contrib-grid,
  :root.dark #github-contrib-grid {
    --gcd-empty: #141414;
    --gcd-l1: rgba(242, 0, 60, 0.45);
    --gcd-l2: rgba(242, 0, 60, 0.85);
    --gcd-l3: rgba(188, 255, 28, 0.65);
    --gcd-l4: var(--color-accent, #BCFF1C);
    --gcd-glow-l4: 0 0 8px rgba(188, 255, 28, 0.45);
  }

  #github-contrib-grid .gcd-col {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: var(--gap);
    flex-shrink: 0;
    width: var(--cell-inner);
  }

  #github-contrib-grid .gcd-cell {
    width: var(--cell-inner);
    height: var(--cell-inner);
    border-radius: 1px;
    flex-shrink: 0;
    cursor: default;
    transition: transform 100ms ease;
    position: relative;
  }

  #github-contrib-grid .gcd-cell[data-d] {
    opacity: 0.6;
  }

  .dark #github-contrib-grid .gcd-cell[data-d],
  :root.dark #github-contrib-grid .gcd-cell[data-d] {
    opacity: 0.4;
  }

  @media (min-width: 640px) {
    #github-contrib-grid .gcd-cell {
      border-radius: 2px;
    }
  }

  #github-contrib-grid .gcd-cell:not([data-l]) {
    background-color: var(--gcd-empty);
  }

  #github-contrib-grid .gcd-cell[data-l="1"] {
    background-color: var(--gcd-l1);
  }

  #github-contrib-grid .gcd-cell[data-l="2"] {
    background-color: var(--gcd-l2);
  }

  #github-contrib-grid .gcd-cell[data-l="3"] {
    background-color: var(--gcd-l3);
  }

  #github-contrib-grid .gcd-cell[data-l="4"] {
    background-color: var(--gcd-l4);
  }

  #github-contrib-grid .gcd-cell[data-l="4"]:hover {
    box-shadow: var(--gcd-glow-l4);
  }

  #github-contrib-grid .gcd-cell[data-d]:hover,
  .dark #github-contrib-grid .gcd-cell[data-d]:hover,
  :root.dark #github-contrib-grid .gcd-cell[data-d]:hover {
    opacity: 1 !important;
    transform: scale(1.15);
    z-index: 30;
  }

  #github-contrib-grid .gcd-cell-joined {
    display: block;
    width: var(--cell-inner);
    border-radius: 2px;
    background-color: var(--gcd-empty);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.08) 2px,
      rgba(0, 0, 0, 0.08) 4px
    );
    border: none;
    opacity: 0.6;
    cursor: default;
    transition:
      transform 100ms ease,
      opacity 100ms ease;
    flex-shrink: 0;
    position: relative;
    box-sizing: border-box;
  }

  .dark #github-contrib-grid .gcd-cell-joined,
  :root.dark #github-contrib-grid .gcd-cell-joined {
    background-color: var(--gcd-empty);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.35) 2px,
      rgba(0, 0, 0, 0.35) 4px
    );
    border: none;
    opacity: 0.4;
  }

  #github-contrib-grid .gcd-cell-joined:hover,
  .dark #github-contrib-grid .gcd-cell-joined:hover,
  :root.dark #github-contrib-grid .gcd-cell-joined:hover {
    opacity: 1 !important;
    transform: scale(1.04);
    z-index: 30;
  }

  @media (prefers-reduced-motion: reduce) {
    #github-contrib-grid .gcd-cell,
    #github-contrib-grid .gcd-cell-joined {
      transition: none;
    }
    #github-contrib-grid .gcd-cell[data-d]:hover,
    #github-contrib-grid .gcd-cell-joined:hover,
    .dark #github-contrib-grid .gcd-cell[data-d]:hover,
    .dark #github-contrib-grid .gcd-cell-joined:hover,
    :root.dark #github-contrib-grid .gcd-cell[data-d]:hover,
    :root.dark #github-contrib-grid .gcd-cell-joined:hover {
      transform: none;
    }
  }
</style>

<!-- Floating Cursor/Cell Tooltip (outside masked section to prevent clipping) -->
<div
  id="github-contrib-tooltip"
  dir="ltr"
  class="pointer-events-none fixed z-[9999] px-2.5 py-1 rounded bg-neutral-950/90 text-white dark:bg-white/95 dark:text-neutral-950 font-mono text-[11px] font-light shadow-md border border-neutral-800/80 dark:border-neutral-200/80 backdrop-blur-xs transition-opacity duration-150 opacity-0 whitespace-nowrap -translate-x-1/2 -translate-y-[calc(100%+28px)]"
  aria-hidden="true"
>
</div>

<script is:inline>
  (function () {
    function setupTelemetry() {
      const scrollEl = document.getElementById("github-contrib-scroll");
      if (scrollEl) {
        scrollEl.scrollLeft = scrollEl.scrollWidth;
      }

      const grid = document.getElementById("github-contrib-grid");
      const tooltip = document.getElementById("github-contrib-tooltip");
      if (!grid || !tooltip) return;

      if (tooltip.parentElement !== document.body) {
        document.body.appendChild(tooltip);
      }

      const MONTHS = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
      ];
      function formatTelemetryDate(dateStr) {
        if (!dateStr) return "";
        const parts = dateStr.split("-");
        if (parts.length < 3) return dateStr;
        const month = MONTHS[parseInt(parts[1], 10) - 1] || parts[1];
        const day = parseInt(parts[2], 10);
        const year = parts[0];
        return `${month} ${day}, ${year}`;
      }

      function showTooltip(e) {
        const target = e.target.closest(".gcd-cell[data-d], .gcd-cell-joined");
        if (target) {
          let label = "";
          const tooltipText = target.getAttribute("data-tooltip");
          if (tooltipText) {
            label = tooltipText;
          } else {
            const count = parseInt(target.getAttribute("data-c") || "0", 10);
            const dateStr = target.getAttribute("data-d");
            const formattedDate = formatTelemetryDate(dateStr);
            const countText = `${count} contribution${count === 1 ? "" : "s"}`;
            label = `${countText} on ${formattedDate}`;
          }

          if (tooltip) {
            tooltip.textContent = label;
            tooltip.style.opacity = "1";

            const rect = tooltip.getBoundingClientRect();
            const width = rect.width || 160;
            const height = rect.height || 28;
            const halfW = width / 2;
            const pad = 12;

            const cellRect = target.getBoundingClientRect();
            const cellCenterX = cellRect.left + cellRect.width / 2;
            const clampedX = Math.max(
              halfW + pad,
              Math.min(window.innerWidth - halfW - pad, cellCenterX),
            );
            tooltip.style.left = `${clampedX}px`;

            if (cellRect.top < height + 35) {
              tooltip.classList.remove("-translate-y-[calc(100%+28px)]");
              tooltip.classList.add("translate-y-[28px]");
              tooltip.style.top = `${cellRect.bottom}px`;
            } else {
              tooltip.classList.remove("translate-y-[28px]");
              tooltip.classList.add("-translate-y-[calc(100%+28px)]");
              tooltip.style.top = `${cellRect.top}px`;
            }
          }
        } else {
          hideTooltip();
        }
      }

      function hideTooltip() {
        if (tooltip) tooltip.style.opacity = "0";
      }

      // ---- Live refresh ----
      // The grid above is rendered at build time; this quietly replaces it with
      // fresh data fetched from the visitor's browser. The response is cached
      // for one hour (matching the API's own cache window) so a visitor makes at
      // most one request per hour instead of one per page view.
      const LIVE_TTL = 60 * 60 * 1000;
      const LIVE_KEY = "gh-contrib-v4";

      function buildGridData(contributions) {
        const today = new Date().toISOString().split("T")[0];
        const filtered = contributions
          .slice()
          .sort((a, b) => String(a.date).localeCompare(String(b.date)))
          .filter((c) => c.date && c.date <= today);
        if (filtered.length === 0) return null;

        const [y, m, d] = filtered[0].date.split("-").map(Number);
        const firstDayOfWeek = new Date(y, m - 1, d).getDay();

        const days = [];
        for (let i = 0; i < firstDayOfWeek; i++) {
          days.push({ date: "", count: 0, level: 0, placeholder: true });
        }
        days.push(...filtered);

        const remainder = days.length % 7;
        return {
          days,
          padCount: remainder === 0 ? 0 : 7 - remainder,
          weeks: Math.ceil(days.length / 7),
        };
      }

      function renderGrid(gridEl, data) {
        const frag = document.createDocumentFragment();

        for (let w = 0; w < data.weeks; w++) {
          const col = document.createElement("div");
          col.className = "gcd-col";

          for (const day of data.days.slice(w * 7, w * 7 + 7)) {
            const cell = document.createElement("span");
            if (day.placeholder) {
              cell.className = "gcd-cell opacity-0 pointer-events-none";
              cell.setAttribute("aria-hidden", "true");
            } else {
              cell.className = "gcd-cell";
              cell.setAttribute("data-c", String(day.count));
              cell.setAttribute("data-d", day.date);
              if (day.level) cell.setAttribute("data-l", String(day.level));
            }
            col.appendChild(cell);
          }

          if (w === data.weeks - 1 && data.padCount > 0) {
            const joined = document.createElement("span");
            joined.className = "gcd-cell-joined";
            joined.setAttribute("data-tooltip", "Rest of the week");
            joined.setAttribute("aria-label", "Rest of the week");
            joined.style.height = `calc(${data.padCount} * var(--cell-inner) + ${data.padCount - 1} * var(--gap))`;
            col.appendChild(joined);
          }

          frag.appendChild(col);
        }

        gridEl.replaceChildren(frag);
      }

      function readLiveCache() {
        try {
          const cached = JSON.parse(localStorage.getItem(LIVE_KEY) || "null");
          if (
            cached &&
            Array.isArray(cached.days) &&
            typeof cached.at === "number" &&
            Date.now() - cached.at < LIVE_TTL
          ) {
            return cached.days;
          }
        } catch {
          /* malformed cache — ignore */
        }
        return null;
      }

      function applyContributions(gridEl, scrollEl, contributions) {
        if (!Array.isArray(contributions) || contributions.length === 0) return;
        const data = buildGridData(contributions);
        if (!data) return;
        renderGrid(gridEl, data);
        if (scrollEl) scrollEl.scrollLeft = scrollEl.scrollWidth;
      }

      async function refreshLiveContributions(gridEl, scrollEl) {
        const cached = readLiveCache();
        if (cached) {
          applyContributions(gridEl, scrollEl, cached);
          return;
        }

        try {
          const res = await fetch(
            "https://github-contributions-api.jogruber.de/v4/navoyovan",
            {
              signal: AbortSignal.timeout(6000),
              headers: { Accept: "application/json" },
            },
          );
          if (!res.ok) return;

          const json = await res.json();
          if (!json?.contributions?.length) return;

          const fresh = json.contributions.map((c) => ({
            date: c.date,
            count: c.count,
            level: c.level,
          }));

          try {
            localStorage.setItem(
              LIVE_KEY,
              JSON.stringify({ at: Date.now(), days: fresh }),
            );
          } catch {
            /* storage unavailable — non-fatal */
          }

          applyContributions(gridEl, scrollEl, fresh);
        } catch {
          /* offline / aborted — keep the build-time render */
        }
      }

      grid.addEventListener("mouseover", showTooltip);
      grid.addEventListener("mousemove", showTooltip);
      grid.addEventListener("mouseleave", hideTooltip);

      refreshLiveContributions(grid, scrollEl);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupTelemetry);
    } else {
      setupTelemetry();
    }
    document.addEventListener("astro:page-load", setupTelemetry);
  })();
</script>
