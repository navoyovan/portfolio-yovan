<script>
  import { animate } from "motion";

  function setupOthersHorizontalScroll() {
    const container = document.getElementById("others-scroll-container");
    const track = document.getElementById("others-scrollbar-track");
    const thumb = document.getElementById("others-scrollbar-thumb");
    if (!container || !track || !thumb) return;

    let isDraggingThumb = false;
    let startThumbX = 0;
    let initialThumbX = 0;
    let currentThumbX = 0;

    const updateThumb = () => {
      if (isDraggingThumb) return;
      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) {
        track.style.display = "none";
        return;
      }
      track.style.display = "flex";

      const trackWidth = track.clientWidth;
      const thumbWidth = Math.max(
        28,
        (container.clientWidth / container.scrollWidth) * trackWidth,
      );
      thumb.style.width = `${thumbWidth}px`;

      const maxThumbTravel = trackWidth - thumbWidth;
      const scrollProgress = Math.min(
        1,
        Math.max(0, container.scrollLeft / maxScroll),
      );
      currentThumbX = scrollProgress * maxThumbTravel;
      thumb.style.transform = `translateX(${currentThumbX}px)`;
    };

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateThumb();
          ticking = false;
        });
        ticking = true;
      }
    };

    container.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    requestAnimationFrame(updateThumb);
    setTimeout(updateThumb, 300);

    // Scrollbar Thumb Dragging (Instant 1:1 Response)
    thumb.addEventListener("mousedown", (e) => {
      if (e.button !== 0) return;
      isDraggingThumb = true;
      startThumbX = e.clientX;
      initialThumbX = currentThumbX;
      container.style.scrollBehavior = "auto";
      document.body.classList.add("select-none", "cursor-grabbing");
      e.preventDefault();
      e.stopPropagation();

      const onMouseMove = (moveEvent: MouseEvent) => {
        if (!isDraggingThumb) return;
        const deltaX = moveEvent.clientX - startThumbX;
        const trackWidth = track.clientWidth;
        const thumbWidth = thumb.clientWidth;
        const maxThumbTravel = trackWidth - thumbWidth;
        const maxScroll = container.scrollWidth - container.clientWidth;
        if (maxThumbTravel <= 0 || maxScroll <= 0) return;

        let newThumbX = Math.max(
          0,
          Math.min(maxThumbTravel, initialThumbX + deltaX),
        );
        currentThumbX = newThumbX;
        thumb.style.transform = `translateX(${newThumbX}px)`;

        const scrollProgress = newThumbX / maxThumbTravel;
        container.scrollLeft = scrollProgress * maxScroll;
      };

      const onMouseUp = () => {
        isDraggingThumb = false;
        container.style.scrollBehavior = "";
        document.body.classList.remove("select-none", "cursor-grabbing");
        window.removeEventListener("mousemove", onMouseMove);
        window.removeEventListener("mouseup", onMouseUp);
      };

      window.addEventListener("mousemove", onMouseMove);
      window.addEventListener("mouseup", onMouseUp);
    });

    // Track Click to Jump
    track.addEventListener("click", (e) => {
      if (e.target === thumb) return;
      const rect = track.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const trackWidth = track.clientWidth;
      const thumbWidth = thumb.clientWidth;
      const maxThumbTravel = trackWidth - thumbWidth;
      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxThumbTravel <= 0 || maxScroll <= 0) return;

      const targetThumbX = Math.min(
        maxThumbTravel,
        Math.max(0, clickX - thumbWidth / 2),
      );
      const targetProgress = targetThumbX / maxThumbTravel;
      container.scrollTo({
        left: targetProgress * maxScroll,
        behavior: "smooth",
      });
    });
  }

  function setupMorphingCards() {
    const container = document.getElementById("others-scroll-container");
    const slots = document.querySelectorAll<HTMLElement>("[data-project-slot]");
    if (!slots.length || !container) return;

    const activeAnimations = new WeakMap<HTMLElement, { stop: () => void }>();
    const isTouch = window.matchMedia("(hover: none)").matches;

    // Touch media-player controls: tap media to reveal logo overlay + zoom
    // button, auto-fade after 3s idle (group-hover never fires without hover).
    const controlsTimers = new WeakMap<HTMLElement, number>();

    const hideMediaControls = (media: HTMLElement) => {
      const t = controlsTimers.get(media);
      if (t) {
        window.clearTimeout(t);
        controlsTimers.delete(media);
      }
      media.classList.remove("controls-visible");
    };

    const showMediaControls = (media: HTMLElement) => {
      const t = controlsTimers.get(media);
      if (t) window.clearTimeout(t);
      media.classList.add("controls-visible");
      controlsTimers.set(
        media,
        window.setTimeout(() => {
          media.classList.remove("controls-visible");
          controlsTimers.delete(media);
        }, 3000),
      );
    };

    // Video autoplay, one at a time on every viewport: visibility is measured
    // against the screen (viewport root), so only the most-visible tile on
    // screen plays and the rest stay paused (saves decode/battery). Expanded
    // tile owns its own playback via expand/collapse and is left alone here.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if ("IntersectionObserver" in window) {
      const visibility = new Map<HTMLElement, number>();
      slots.forEach((slot) => visibility.set(slot, 0));

      const updatePlayback = () => {
        const anyExpanded = Array.from(slots).some(
          (s) => (s as HTMLElement).getAttribute("data-is-expanded") === "true",
        );
        let bestSlot: HTMLElement | null = null;
        let bestRatio = 0;
        visibility.forEach((ratio, slot) => {
          // Skip picture tiles — only video tiles compete for autoplay
          if (ratio > bestRatio && slot.querySelector("video.morph-video")) {
            bestRatio = ratio;
            bestSlot = slot;
          }
        });
        slots.forEach((slot) => {
          const el = slot as HTMLElement;
          const video = el.querySelector<HTMLVideoElement>("video.morph-video");
          if (!video) return;
          if (el.getAttribute("data-is-expanded") === "true") return;
          if (
            anyExpanded ||
            reduceMotion ||
            el !== bestSlot ||
            bestRatio < 0.35
          ) {
            if (!video.paused) video.pause();
            return;
          }
          if (video.paused) {
            video.muted = true;
            video.play().catch(() => {});
          }
        });
      };

      const videoObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            visibility.set(
              entry.target as HTMLElement,
              entry.isIntersecting ? entry.intersectionRatio : 0,
            );
          });
          updatePlayback();
        },
        { root: null, threshold: [0, 0.35, 0.6, 1] },
      );
      slots.forEach((slot) => videoObserver.observe(slot));

      // Background tab: pause everything; resume the most-visible on return
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          slots.forEach((slot) => {
            const video = (slot as HTMLElement).querySelector<HTMLVideoElement>(
              "video.morph-video",
            );
            if (video && !video.paused) video.pause();
          });
        } else {
          updatePlayback();
        }
      });
    }

    const collapseSlot = (slot: HTMLElement) => {
      const card = slot.querySelector<HTMLElement>("[data-morph-card]");
      const content = slot.querySelector<HTMLElement>("[data-morph-content]");
      const video = slot.querySelector<HTMLVideoElement>("video.morph-video");

      if (!card || !content) return;

      const prevCardAnim = activeAnimations.get(card);
      if (prevCardAnim) prevCardAnim.stop();
      const prevContentAnim = activeAnimations.get(content);
      if (prevContentAnim) prevContentAnim.stop();

      // Z-INDEX RACE FIX: Keep card at elevated z-index (50) during collapse so it never
      // drops behind neighboring or expanding cards (which use z-index 60).
      card.style.zIndex = "50";

      // Target footprint: measure slot dimensions in exact pixels
      const targetHeight = `${slot.offsetHeight}px`;

      // Freeze auto height to px so Motion can animate smoothly down to target height
      if (!card.style.height || card.style.height === "auto") {
        card.style.height = `${card.offsetHeight}px`;
        void card.offsetHeight;
      }

      const statusBadge = slot.querySelector<HTMLElement>(".morph-status-badge");
      if (statusBadge) {
        const prevBadgeAnim = activeAnimations.get(statusBadge);
        if (prevBadgeAnim) prevBadgeAnim.stop();
        const badgeAnim = animate(
          statusBadge,
          { y: 0 },
          { duration: 0.35, ease: [0.16, 1, 0.3, 1] }
        );
        activeAnimations.set(statusBadge, badgeAnim);
      }

      card.classList.add("is-morphing");
      card.classList.add("is-collapsing");
      slot.setAttribute("data-is-expanded", "false");

      const cardAnim = animate(
        card,
        {
          width: "100%",
          left: "0px",
          top: "0px",
          height: targetHeight,
          boxShadow: "none",
        },
        {
          duration: 0.35,
          ease: [0.16, 1, 0.3, 1],
        },
      );
      activeAnimations.set(card, cardAnim);
      cardAnim.then(() => {
        card.setAttribute("aria-expanded", "false");
        card.classList.remove("is-morphing");
        card.classList.remove("is-collapsing");
        if (statusBadge) statusBadge.style.transform = "";
        card.style.width = "100%";
        card.style.height = "100%";
        card.style.left = "0px";
        card.style.top = "0px";
        card.style.zIndex = "";
        card.style.backgroundColor = "transparent";
        card.style.transform = "";

        const anyExpanded = Array.from(slots).some(
          (s) => s.getAttribute("data-is-expanded") === "true",
        );
        if (!anyExpanded) {
          const carouselWrapper = document.getElementById(
            "others-carousel-wrapper",
          );
          const bentoContainer = document.getElementById(
            "design-bento-container",
          );
          if (carouselWrapper) carouselWrapper.style.zIndex = "";
          if (bentoContainer) bentoContainer.style.zIndex = "";
        }
      });

      const metaLabel = slot.querySelector<HTMLElement>(".morph-meta-label");
      if (metaLabel) metaLabel.style.opacity = "";

      // Hide expanded details with Motion
      content.style.pointerEvents = "none";
      content.setAttribute("aria-hidden", "true");
      const contentAnim = animate(
        content,
        {
          opacity: 0,
        },
        {
          duration: 0.2,
          ease: [0.16, 1, 0.3, 1],
        },
      );
      activeAnimations.set(content, contentAnim);

      if (video) video.pause();

      const slotMedia = slot.querySelector<HTMLElement>("[data-morph-media]");
      if (slotMedia) hideMediaControls(slotMedia);
    };

    const expandSlot = (slot: HTMLElement) => {
      // 1. Collapse all other open slots (zero push on siblings)
      slots.forEach((otherSlot) => {
        if (
          otherSlot !== slot &&
          otherSlot.getAttribute("data-is-expanded") === "true"
        ) {
          collapseSlot(otherSlot);
        }
      });

      const card = slot.querySelector<HTMLElement>("[data-morph-card]");
      const content = slot.querySelector<HTMLElement>("[data-morph-content]");
      const video = slot.querySelector<HTMLVideoElement>("video.morph-video");

      if (!card || !content) return;

      const prevCardAnim = activeAnimations.get(card);
      if (prevCardAnim) prevCardAnim.stop();
      const prevContentAnim = activeAnimations.get(content);
      if (prevContentAnim) prevContentAnim.stop();

      // Immediately set expanded state so media hover effects and inactive styles switch instantly
      card.setAttribute("aria-expanded", "true");
      slot.setAttribute("data-is-expanded", "true");

      // 2. Real geometric morph: physically animate width, height, top, left using Motion
      const media = slot.querySelector<HTMLElement>("[data-morph-media]");
      const mediaH = media
        ? media.offsetHeight
        : Math.round((card.offsetWidth * 9) / 16);
      const isBento = slot.dataset.variant === "bento";
      const topOffset = Math.round(mediaH * 0.125); // keeps middle point of image pinned

      if (isBento) {
        const slotW = slot.offsetWidth;
        const slotH = slot.offsetHeight;
        card.style.setProperty("--bento-aspect", `${slotW} / ${slotH}`);
      }

      // Section stacking elevation: ensure expanding card section sits cleanly above other sections
      const carouselWrapper = document.getElementById(
        "others-carousel-wrapper",
      );
      const bentoContainer = document.getElementById("design-bento-container");
      if (isBento) {
        if (bentoContainer) bentoContainer.style.zIndex = "45";
        if (carouselWrapper) carouselWrapper.style.zIndex = "20";
      } else {
        if (carouselWrapper) carouselWrapper.style.zIndex = "45";
        if (bentoContainer) bentoContainer.style.zIndex = "10";
      }

      card.style.transform = "none";
      card.style.zIndex = "60";
      card.style.boxShadow = "none";
      card.style.backgroundColor = document.documentElement.classList.contains(
        "dark",
      )
        ? "#141414"
        : "#f6f4ee";

      card.classList.add("is-morphing");
      // Mobile: grow vertically in place (no horizontal bleed — viewport is
      // already ~slot width, so 125% would overshoot both sides). Desktop
      // keeps the 125% / -12.5% horizontal bloom.
      // Edge-aware bloom: middle tiles bloom centered (±12.5%), but the first
      // tile blooms rightward and the last tile leftward so nothing clips off
      // the viewport edge (scroll can't go negative past the flush edge).
      const isMobile = window.innerWidth < 640;
      let leftFactor = 0;
      let rightFactor = 0;
      if (!isMobile) {
        if (isBento) {
          // Bento cards all bloom centered with uniform 125% width
          leftFactor = 0.125;
          rightFactor = 0.125;
        } else {
          // Carousel cards: 125% expansion; edge-aware so 1st card blooms rightward and last leftward
          const carouselSlots = Array.from(
            document.querySelectorAll("#others-scroll-container .project-slot"),
          );
          const cIndex = carouselSlots.indexOf(slot);
          if (cIndex === 0) {
            leftFactor = 0;
            rightFactor = 0.25;
          } else if (cIndex === carouselSlots.length - 1) {
            leftFactor = 0.25;
            rightFactor = 0;
          } else {
            leftFactor = 0.125;
            rightFactor = 0.125;
          }
        }
      }
      const targetWidth = `${(1 + leftFactor + rightFactor) * 100}%`;

      // Measure true natural height AT targetWidth so the card smoothly animates
      // directly to its exact required height without overshoot or rubberbanding.
      const prevWidth = card.style.width;
      const prevHeight = card.style.height;
      card.style.width = targetWidth;
      card.style.height = "auto";
      const naturalH = card.scrollHeight;
      card.style.width = prevWidth || "";
      card.style.height = prevHeight || "";
      void card.offsetHeight;

      const targetHeight = Math.ceil(naturalH);

      const expandedGeometry = {
        width: targetWidth,
        left: leftFactor === 0 ? "0px" : `${-leftFactor * 100}%`,
        top: `-${topOffset}px`,
        height: `${targetHeight}px`,
        boxShadow: "none",
      };
      const statusBadge = slot.querySelector<HTMLElement>(".morph-status-badge");
      if (statusBadge) {
        const prevBadgeAnim = activeAnimations.get(statusBadge);
        if (prevBadgeAnim) prevBadgeAnim.stop();
        const badgeAnim = animate(
          statusBadge,
          { y: -26 },
          { duration: 0.4, ease: [0.16, 1, 0.3, 1] }
        );
        activeAnimations.set(statusBadge, badgeAnim);
      }

      const cardAnim = animate(card, expandedGeometry, {
        duration: 0.4,
        ease: [0.16, 1, 0.3, 1],
      });
      activeAnimations.set(card, cardAnim);
      cardAnim.then(() => {
        card.classList.remove("is-morphing");
        card.style.height = "auto";
      });

      const metaLabel = slot.querySelector<HTMLElement>(".morph-meta-label");
      if (metaLabel) metaLabel.style.opacity = "1";

      // 3. Reveal expanded details smoothly with Motion
      content.style.pointerEvents = "auto";
      content.setAttribute("aria-hidden", "false");
      const contentAnim = animate(
        content,
        {
          opacity: [0, 1],
          y: [8, 0],
        },
        {
          duration: 0.32,
          delay: 0.08,
          ease: [0.16, 1, 0.3, 1],
        },
      );
      activeAnimations.set(content, contentAnim);

      if (video) video.play().catch(() => {});

      // Touch: flash media-player controls (logo + zoom), auto-hide when idle
      if (isTouch && media) showMediaControls(media);

      // 4. ALONGSIDE THE MIDDLE ANCHOR: Ensure expanded card is ALWAYS fully in the viewport!
      // A. Horizontal scroll container alignment (carousel only)
      if (container && !isBento) {
        const slotLeft = slot.offsetLeft;
        const slotWidth = slot.offsetWidth;
        const expandedWidth = slotWidth * (1 + leftFactor + rightFactor);
        const expandedLeft = slotLeft - slotWidth * leftFactor;
        const expandedRight = expandedLeft + expandedWidth;

        const currentScroll = container.scrollLeft;
        const containerWidth = container.clientWidth;
        const maxScroll = container.scrollWidth - containerWidth;
        const padding = 28;

        let targetScroll = currentScroll;

        if (expandedWidth > containerWidth - padding * 2) {
          targetScroll =
            (expandedLeft + expandedRight) / 2 - containerWidth / 2;
        } else if (expandedLeft - padding < currentScroll) {
          targetScroll = expandedLeft - padding;
        } else if (expandedRight + padding > currentScroll + containerWidth) {
          targetScroll = expandedRight + padding - containerWidth;
        }

        const clampedScroll = Math.max(0, Math.min(targetScroll, maxScroll));
        if (Math.abs(clampedScroll - currentScroll) > 2) {
          container.scrollTo({
            left: clampedScroll,
            behavior: "smooth",
          });
        }
      }

      // B. Vertical window viewport alignment
      const slotRect = slot.getBoundingClientRect();
      const cardHeight = targetHeight;
      const expandedTop = slotRect.top - topOffset;
      const expandedBottom = expandedTop + cardHeight;
      const vh = window.innerHeight;
      const navClearance = 85;
      const bottomClearance = 25;

      let windowDeltaY = 0;
      if (expandedBottom > vh - bottomClearance) {
        windowDeltaY = expandedBottom - (vh - bottomClearance);
      }
      if (expandedTop - windowDeltaY < navClearance) {
        windowDeltaY = expandedTop - navClearance;
      }

      if (Math.abs(windowDeltaY) > 6) {
        window.scrollBy({
          top: windowDeltaY,
          behavior: "smooth",
        });
      }
    };

    slots.forEach((slot) => {
      const card = slot.querySelector<HTMLElement>("[data-morph-card]");
      const closeButtons =
        slot.querySelectorAll<HTMLElement>("[data-close-card]");
      const media = slot.querySelector<HTMLElement>("[data-morph-media]");

      // Touch: tap expanded media toggles player controls (tap zoom/modal
      // buttons still pass through). Guarded against double-binding on
      // astro:page-load re-init.
      if (media && !media.hasAttribute("data-controls-bound")) {
        media.setAttribute("data-controls-bound", "true");
        media.addEventListener("click", (e) => {
          if (!isTouch) return;
          if (slot.getAttribute("data-is-expanded") !== "true") return;
          const target = e.target as HTMLElement;
          if (target.closest("button, a")) return;
          if (media.classList.contains("controls-visible")) {
            hideMediaControls(media);
          } else {
            showMediaControls(media);
          }
        });
      }

      let unhoverTimer: ReturnType<typeof setTimeout> | null = null;

      if (card) {
        card.addEventListener("mouseleave", () => {
          if (!window.matchMedia("(hover: hover)").matches) return;
          if (slot.getAttribute("data-is-expanded") !== "true") return;
          if (document.querySelector("dialog.tile-modal[open]")) return;

          if (unhoverTimer) clearTimeout(unhoverTimer);
          unhoverTimer = setTimeout(() => {
            if (
              slot.getAttribute("data-is-expanded") === "true" &&
              !document.querySelector("dialog.tile-modal[open]")
            ) {
              collapseSlot(slot);
            }
          }, 150);
        });

        card.addEventListener("mouseenter", () => {
          if (unhoverTimer) {
            clearTimeout(unhoverTimer);
            unhoverTimer = null;
          }
        });

        card.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (target.closest("[data-close-card]")) return;
          if (target.closest("a")) return;
          if (target.closest("button")) return;

          const isExpanded = slot.getAttribute("data-is-expanded") === "true";
          if (!isExpanded) {
            expandSlot(slot);
          }
        });

        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            const target = e.target as HTMLElement;
            if (target.closest("[data-close-card]")) return;
            if (target.closest("a")) return;
            if (target.closest("button")) return;
            e.preventDefault();
            const isExpanded = slot.getAttribute("data-is-expanded") === "true";
            if (!isExpanded) {
              expandSlot(slot);
            }
          }
        });
      }

      closeButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          if (unhoverTimer) {
            clearTimeout(unhoverTimer);
            unhoverTimer = null;
          }
          collapseSlot(slot);
        });
      });
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        slots.forEach((slot) => {
          if (slot.getAttribute("data-is-expanded") === "true") {
            collapseSlot(slot);
          }
        });
      }
    });

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (
        !target.closest("[data-project-slot]") &&
        !target.closest(".tile-modal")
      ) {
        slots.forEach((slot) => {
          if (slot.getAttribute("data-is-expanded") === "true") {
            collapseSlot(slot);
          }
        });
      }
    });
  }

  function initOthersSection() {
    setupOthersHorizontalScroll();
    setupMorphingCards();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initOthersSection);
  } else {
    initOthersSection();
  }
  document.addEventListener("astro:page-load", initOthersSection);
</script>
