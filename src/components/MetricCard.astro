---
interface Props {
  label: string;
  value: string;
  subtext?: string;
  badge?: string;
  badgeVariant?: 'accent' | 'neutral' | 'warning' | 'danger' | 'info';
  trend?: string;
  accent?: boolean;
  class?: string;
  [key: string]: any;
}

import StatusBadge from './StatusBadge.astro';

const {
  label,
  value,
  subtext,
  badge,
  badgeVariant = 'accent',
  trend,
  accent = false,
  class: className = '',
  ...rest
} = Astro.props;
---

<div
  role="group"
  aria-label={`${label}: ${value}${subtext ? ` (${subtext})` : ''}`}
  class:list={[
    'relative flex flex-col justify-between p-5 sm:p-6 bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300/80 dark:border-neutral-800 transition-[transform,background-color,color,border-color,opacity,box-shadow] duration-200 hover:border-neutral-400 dark:hover:border-neutral-600',
    accent ? 'border-[var(--color-accent,#52FF1A)]/50 shadow-[0_0_20px_color-mix(in_srgb,var(--color-accent,#52FF1A)_20%,transparent)]' : '',
    className
  ]}
  {...rest}
>
  <!-- Top Row: Label + Optional Badge/Trend -->
  <div class="flex items-center justify-between gap-3 pb-3 border-b border-neutral-200/80 dark:border-neutral-800/80">
    <span class="font-sans text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold truncate">
      {label}
    </span>
    {badge && (
      <StatusBadge variant={badgeVariant} size="sm">{badge}</StatusBadge>
    )}
    {trend && !badge && (
      <span class="font-sans text-xs font-bold text-[var(--color-accent,#52FF1A)] bg-[var(--color-accent,#52FF1A)]/10 px-2 py-0.5 rounded">
        {trend}
      </span>
    )}
  </div>

  <!-- Middle: Bold Syne Metric Value -->
  <div class="py-4">
    <div
      class="text-3xl sm:text-4xl lg:text-5xl font-black text-neutral-950 dark:text-white tracking-tight leading-none font-heading"
    >
      {value}
    </div>
  </div>

  <!-- Bottom: Subtext -->
  {subtext && (
    <div class="pt-3 border-t border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-between">
      <span class="font-sans text-xs text-neutral-600 dark:text-neutral-400 leading-snug">
        {subtext}
      </span>
    </div>
  )}
</div>
