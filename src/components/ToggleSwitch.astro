---
// ToggleSwitch.astro - 1:1 Vendor Portal Architecture
interface Props {
  id?: string;
  name?: string;
  value?: string;
  label?: string;
  description?: string;
  checked?: boolean;
  disabled?: boolean;
  loading?: boolean;
  loadingDelay?: number;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: any;
}

const {
  id = `toggle-${Math.random().toString(36).substring(2, 9)}`,
  name,
  value,
  label,
  description,
  checked = false,
  disabled = false,
  loading = false,
  loadingDelay = 0,
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const sizeTrackClass = size === 'sm' ? 'w-9 h-[18px] rounded-[4px]' : size === 'lg' ? 'w-[52px] h-[26px] rounded-[8px]' : 'w-11 h-[22px] rounded-[5px]';
---

<label
  for={id}
  class:list={[
    "toggle-wrapper group inline-flex items-start gap-3 select-none transition-opacity",
    disabled ? "opacity-60 cursor-not-allowed pointer-events-none" : "cursor-pointer",
    loading ? "is-loading is-expanding" : "",
    className
  ]}
  data-state={checked ? "checked" : "unchecked"}
  data-loading-delay={loadingDelay > 0 ? loadingDelay : undefined}
>
  <div class="relative flex items-center justify-center shrink-0 mt-0.5">
    <input
      type="checkbox"
      id={id}
      name={name}
      value={value}
      checked={checked ? true : undefined}
      disabled={disabled || loading ? true : undefined}
      class="peer sr-only toggle-input"
      {...rest}
    />
    
    <!-- Outer Track Wrapper -->
    <div class="relative inline-flex items-center justify-center">
      <!-- Spinning Conic Border Overlay (Exact size) -->
      <div class:list={[
        "toggle-border-spinner absolute -inset-[1.5px] rounded-[6.5px] pointer-events-none overflow-hidden z-30",
        loading ? "!block" : "hidden"
      ]}>
        <div class="w-[200%] h-[200%] absolute -top-1/2 -left-1/2 bg-[conic-gradient(from_0deg,var(--color-accent,#52FF1A)_0%,transparent_50%,var(--color-accent,#52FF1A)_100%)] animate-spin"></div>
        <div class="spinner-mask absolute inset-[1.5px] rounded-[5px]"></div>
      </div>

      <!-- Vendor Portal Pill Track Container -->
      <div
        class:list={[
          "toggle-track relative flex items-center shrink-0 overflow-hidden box-border",
          sizeTrackClass
        ]}
      >
        <!-- 60% Width Sliding Block Knob with Smooth Expansion & Slide -->
        <div
          class="toggle-thumb absolute top-0 bottom-0 box-border z-10"
        >
        </div>
      </div>
    </div>
  </div>

  {(label || description) && (
    <div class="flex flex-col text-left leading-tight">
      {label && (
        <span class="font-heading font-bold text-sm sm:text-base text-neutral-950 dark:text-white transition-colors">
          {label}
        </span>
      )}
      {description && (
        <span class="text-xs sm:text-[13px] text-neutral-500 dark:text-neutral-400 mt-1 font-sans font-normal leading-normal">
          {description}
        </span>
      )}
    </div>
  )}
</label>

<style>
  /* ── High-Contrast Portfolio Theme Architecture ──────────── */

  /* Track Transitions */
  .toggle-track {
    border-width: 1px;
    border-style: solid;
    transition: background-color 0.22s ease-out, border-color 0.22s ease-out;
  }

  /* Thumb Transitions: Always animate width, left, background-color and radius */
  .toggle-thumb {
    top: 0;
    bottom: 0;
    height: 100%;
    transition: left 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                width 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.22s ease-out,
                border-radius 0.22s ease-out;
  }

  /* Default / OFF State */
  .toggle-wrapper[data-state="unchecked"] .toggle-track {
    border-color: #d1d5db;
    background-color: #f3f4f6;
  }
  :global(.dark) .toggle-wrapper[data-state="unchecked"] .toggle-track {
    border-color: #404040;
    background-color: #141414;
  }

  .toggle-wrapper[data-state="unchecked"] .toggle-thumb {
    left: 0;
    width: 60%;
    background-color: #ffffff;
    border-radius: 4px 0 0 4px;
    box-shadow: 1px 0 2px rgba(0, 0, 0, 0.05);
  }
  :global(.dark) .toggle-wrapper[data-state="unchecked"] .toggle-thumb {
    background-color: #262626;
    border-radius: 4px 0 0 4px;
    box-shadow: 1px 0 2px rgba(0, 0, 0, 0.2);
  }

  /* ON State (Transparent Track with Accent Border and Solid Accent Sliding Thumb Knob) */
  .toggle-wrapper[data-state="checked"] .toggle-track {
    border-color: var(--color-accent, #52FF1A);
    background-color: transparent;
  }
  :global(.dark) .toggle-wrapper[data-state="checked"] .toggle-track {
    border-color: var(--color-accent, #52FF1A);
    background-color: transparent;
  }

  .toggle-wrapper[data-state="checked"] .toggle-thumb {
    left: 40%;
    width: 60%;
    background-color: var(--color-accent, #52FF1A);
    border-radius: 0 4px 4px 0;
  }
  :global(.dark) .toggle-wrapper[data-state="checked"] .toggle-thumb {
    background-color: var(--color-accent, #52FF1A);
    border-radius: 0 4px 4px 0;
  }

  /* Phase 1: Expanding to 100% Full Track Fill */
  .toggle-wrapper.is-expanding .toggle-thumb {
    left: 0 !important;
    width: 100% !important;
    border-radius: 4px !important;
    box-shadow: none !important;
  }

  /* When expanding while turning ON: fill with accent */
  .toggle-wrapper.is-expanding[data-next-state="checked"] .toggle-thumb {
    background-color: var(--color-accent, #52FF1A) !important;
  }
  .toggle-wrapper.is-expanding[data-next-state="checked"] .toggle-track {
    border-color: var(--color-accent, #52FF1A) !important;
    background-color: transparent !important;
  }

  /* When expanding while turning OFF: fill with neutral */
  .toggle-wrapper.is-expanding[data-next-state="unchecked"] .toggle-thumb {
    background-color: #ffffff !important;
  }
  :global(.dark) .toggle-wrapper.is-expanding[data-next-state="unchecked"] .toggle-thumb {
    background-color: #262626 !important;
  }
  .toggle-wrapper.is-expanding[data-next-state="unchecked"] .toggle-track {
    border-color: #d1d5db !important;
    background-color: #f3f4f6 !important;
  }
  :global(.dark) .toggle-wrapper.is-expanding[data-next-state="unchecked"] .toggle-track {
    border-color: #404040 !important;
    background-color: #141414 !important;
  }

  /* Loading State */
  .toggle-wrapper.is-loading .toggle-border-spinner {
    display: block !important;
  }
  .toggle-wrapper.is-loading .toggle-track {
    border-color: transparent !important;
  }
  .toggle-wrapper.is-loading[data-next-state="checked"] .spinner-mask {
    background-color: var(--color-accent, #52FF1A) !important;
  }
  .toggle-wrapper.is-loading[data-next-state="unchecked"] .spinner-mask {
    background-color: #ffffff !important;
  }
  :global(.dark) .toggle-wrapper.is-loading[data-next-state="unchecked"] .spinner-mask {
    background-color: #262626 !important;
  }
</style>

<script>
  function setupVendorToggles() {
    document.querySelectorAll<HTMLElement>('.toggle-wrapper').forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const input = container.querySelector<HTMLInputElement>('.toggle-input');
      if (!input) return;

      container.addEventListener('click', (e) => {
        if (input.disabled || container.classList.contains('is-expanding') || container.classList.contains('is-loading')) return;
        e.preventDefault();

        const delay = parseInt(container.getAttribute('data-loading-delay') || '0', 10);
        const targetChecked = !input.checked;
        container.setAttribute('data-next-state', targetChecked ? 'checked' : 'unchecked');
        container.classList.add('is-expanding');

        if (delay > 0) {
          container.classList.add('is-loading');
          setTimeout(() => {
            input.checked = targetChecked;
            container.setAttribute('data-state', targetChecked ? 'checked' : 'unchecked');
            container.classList.remove('is-expanding', 'is-loading');
            container.removeAttribute('data-next-state');
            input.dispatchEvent(new Event('change', { bubbles: true }));
          }, delay);
        } else {
          setTimeout(() => {
            input.checked = targetChecked;
            container.setAttribute('data-state', targetChecked ? 'checked' : 'unchecked');
            container.classList.remove('is-expanding');
            container.removeAttribute('data-next-state');
            input.dispatchEvent(new Event('change', { bubbles: true }));
          }, 220);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupVendorToggles);
  } else {
    setupVendorToggles();
  }
  document.addEventListener('astro:page-load', setupVendorToggles);
</script>

