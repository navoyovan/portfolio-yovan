---
// FormSlider.astro - High-Contrast System Slider Primitive with Fluid Dynamic Elastic Track
interface Props {
  id?: string;
  name?: string;
  min?: number;
  max?: number;
  step?: number;
  value?: number;
  label?: string;
  unit?: string;
  description?: string;
  disabled?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  id = `slider-${Math.random().toString(36).substring(2, 9)}`,
  name,
  min = 0,
  max = 100,
  step = 1,
  value = 50,
  label,
  unit = '%',
  description,
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const initialPercent = Math.min(100, Math.max(0, ((value - min) / (max - min)) * 100));
---

<div
  class:list={[
    "slider-container flex flex-col gap-2 select-none w-full",
    disabled ? "opacity-50 cursor-not-allowed pointer-events-none" : "",
    className
  ]}
  data-id={id}
>
  {(label || unit) && (
    <div class="flex items-center justify-between leading-tight">
      {label && (
        <label for={id} class="font-heading font-bold text-neutral-950 dark:text-white text-sm sm:text-base cursor-pointer">
          {label}
        </label>
      )}
      <span class="slider-val-display font-mono text-xs font-bold text-neutral-900 dark:text-neutral-100 bg-neutral-100 dark:bg-neutral-900 px-2 py-0.5 rounded border border-neutral-300 dark:border-neutral-800">
        {value}{unit}
      </span>
    </div>
  )}

  <div class="relative w-full flex items-center py-3">
    <!-- Custom Track Container with SVG Dynamic Geometry Mesh -->
    <div class="slider-track-wrap relative w-full h-6 flex items-center">
      <svg class="slider-svg absolute inset-0 w-full h-full pointer-events-none overflow-visible" preserveAspectRatio="none">
        <!-- Left Active Line (0 to handleX - pad) - Instant GPU path updates without CSS transition lag -->
        <path class="slider-active-path fill-[var(--color-accent,#52FF1A)]" d="" />
        <!-- Right Inactive Line (handleX + pad to width) -->
        <path class="slider-inactive-path fill-neutral-200 dark:fill-neutral-800" d="" />
      </svg>
    </div>

    <!-- Native Range Input (Fully Interactive with Custom Thumb Overlay) -->
    <input
      type="range"
      id={id}
      name={name}
      min={min}
      max={max}
      step={step}
      value={value}
      data-unit={unit}
      disabled={disabled ? true : undefined}
      class="slider-input absolute inset-0 w-full opacity-0 cursor-pointer z-20 h-full m-0 p-0"
      {...rest}
    />

    <!-- Vertical Bar Handle | (5px width, 24px height, high-contrast Accent) -->
    <div
      class="slider-handle pointer-events-none absolute w-[5px] h-[24px] -ml-[2.5px] rounded-none bg-[var(--color-accent,#52FF1A)] shadow-none z-10 transition-[transform,box-shadow] duration-150 ease-out"
      style={`left: ${initialPercent}%;`}
    >
      <div class="w-full h-full bg-neutral-950 dark:bg-white opacity-25"></div>
    </div>
  </div>

  {description && (
    <span class="text-xs text-neutral-500 dark:text-neutral-400 font-sans font-normal leading-normal">
      {description}
    </span>
  )}
</div>

<style>
  .slider-container,
  .slider-track-wrap,
  .slider-input {
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  /* Ensure input thumb spans full touch target area */
  .slider-input::-webkit-slider-thumb {
    width: 32px;
    height: 32px;
    cursor: grab;
    -webkit-appearance: none;
    appearance: none;
  }
  .slider-input::-moz-range-thumb {
    width: 32px;
    height: 32px;
    cursor: grab;
    border: none;
  }
  .slider-input:active::-webkit-slider-thumb {
    cursor: grabbing;
  }
  .slider-input:active::-moz-range-thumb {
    cursor: grabbing;
  }

  /* Handle active drag expansion */
  .slider-container.is-dragging .slider-handle {
    transform: scaleY(1.25) scaleX(1.2);
    box-shadow: 0 0 16px color-mix(in srgb, var(--color-accent, var(--accent-color, #52FF1A)) 80%, transparent),
                0 0 6px var(--color-accent, var(--accent-color, #52FF1A));
  }
</style>

<script>
  function setupSliders() {
    document.querySelectorAll<HTMLElement>('.slider-container').forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const input = container.querySelector<HTMLInputElement>('.slider-input');
      const activePath = container.querySelector<SVGPathElement>('.slider-active-path');
      const inactivePath = container.querySelector<SVGPathElement>('.slider-inactive-path');
      const handle = container.querySelector<HTMLElement>('.slider-handle');
      const display = container.querySelector<HTMLElement>('.slider-val-display');
      const trackWrap = container.querySelector<HTMLElement>('.slider-track-wrap');
      if (!input || !activePath || !inactivePath || !handle || !trackWrap) return;

      const unit = input.getAttribute('data-unit') || '%';
      const min = parseFloat(input.min) || 0;
      const max = parseFloat(input.max) || 100;
      const rangeSpan = Math.max(max - min, 1);
      const maxTravelSpan = rangeSpan * 0.22; // Reach maximum stretch within 22% slider travel

      let isDragging = false;
      let dragStartVal = parseFloat(input.value);
      
      // Dynamic deformation state continuously derived from drag displacement
      let waveAmp = 0;          // animated wave amplitude (px)
      let thinRatio = 0;        // animated thinning ratio (0..1)
      let pullDirection: 'right' | 'left' | null = null;
      
      let releaseRafId: number | null = null;

      // Uniform sinusoidal wave ribbon across any horizontal span
      const buildUniformSineWavePath = (
        startX: number,
        endX: number,
        midY: number,
        ribbonHalfThickness: number,
        uniformWaveAmp: number,
        waveLen: number
      ) => {
        if (endX <= startX) return '';
        if (uniformWaveAmp <= 0.1) {
          return `M ${startX} ${midY - ribbonHalfThickness} L ${endX} ${midY - ribbonHalfThickness} L ${endX} ${midY + ribbonHalfThickness} L ${startX} ${midY + ribbonHalfThickness} Z`;
        }
        const len = endX - startX;
        const steps = Math.max(16, Math.floor(len / 4));
        const stepSize = len / steps;
        const topPoints: string[] = [];
        const bottomPoints: string[] = [];

        for (let i = 0; i <= steps; i++) {
          const x = startX + i * stepSize;
          const waveOffset = Math.sin((x / waveLen) * Math.PI * 2) * uniformWaveAmp;
          const yTop = midY + waveOffset - ribbonHalfThickness;
          const yBottom = midY + waveOffset + ribbonHalfThickness;
          topPoints.push(`${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${yTop.toFixed(1)}`);
          bottomPoints.unshift(`L ${x.toFixed(1)} ${yBottom.toFixed(1)}`);
        }
        return `${topPoints.join(' ')} ${bottomPoints.join(' ')} Z`;
      };

      const render = () => {
        const val = parseFloat(input.value);
        const percent = Math.min(100, Math.max(0, ((val - min) / rangeSpan) * 100));

        handle.style.left = `${percent}%`;
        if (display) {
          display.textContent = `${val}${unit}`;
        }

        const width = trackWrap.clientWidth || 300;
        const height = trackWrap.clientHeight || 24;
        const midY = height / 2;
        const handleX = (percent / 100) * width;

        const normalHalfH = 3.0; // 6.0px normal resting track thickness
        const minHalfH = 0.5;    // Exactly 1.0px total minimum thickness when fully stretched (0.5px * 2)
        const handlePad = 6;     // 6px padding around the vertical bar

        const leftEndX = Math.max(0, handleX - handlePad);
        const rightStartX = Math.min(width, handleX + handlePad);

        if (pullDirection === 'right' && (waveAmp > 0.05 || thinRatio > 0.01)) {
          // Dragged right from start point: left side stretches down to 0.8px minimum, right side waves
          const leftHalfH = normalHalfH - thinRatio * (normalHalfH - minHalfH);
          const waveLen = Math.max(22, 44 - (waveAmp / 7.5) * 20);
          const ribbonThickness = 1.8;

          const dActive = leftEndX > 0 ? `M 0 ${midY - leftHalfH} L ${leftEndX} ${midY - leftHalfH} L ${leftEndX} ${midY + leftHalfH} L 0 ${midY + leftHalfH} Z` : '';
          activePath.setAttribute('d', dActive);

          const dInactive = rightStartX < width ? buildUniformSineWavePath(rightStartX, width, midY, ribbonThickness, waveAmp, waveLen) : '';
          inactivePath.setAttribute('d', dInactive);

        } else if (pullDirection === 'left' && (waveAmp > 0.05 || thinRatio > 0.01)) {
          // Dragged left from start point: right side stretches down to 0.8px minimum, left side waves
          const rightHalfH = normalHalfH - thinRatio * (normalHalfH - minHalfH);
          const waveLen = Math.max(22, 44 - (waveAmp / 7.5) * 20);
          const ribbonThickness = 1.8;

          const dActive = leftEndX > 0 ? buildUniformSineWavePath(0, leftEndX, midY, ribbonThickness, waveAmp, waveLen) : '';
          activePath.setAttribute('d', dActive);

          const dInactive = rightStartX < width ? `M ${rightStartX} ${midY - rightHalfH} L ${width} ${midY - rightHalfH} L ${width} ${midY + rightHalfH} L ${rightStartX} ${midY + rightHalfH} Z` : '';
          inactivePath.setAttribute('d', dInactive);

        } else {
          // Flat resting track (6.0px total thickness)
          const dActive = leftEndX > 0 ? `M 0 ${midY - normalHalfH} L ${leftEndX} ${midY - normalHalfH} L ${leftEndX} ${midY + normalHalfH} L 0 ${midY + normalHalfH} Z` : '';
          activePath.setAttribute('d', dActive);

          const dInactive = rightStartX < width ? `M ${rightStartX} ${midY - normalHalfH} L ${width} ${midY - normalHalfH} L ${width} ${midY + normalHalfH} L ${rightStartX} ${midY + normalHalfH} Z` : '';
          inactivePath.setAttribute('d', dInactive);
        }
      };

      const startDrag = () => {
        if (releaseRafId !== null) {
          cancelAnimationFrame(releaseRafId);
          releaseRafId = null;
        }
        isDragging = true;
        container.classList.add('is-dragging');
        dragStartVal = parseFloat(input.value);
      };

      const endDrag = () => {
        if (!isDragging) return;
        isDragging = false;
        container.classList.remove('is-dragging');

        if (releaseRafId !== null) {
          cancelAnimationFrame(releaseRafId);
        }

        // On release: smoothly snap the active deformation back to resting 0
        const animateRelease = () => {
          waveAmp *= 0.80;
          thinRatio *= 0.80;

          if (waveAmp < 0.05 && thinRatio < 0.01) {
            waveAmp = 0;
            thinRatio = 0;
            pullDirection = null;
            releaseRafId = null;
            render();
            return;
          }

          render();
          releaseRafId = requestAnimationFrame(animateRelease);
        };

        releaseRafId = requestAnimationFrame(animateRelease);
      };

      // Input event listener - deformation directly scales with displacement from drag start position
      input.addEventListener('input', () => {
        const currentVal = parseFloat(input.value);
        if (!isDragging) {
          startDrag();
        }

        const displacement = currentVal - dragStartVal;
        const normalizedDisplacement = Math.min(1, Math.max(-1, displacement / maxTravelSpan));
        const absRatio = Math.abs(normalizedDisplacement);

        if (displacement > 0) {
          pullDirection = 'right';
        } else if (displacement < 0) {
          pullDirection = 'left';
        } else {
          pullDirection = null;
        }

        // Reaches full 7.5px wave amp and 100% thinning (0.8px line) smoothly
        waveAmp = absRatio * 7.5;
        thinRatio = absRatio * 1.0;

        render();
      });

      // Pointer & touch events
      input.addEventListener('pointerdown', startDrag);
      window.addEventListener('pointerup', endDrag);
      window.addEventListener('pointercancel', endDrag);

      input.addEventListener('touchstart', startDrag, { passive: true });
      window.addEventListener('touchend', endDrag, { passive: true });
      window.addEventListener('touchcancel', endDrag, { passive: true });

      input.addEventListener('change', endDrag);
      window.addEventListener('resize', render);

      // Initial layout render
      render();
    });
  }

  // Setup on initial page load and Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSliders);
  } else {
    setupSliders();
  }
  document.addEventListener('astro:page-load', setupSliders);
</script>
