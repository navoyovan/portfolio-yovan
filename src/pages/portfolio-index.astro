---
import RootLayout from '../layouts/RootLayout.astro';

interface IndexItem {
  title: string;
  year: string;
  tech: string[];
  href?: string;
}

interface CategoryGroup {
  number: string;
  title: string;
  items: IndexItem[];
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const categories: CategoryGroup[] = [
  {
    number: '01',
    title: 'HYPE-BOX ECOSYSTEM',
    items: [
      {
        title: 'HYPE-BOX Landing Page',
        year: '2026',
        tech: ['Astro', 'Tailwind CSS v4'],
        href: 'https://navoyovan.github.io/hypebox/',
      },
      {
        title: 'Photobooth Kiosk',
        year: '2026',
        tech: ['Electron', 'React 19', 'Anime.js', 'Vite'],
      },
      {
        title: 'Photobooth Kiosk Demo',
        year: '2026',
        tech: ['React 19', 'Anime.js', 'Vite'],
        href: 'https://navoyovan.github.io/photobooth-kiosk-demo/',
      },
      {
        title: 'Photobooth Vendor Portal',
        year: '2026',
        tech: ['React 19', 'Vite', 'CSS Modules', 'Anime.js'],
      },
      {
        title: 'Photobooth REST & WebSocket API',
        year: '2026',
        tech: ['Laravel 13', 'Reverb', 'Google Cloud Storage', 'Google Cloud Platform'],
      },
    ],
  },
  {
    number: '02',
    title: 'OTHER SYSTEMS',
    items: [
      {
        title: 'Component Library & Design Tokens',
        year: '2026',
        tech: ['Astro v5', 'Tailwind CSS v4', 'Design Tokens'],
        href: `${base}/component-library`,
      },
      {
        title: 'Interactive Mapping System',
        year: '2025',
        tech: ['Laravel', 'Leaflet.js', 'AJAX', 'Tailwind'],
        href: 'https://github.com/navoyovan/interactive-map',
      },
    ],
  },
];
const siteUrl = Astro.site?.toString() || 'https://navoyovan.github.io/portfolio-yovan';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Portfolio Index | Systems & Project Directory',
  description: 'A structured directory of production software architectures, standalone kiosk operating systems, real-time WebSocket backends, and full-stack systems.',
  url: `${siteUrl}/portfolio-index`,
  author: {
    '@type': 'Person',
    name: 'Yovan Gunardio Darmawan',
  },
};
---

<RootLayout
  title="Portfolio Index | Systems & Project Directory"
  description="A structured directory of production software architectures, standalone kiosk operating systems, real-time WebSocket backends, and full-stack systems."
  keywords={[
    'Portfolio Index',
    'Software Architecture Directory',
    'HYPE-BOX Ecosystem',
    'Touchscreen Kiosk OS',
    'Photobooth Platform',
    'Laravel Backend',
    'Electron Applications',
    'React 19',
  ]}
  schema={collectionSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-14">
    <!-- Header -->
    <div id="portfolio-header" class="border-b border-neutral-200 dark:border-neutral-800 pb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white">
        Portfolio Index
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl font-normal">
        A structured catalog of production software architectures, standalone kiosk operating systems, and performance-first web platforms.
      </p>
    </div>

    <!-- Tree Index by Category -->
    <div class="space-y-12">
      {categories.map((category) => (
        <section
          id={category.number === '01' ? 'hypebox-ecosystem' : 'other-systems'}
          aria-labelledby={`cat-heading-${category.number}`}
          class="space-y-4 scroll-mt-24"
        >
          <!-- Parent Category Header -->
          <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
            <h2
              id={`cat-heading-${category.number}`}
              class="text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-bold font-heading"
            >
              {category.number} // {category.title}
            </h2>
            <span class="text-xs font-medium text-neutral-400 dark:text-neutral-500 font-sans">
              {category.items.length} {category.items.length === 1 ? 'entry' : 'entries'}
            </span>
          </div>

          <!-- Terminal Tree Feed Container -->
          <div class="border border-neutral-300/80 dark:border-neutral-800 bg-[#f6f4ee] dark:bg-[#141414] p-5 sm:p-7 space-y-7 rounded-md">
            {category.number === '01' && (
              <div class="flex items-center gap-3 pb-4 border-b border-neutral-200/80 dark:border-neutral-800/80">
                <div
                  class="text-xl sm:text-2xl font-black tracking-tight text-neutral-950 dark:text-white leading-none select-none font-heading"
                >
                  HYPE-BOX
                </div>
                <span class="text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 font-semibold pl-3 border-l border-neutral-300 dark:border-neutral-700 font-sans">
                  ECOSYSTEM PLATFORM
                </span>
              </div>
            )}

            {category.items.map((item, idx) => {
              const isLast = idx === category.items.length - 1;
              const branchSymbol = isLast ? '└──' : '├──';
              return (
                <div class="space-y-1.5 group min-w-0">
                  <!-- Top Row: Tree Branch + Year + Title -->
                  <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                    <span class="text-neutral-400 dark:text-neutral-600 select-none font-sans font-medium text-sm shrink-0" aria-hidden="true">
                      {branchSymbol}
                    </span>
                    <span class="text-xs text-neutral-500 font-semibold font-sans shrink-0">
                      {item.year}
                    </span>

                    <!-- Title Marquee Container (Loops on Overflow) -->
                    <div class="index-marquee-wrapper relative overflow-hidden min-w-0 flex-1">
                      <div class="index-marquee-track inline-flex items-center">
                        <div class="index-marquee-content inline-flex items-center shrink-0">
                          <h3
                            class="text-sm sm:text-base text-neutral-950 dark:text-white group-hover:text-[var(--color-accent,#52FF1A)] transition-colors font-heading font-bold whitespace-nowrap m-0 inline-flex items-center"
                          >
                            {item.href ? (
                              <a
                                href={item.href}
                                target={item.href.startsWith('http') ? '_blank' : undefined}
                                rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                                aria-label={item.href.startsWith('http') ? `${item.title} (opens in new tab)` : undefined}
                                class="hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded px-0.5 inline-flex items-center gap-1.5"
                              >
                                <span>{item.title}</span>
                                <span class="opacity-30 group-hover:opacity-100 transition-all duration-150 text-neutral-500 dark:text-neutral-400 group-hover:!text-[var(--color-accent,#52FF1A)]">
                                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M17 7l-10 10" />
                                    <path d="M8 7l9 0l0 9" />
                                  </svg>
                                </span>
                              </a>
                            ) : (
                              <span>{item.title}</span>
                            )}
                            <span class="title-dot-trailing text-neutral-400 dark:text-neutral-600 select-none text-xs mx-3" aria-hidden="true">
                              •
                            </span>
                          </h3>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Sub Row: Nested Stack Line (Loops on Overflow) -->
                  <div class="pl-7 sm:pl-8 text-[11px] text-neutral-400 dark:text-neutral-500 flex items-center min-w-0 font-sans">
                    <span class="text-neutral-300 dark:text-neutral-700 select-none shrink-0 mr-2" aria-hidden="true">└──</span>
                    <span class="text-neutral-400 dark:text-neutral-600 font-medium shrink-0 mr-1.5">stack:</span>

                    <div class="index-marquee-wrapper relative overflow-hidden min-w-0 flex-1">
                      <div class="index-marquee-track inline-flex items-center">
                        <div class="index-marquee-content inline-flex items-center text-neutral-500 dark:text-neutral-400 whitespace-nowrap shrink-0">
                          {item.tech.map((techItem, tIdx) => (
                            <span class="inline-flex items-center">
                              <span>{techItem}</span>
                              <span
                                class:list={[
                                  "text-neutral-300 dark:text-neutral-700 select-none text-[8px] mx-2",
                                  tIdx === item.tech.length - 1 ? "stack-dot-trailing" : ""
                                ]}
                                aria-hidden="true"
                              >
                                •
                              </span>
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</RootLayout>

<style is:global>
  @keyframes marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .index-marquee-wrapper:not(.is-overflowing) .stack-dot-trailing,
  .index-marquee-wrapper:not(.is-overflowing) .title-dot-trailing {
    display: none !important;
  }

  .index-marquee-wrapper.is-overflowing {
    -webkit-mask-image: linear-gradient(to right, black calc(100% - 36px), transparent 100%);
    mask-image: linear-gradient(to right, black calc(100% - 36px), transparent 100%);
  }

  .index-marquee-track {
    display: inline-flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  .index-marquee-wrapper:hover .index-marquee-track,
  .group:hover .index-marquee-track,
  .index-marquee-wrapper:focus-within .index-marquee-track {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .index-marquee-track {
      animation: none !important;
      transform: none !important;
    }
    .index-marquee-wrapper {
      overflow-x: auto !important;
      mask-image: none !important;
      -webkit-mask-image: none !important;
    }
  }
</style>

<script>
  const initIndexMarquees = () => {
    const wrappers = document.querySelectorAll<HTMLElement>('.index-marquee-wrapper');
    wrappers.forEach((wrapper) => {
      const track = wrapper.querySelector<HTMLElement>('.index-marquee-track');
      const content = wrapper.querySelector<HTMLElement>('.index-marquee-content');
      if (!track || !content) return;

      const wrapperWidth = wrapper.clientWidth;
      if (wrapperWidth === 0) return;

      // Reset styles for clean measurement
      const existingClone = track.querySelector('.index-marquee-clone');
      if (existingClone) {
        existingClone.remove();
      }
      wrapper.classList.remove('is-overflowing');
      track.style.animation = 'none';

      // Measure natural width (trailing dot is hidden when not overflowing)
      const naturalWidth = content.scrollWidth;

      if (naturalWidth > wrapperWidth + 2) {
        // Enable overflowing mode (which reveals trailing dot divider)
        wrapper.classList.add('is-overflowing');

        // Clone with trailing dot included
        const clone = content.cloneNode(true) as HTMLElement;
        clone.classList.add('index-marquee-clone');
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);

        // Measured unit width includes all items and the trailing divider dot
        const unitWidth = content.scrollWidth;
        // Consistent calm reading pace (~26px/s)
        const duration = Math.max(12, unitWidth / 26);

        track.style.animationName = 'marquee-scroll';
        track.style.animationDuration = `${duration}s`;
        track.style.animationTimingFunction = 'linear';
        track.style.animationIterationCount = 'infinite';
      }
    });
  };

  let lastWidth = typeof window !== 'undefined' ? window.innerWidth : 0;
  let resizeTimer: number | null = null;
  const onResize = () => {
    if (window.innerWidth === lastWidth) return;
    lastWidth = window.innerWidth;
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(initIndexMarquees, 150);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initIndexMarquees);
  } else {
    initIndexMarquees();
  }

  window.addEventListener('resize', onResize, { passive: true });
  document.addEventListener('astro:page-load', initIndexMarquees);
</script>
