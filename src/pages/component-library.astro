<script>
  const setupComponentLibraryNav = () => {
    const navButtons = document.querySelectorAll<HTMLButtonElement>(
      ".sidebar-nav-btn, .tab-nav-btn",
    );
    if (navButtons.length === 0) return;

    navButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: "smooth" });
          history.replaceState(null, "", `#${targetId}`);
        }
      });
    });

    const sectionIds = [
      "colors",
      "depth-cards",
      "buttons",
      "forms",
      "text-inputs",
      "dropdowns",
      "loaders",
      "typography",
      "status-badges",
      "metric-cards",
      "project-tiles",
      "tree-index",
      "app-window",
      "system-topology",
    ];

    const updateActiveTab = (activeId: string) => {
      navButtons.forEach((btn) => {
        const targetId = btn.getAttribute("data-target");
        const isActive = targetId === activeId;
        if (btn.classList.contains("sidebar-nav-btn")) {
          if (isActive) {
            btn.classList.add(
              "bg-neutral-900",
              "dark:bg-white",
              "text-white",
              "dark:text-neutral-950",
              "font-bold",
            );
            btn.classList.remove("text-neutral-600", "dark:text-neutral-400");
          } else {
            btn.classList.remove(
              "bg-neutral-900",
              "dark:bg-white",
              "text-white",
              "dark:text-neutral-950",
              "font-bold",
            );
            btn.classList.add("text-neutral-600", "dark:text-neutral-400");
          }
        } else {
          // mobile tab
          if (isActive) {
            btn.classList.add(
              "bg-neutral-900",
              "dark:bg-white",
              "text-white",
              "dark:text-neutral-950",
              "font-bold",
            );
            btn.classList.remove(
              "bg-neutral-100",
              "dark:bg-neutral-900",
              "text-neutral-600",
              "dark:text-neutral-400",
            );
            // Auto-scroll the mobile tab bar so active tab scrolls smoothly into view
            btn.scrollIntoView({
              behavior: "smooth",
              inline: "center",
              block: "nearest",
            });
          } else {
            btn.classList.remove(
              "bg-neutral-900",
              "dark:bg-white",
              "text-white",
              "dark:text-neutral-950",
              "font-bold",
            );
            btn.classList.add(
              "bg-neutral-100",
              "dark:bg-neutral-900",
              "text-neutral-600",
              "dark:text-neutral-400",
            );
          }
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            updateActiveTab(entry.target.id);
          }
        });
      },
      {
        rootMargin: "-10% 0px -70% 0px",
        threshold: 0,
      },
    );

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  };

  setupComponentLibraryNav();
  document.addEventListener("astro:page-load", setupComponentLibraryNav);
</script>
