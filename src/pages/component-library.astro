---
import RootLayout from "../layouts/RootLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import DepthCard from "../components/DepthCard.astro";
import Checkbox from "../components/Checkbox.astro";
import RadioButton from "../components/RadioButton.astro";
import ToggleSwitch from "../components/ToggleSwitch.astro";
import FormSlider from "../components/FormSlider.astro";
import TextInput from "../components/TextInput.astro";
import LimitTextarea from "../components/LimitTextarea.astro";
import PasswordInput from "../components/PasswordInput.astro";
import FormSelect from "../components/FormSelect.astro";
import SearchDropdown from "../components/SearchDropdown.astro";
import DatePicker from "../components/DatePicker.astro";
import SquareWaveLoader from "../components/SquareWaveLoader.astro";
import StatusBadge from "../components/StatusBadge.astro";
import MetricCard from "../components/MetricCard.astro";
import ProjectTile from "../components/ProjectTile.astro";
import AppWindow from "../components/AppWindow.astro";
import SystemTopology from "../components/SystemTopology.astro";

const primitivesNav = [
  { id: "colors", label: "Color Tokens" },
  { id: "depth-cards", label: "Spatial Depth Cards" },
  { id: "buttons", label: "Buttons & Micro" },
  { id: "forms", label: "Forms & Selection" },
  { id: "text-inputs", label: "Text Inputs" },
  { id: "dropdowns", label: "Dropdowns & Date Picker" },
  { id: "loaders", label: "Loaders" },
  { id: "typography", label: "Typography Hierarchy" },
  { id: "status-badges", label: "Status Badges" },
  { id: "metric-cards", label: "Metric Cards" },
];

const systemNav = [
  { id: "project-tiles", label: "Project Tiles" },
  { id: "tree-index", label: "Directory Tree Index" },
  { id: "app-window", label: "App Window Mockup" },
  { id: "system-topology", label: "System Topology" },
];
---

<RootLayout
  title="Component Library | Editorial & Systems UI Primitives"
  description="Design system, typography specimens, color tokens, and UI primitives architected for Portfolio v5."
  noindex={true}
>
  <div class="w-full flex min-h-[calc(100vh-4rem)]">
    <!-- Outer Sidebar Nav (Sticky, Outside Main Content) -->
    <aside
      class="hidden xl:block w-64 shrink-0 border-r border-neutral-200/80 dark:border-neutral-800/80 py-8 px-0 sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto"
    >
      <nav class="space-y-6">
        <!-- 01 // CORE PRIMITIVES -->
        <div class="space-y-2">
          <div
            class="px-5 pb-1.5 border-b border-neutral-200/80 dark:border-neutral-800/80"
          >
            <span
              class="font-mono text-[11px] font-bold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider"
            >
              01 // CORE PRIMITIVES
            </span>
          </div>
          <ul class="space-y-0.5 list-none p-0 m-0">
            {
              primitivesNav.map((item) => (
                <li>
                  <button
                    type="button"
                    data-target={item.id}
                    class="sidebar-nav-btn group w-full flex items-center justify-between px-5 py-2 text-xs font-mono text-left rounded-none text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
                  >
                    <span class="inline-block transition-transform duration-150 ease-out group-hover:translate-x-1.5">
                      {item.label}
                    </span>
                    <span class="text-[10px] text-neutral-400 dark:text-neutral-600 opacity-0 group-hover:opacity-100 transition-opacity">
                      →
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- 02 // SYSTEM COMPONENTS -->
        <div class="space-y-2">
          <div
            class="px-5 pb-1.5 border-b border-neutral-200/80 dark:border-neutral-800/80"
          >
            <span
              class="font-mono text-[11px] font-bold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider"
            >
              02 // SYSTEM COMPONENTS
            </span>
          </div>
          <ul class="space-y-0.5 list-none p-0 m-0">
            {
              systemNav.map((item) => (
                <li>
                  <button
                    type="button"
                    data-target={item.id}
                    class="sidebar-nav-btn group w-full flex items-center justify-between px-5 py-2 text-xs font-mono text-left rounded-none text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
                  >
                    <span class="inline-block transition-transform duration-150 ease-out group-hover:translate-x-1.5">
                      {item.label}
                    </span>
                    <span class="text-[10px] text-neutral-400 dark:text-neutral-600 opacity-0 group-hover:opacity-100 transition-opacity">
                      →
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- 03 // LICENSE -->
        <div
          class="pt-4 px-5 border-t border-neutral-200/80 dark:border-neutral-800/80"
        >
          <span
            class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500"
          >
            CC BY 4.0 / Attribution
          </span>
        </div>
      </nav>
    </aside>

    <!-- Main Content Container -->
    <main
      class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 min-w-0"
    >
      <!-- Header -->
      <div
        id="library-header"
        class="border-b border-neutral-200 dark:border-neutral-800 pb-6 mb-4 xl:mb-12"
      >
        <h1
          class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white font-heading"
        >
          Component Library
        </h1>
        <p
          class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl font-normal"
        >
          A showcase of typography, color tokens, and interactive UI primitives.
        </p>
      </div>

      <!-- Mobile Sticky Tab Switcher -->
      <div
        id="mobile-tab-switcher"
        class="xl:hidden sticky top-16 z-30 bg-[#fcfbf9]/95 dark:bg-[#0e0e0e]/95 backdrop-blur-md border-b border-neutral-200 dark:border-neutral-800 py-2.5 -mx-4 sm:-mx-6 px-4 sm:px-6 mb-8 overflow-x-auto flex items-center gap-1.5 no-scrollbar"
      >
        <span
          class="text-[10px] font-mono uppercase font-bold text-neutral-400 dark:text-neutral-500 shrink-0 select-none mr-0.5"
          >Primitives:</span
        >
        {
          primitivesNav.map((item) => (
            <button
              type="button"
              data-target={item.id}
              class="tab-nav-btn shrink-0 px-2.5 py-1 text-xs font-mono rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer border border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
            >
              {item.label}
            </button>
          ))
        }
        <div
          class="w-px h-5 bg-neutral-300 dark:bg-neutral-700 my-auto shrink-0 mx-1"
        >
        </div>
        <span
          class="text-[10px] font-mono uppercase font-bold text-neutral-400 dark:text-neutral-500 shrink-0 select-none mr-0.5"
          >Systems:</span
        >
        {
          systemNav.map((item) => (
            <button
              type="button"
              data-target={item.id}
              class="tab-nav-btn shrink-0 px-2.5 py-1 text-xs font-mono rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer border border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
            >
              {item.label}
            </button>
          ))
        }
      </div>

      <!-- Group 1: Core Primitives Container -->
      <div id="core-primitives" class="space-y-16 scroll-mt-24">
        <!-- 01 / Color Tokens -->
        <section id="colors" class="space-y-6 scroll-mt-24">
          <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
            <h2
              class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
            >
              01 / Color Tokens
            </h2>
          </div>
          <!-- 01.0 / Core Brand & Surface Tokens -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
            <!-- Neon Green Accent -->
            <div class="flex flex-col gap-2">
              <div
                class="w-full aspect-video bg-[#52FF1A] border border-black/10 shadow-[0_0_20px_rgba(82,255,26,0.3)]"
              >
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Accent Neon</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >--color-accent • #52FF1A</span
                >
              </div>
            </div>

            <!-- Primary Background -->
            <div class="flex flex-col gap-2">
              <div
                class="w-full aspect-video bg-[#fcfbf9] dark:bg-[#0e0e0e] border border-neutral-300 dark:border-neutral-700"
              >
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Surface Base</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >#fcfbf9 / #0e0e0e</span
                >
              </div>
            </div>

            <!-- Ink Text -->
            <div class="flex flex-col gap-2">
              <div
                class="w-full aspect-video bg-[#1a1a1a] dark:bg-[#e5e5e5] border border-neutral-300 dark:border-neutral-700"
              >
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Text Primary</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >#1a1a1a / #e5e5e5</span
                >
              </div>
            </div>

            <!-- Secondary Surface -->
            <div class="flex flex-col gap-2">
              <div
                class="w-full aspect-video bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300 dark:border-neutral-700"
              >
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Surface Card</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >#f6f4ee / #141414</span
                >
              </div>
            </div>
          </div>

          <!-- 01.1 / Semantic State Tokens (Smaller Paintchips) -->
          <div class="pt-2 space-y-3">
            <div class="flex items-center justify-between">
              <span
                class="font-mono text-xs font-semibold text-neutral-400 uppercase tracking-wider"
                >01.1 / Semantic State Tokens</span
              >
              <span class="font-mono text-[10px] text-neutral-400"
                >Feedback &amp; Status Swatches</span
              >
            </div>

            <div class="grid grid-cols-3 sm:grid-cols-6 gap-4">
              <!-- Safe / Success -->
              <div class="flex flex-col gap-1.5">
                <div
                  class="w-full h-9 sm:h-10 bg-[#10B981] border border-black/10"
                >
                </div>
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Safe</span
                  >
                  <span class="font-mono text-[10px] text-neutral-500"
                    >--color-safe</span
                  >
                </div>
              </div>

              <!-- Warning -->
              <div class="flex flex-col gap-1.5">
                <div
                  class="w-full h-9 sm:h-10 bg-[#F59E0B] border border-black/10"
                >
                </div>
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Warning</span
                  >
                  <span class="font-mono text-[10px] text-neutral-500"
                    >--color-warning</span
                  >
                </div>
              </div>

              <!-- Danger -->
              <div class="flex flex-col gap-1.5">
                <div
                  class="w-full h-9 sm:h-10 bg-[#EF4444] border border-black/10"
                >
                </div>
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Danger</span
                  >
                  <span class="font-mono text-[10px] text-neutral-500"
                    >--color-danger</span
                  >
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 01.5 / Plain Portrait Cards (Spatial Depth & Elevation Tiers) -->
        <section id="depth-cards" class="space-y-8 scroll-mt-24">
          <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
            <h2
              class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
            >
              01.5 / Plain Portrait Cards &amp; Spatial Depth
            </h2>
          </div>

          <div class="space-y-4">
            <div class="flex items-center justify-between pb-1">
              <span
                class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100 uppercase tracking-wider"
              >
                Plain Elevation Cards (3:4 Portrait)
              </span>
              <span class="font-mono text-[10px] text-neutral-400"
                >minimal surface · neutral hover</span
              >
            </div>

            <div
              class="flex flex-nowrap overflow-x-auto gap-4 pb-4 pt-1 -mx-4 px-4 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 lg:grid-cols-5 sm:overflow-visible sm:pb-0 sm:gap-5 no-scrollbar"
            >
              <!-- Tier 0: Dashed Line Outline -->
              <div
                class="flex flex-col gap-2.5 w-[160px] sm:w-auto shrink-0 sm:shrink"
              >
                <DepthCard
                  elevation="dashed"
                  title="LINEA DISIUNCTA"
                  depth="dashed • 0dp"
                />
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Level 00 // Dashed</span
                  >
                  <span class="font-mono text-[11px] text-neutral-500"
                    >elevation="dashed" • 1.5px dashed</span
                  >
                </div>
              </div>

              <!-- Tier 1: Flat / Flush Solid -->
              <div
                class="flex flex-col gap-2.5 w-[160px] sm:w-auto shrink-0 sm:shrink"
              >
                <DepthCard
                  elevation="flat"
                  title="SUPERFICIES PLANA"
                  depth="0dp • z: 0px"
                />
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Level 0 // Planar</span
                  >
                  <span class="font-mono text-[11px] text-neutral-500"
                    >elevation="flat" • solid 1px • 0dp</span
                  >
                </div>
              </div>

              <!-- Tier 2: Low Contact -->
              <div
                class="flex flex-col gap-2.5 w-[160px] sm:w-auto shrink-0 sm:shrink"
              >
                <DepthCard
                  elevation="low"
                  title="ELEVATIO PRIMA"
                  depth="4dp • z: 4px"
                />
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Level 1 // Contact</span
                  >
                  <span class="font-mono text-[11px] text-neutral-500"
                    >elevation="low" • subtle shadow • 4dp</span
                  >
                </div>
              </div>

              <!-- Tier 3: Mid Raised -->
              <div
                class="flex flex-col gap-2.5 w-[160px] sm:w-auto shrink-0 sm:shrink"
              >
                <DepthCard
                  elevation="mid"
                  title="ELEVATIO MEDIA"
                  depth="12dp • z: 12px"
                />
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Level 2 // Raised</span
                  >
                  <span class="font-mono text-[11px] text-neutral-500"
                    >elevation="mid" • ambient depth • 12dp</span
                  >
                </div>
              </div>

              <!-- Tier 4: Floating Atmospheric -->
              <div
                class="flex flex-col gap-2.5 w-[160px] sm:w-auto shrink-0 sm:shrink"
              >
                <DepthCard
                  elevation="floating"
                  title="ELEVATIO SUBLIMIS"
                  depth="32dp • z: 32px"
                />
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Level 3 // Floating</span
                  >
                  <span class="font-mono text-[11px] text-neutral-500"
                    >elevation="floating" • deep shadow • 32dp</span
                  >
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 02 / Buttons & Micro Triggers -->
        <section id="buttons" class="space-y-8 scroll-mt-24">
          <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
            <h2
              class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
            >
              02 / Buttons &amp; Micro Action Triggers
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- CTA Variant -->
            <div class="flex flex-col gap-4">
              <div class="flex flex-col items-start">
                <ActionButton variant="cta">INCIPE SESSIONEM</ActionButton>
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >CTA Pulse</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >variant="cta" • Syne 700</span
                >
              </div>
            </div>

            <!-- Primary Variant -->
            <div class="flex flex-col gap-4">
              <div class="flex flex-col items-start">
                <ActionButton variant="primary"
                  >CONFIRMA ET IMPRIME</ActionButton
                >
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Primary Solid</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >variant="primary" • Syne 700</span
                >
              </div>
            </div>

            <!-- Secondary Variant -->
            <div class="flex flex-col gap-4">
              <div class="flex flex-col items-start">
                <ActionButton variant="secondary"
                  >REDI AD PINACOTHECAM</ActionButton
                >
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Secondary Dashed</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >variant="secondary" • Syne 700</span
                >
              </div>
            </div>
          </div>

          <!-- Micro & Icon Triggers -->
          <div class="pt-2 space-y-4">
            <div class="flex items-center justify-between">
              <span
                class="font-mono text-xs font-semibold text-neutral-400 uppercase tracking-wider"
                >02.1 / Micro &amp; Icon Triggers (size="micro" • 32×32px)</span
              >
              <span class="font-mono text-[10px] text-neutral-400"
                >Tactile Utility Controls</span
              >
            </div>

            <div class="flex flex-wrap items-center gap-6">
              <!-- Primary Micro -->
              <div class="flex items-center gap-2.5">
                <ActionButton
                  variant="primary"
                  size="micro"
                  ariaLabel="Add New Item"
                >
                  <svg
                    class="w-3.5 h-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    ><line x1="12" y1="5" x2="12" y2="19"></line><line
                      x1="5"
                      y1="12"
                      x2="19"
                      y2="12"></line></svg
                  >
                </ActionButton>
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Primary</span
                  >
                  <span class="font-mono text-[10px] text-neutral-500"
                    >size="micro"</span
                  >
                </div>
              </div>

              <!-- CTA Micro -->
              <div class="flex items-center gap-2.5">
                <ActionButton
                  variant="cta"
                  size="micro"
                  ariaLabel="Play Action"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"
                    ><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
                  >
                </ActionButton>
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >CTA</span
                  >
                  <span class="font-mono text-[10px] text-neutral-500"
                    >size="micro"</span
                  >
                </div>
              </div>

              <!-- Secondary Micro -->
              <div class="flex items-center gap-2.5">
                <ActionButton
                  variant="secondary"
                  size="micro"
                  ariaLabel="Edit Record"
                >
                  <svg
                    class="w-3.5 h-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                      d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                    ></path><path
                      d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                    ></path></svg
                  >
                </ActionButton>
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Secondary</span
                  >
                  <span class="font-mono text-[10px] text-neutral-500"
                    >size="micro"</span
                  >
                </div>
              </div>

              <!-- Ghost Micro -->
              <div class="flex items-center gap-2.5">
                <ActionButton variant="ghost" size="micro" ariaLabel="Settings">
                  <svg
                    class="w-3.5 h-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><circle cx="12" cy="12" r="3"></circle><path
