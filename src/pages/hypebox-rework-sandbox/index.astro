  <script>
    const showcase = document.getElementById('hypebox-showcase') as HTMLElement | null;
    // Respect reduced-motion preference for the demo animations
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

    // Starfield warp pulse (consumed by the starfield renderer below)
    let warpFrames = 0;

    // Shared radio/tab group helper: click + arrow-key navigation with roving tabindex
    function bindChoiceGroup(
      group: HTMLElement | null,
      role: 'radio' | 'tab',
      onSelect: (btn: HTMLElement) => void
    ) {
      if (!group) return;
      const attr = role === 'radio' ? 'aria-checked' : 'aria-selected';
      const buttons = Array.from(group.querySelectorAll<HTMLElement>(`[role="${role}"]`));
      const select = (btn: HTMLElement, focus: boolean) => {
        buttons.forEach((b) => {
          const on = b === btn;
          b.setAttribute(attr, String(on));
          b.tabIndex = on ? 0 : -1;
        });
        if (focus) btn.focus();
        onSelect(btn);
      };
      buttons.forEach((btn, i) => {
        btn.tabIndex = btn.getAttribute(attr) === 'true' ? 0 : -1;
        btn.addEventListener('click', () => select(btn, false));
        btn.addEventListener('keydown', (e: KeyboardEvent) => {
          let next = -1;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % buttons.length;
          if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + buttons.length) % buttons.length;
          if (next < 0) return;
          e.preventDefault();
          select(buttons[next], true);
        });
      });
    }

    // ───────────────────────── Demo 1: Photo Session ─────────────────────────
    const sessionCard = document.getElementById('demo-session');
    const viewfinderBtn = document.getElementById('session-viewfinder') as HTMLButtonElement | null;
    const sessionCount = document.getElementById('session-count');
    const sessionFlash = document.getElementById('session-flash');
    const shotEls = Array.from(document.querySelectorAll<HTMLElement>('.session-shot'));
    const TOTAL_SHOTS = 3;
    let sessionRunning = false;

    const setShots = (activeIdx: number | null, done: number) => {
      shotEls.forEach((el, i) => {
        el.dataset.state = i < done ? 'done' : i === activeIdx ? 'active' : 'idle';
      });
    };

    const setSessionRunning = (running: boolean) => {
      sessionRunning = running;
      if (viewfinderBtn) viewfinderBtn.disabled = running;
    };

    async function runSession() {
      if (sessionRunning || !sessionCard || !sessionCount) return;
      setSessionRunning(true);
      sessionCard.dataset.state = 'counting';
      setShots(0, 0);

      for (let shot = 0; shot < TOTAL_SHOTS; shot++) {
        setShots(shot, shot);

        for (let n = 3; n >= 1; n--) {
          sessionCount.textContent = String(n);
          if (!reduceMotion) {
            sessionCount.animate(
              [
                { transform: 'scale(1.25)', opacity: 0 },
                { transform: 'scale(1)', opacity: 0.9 }
              ],
              { duration: 300, easing: 'ease-out', fill: 'forwards' }
            );
          } else {
            sessionCount.style.opacity = '0.9';
          }
          await wait(850);
        }

        sessionCount.textContent = '';
        sessionCount.style.opacity = '0';
        if (sessionFlash && !reduceMotion) {
          sessionFlash.animate([{ opacity: 0.85 }, { opacity: 0 }], { duration: 280, easing: 'ease-out' });
        }
        setShots(null, shot + 1);
        await wait(450);
      }

      sessionCard.dataset.state = 'complete';
      warpFrames = 45;
      setSessionRunning(false);
    }

    viewfinderBtn?.addEventListener('click', runSession);

    // ───────────────────────── Demo 2: Frame Studio ─────────────────────────
    const framePreview = document.getElementById('frame-preview');
    const frameSlots = document.getElementById('frame-slots');

    const frameLayouts: Record<string, { cols: number; rows: number; width: number; label: string }> = {
      strip: { cols: 1, rows: 3, width: 52, label: 'Strip frame preview, 3 photos' },
      grid: { cols: 2, rows: 2, width: 104, label: 'Grid frame preview, 4 photos' },
      single: { cols: 1, rows: 1, width: 104, label: 'Single frame preview, 1 photo' }
    };

    const renderFrame = (key: string) => {
      const layout = frameLayouts[key];
      if (!layout || !frameSlots || !framePreview) return;
      frameSlots.style.gridTemplateColumns = `repeat(${layout.cols}, 1fr)`;
      frameSlots.style.gridTemplateRows = `repeat(${layout.rows}, 1fr)`;
      frameSlots.innerHTML = Array.from({ length: layout.cols * layout.rows })
        .map(() => '<div class="bg-[#121214]"></div>')
        .join('');
      framePreview.style.width = `${layout.width}px`;
      framePreview.setAttribute('aria-label', layout.label);
    };

    renderFrame('strip');
    bindChoiceGroup(document.getElementById('frame-layout-group'), 'radio', (btn) => {
      renderFrame(btn.dataset.layout || 'strip');
    });
    bindChoiceGroup(document.getElementById('frame-accent-group'), 'radio', (btn) => {
      if (btn.dataset.color && showcase) showcase.style.setProperty('--hb-accent', btn.dataset.color);
    });

    const framePanelStudio = document.getElementById('frame-panel-studio');
    const framePanelSelector = document.getElementById('frame-panel-selector');
    bindChoiceGroup(document.getElementById('frame-tabs'), 'tab', (btn) => {
      const tab = btn.dataset.frameTab;
      if (tab === 'studio') {
        framePanelStudio?.classList.remove('hidden');
        framePanelSelector?.classList.add('hidden');
      } else if (tab === 'selector') {
        framePanelStudio?.classList.add('hidden');
        framePanelSelector?.classList.remove('hidden');
      }
    });

    // ───────────────────────── Demo 3: Booth Operations ─────────────────────────
    interface BoothSample {
      name: string;
      online: boolean;
      sessions: number;
      hourly: number[];
      note: string;
    }
    const TARIFF_IDR = 35000;
    const booths: Record<string, BoothSample> = {
      bogor: { name: 'Bogor-HQ', online: true, sessions: 42, hourly: [2, 4, 6, 9, 7, 5, 6, 3], note: '' },
      jakarta: { name: 'Jakarta-01', online: true, sessions: 67, hourly: [4, 7, 10, 14, 12, 9, 7, 4], note: '' },
      bandung: { name: 'Bandung-02', online: false, sessions: 18, hourly: [3, 5, 4, 3, 2, 1, 0, 0], note: 'Last seen 2h ago' }
    };
    const idr = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 });
    const boothPanel = document.getElementById('booth-panel');
    const boothBars = Array.from(document.querySelectorAll<HTMLElement>('.booth-bar'));

    const renderBooth = (key: string) => {
      const booth = booths[key];
      if (!booth || !boothPanel) return;
      boothPanel.dataset.online = String(booth.online);
      boothPanel.setAttribute('aria-labelledby', `booth-tab-${key}`);
      const set = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      set('booth-status', booth.online ? 'Online' : 'Offline');
      set('booth-note', booth.note);
      set('booth-sessions', String(booth.sessions));
      set('booth-revenue', idr.format(booth.sessions * TARIFF_IDR).replace(/\s/g, ''));
      const peak = Math.max(...booth.hourly, 1);
      boothBars.forEach((bar, i) => {
        bar.style.height = `${Math.max(6, Math.round((booth.hourly[i] / peak) * 100))}%`;
      });
    };

    renderBooth('bogor');
    bindChoiceGroup(document.getElementById('booth-tabs'), 'tab', (btn) => {
      renderBooth(btn.dataset.booth || 'bogor');
    });

    // ───────────────────────── Demo 4: Connected Workflow ─────────────────────────
    const workflowSteps = Array.from(document.querySelectorAll<HTMLElement>('.workflow-step'));
    const workflowDesc = document.getElementById('workflow-desc');
    const workflowNext = document.getElementById('workflow-next');
    const workflowCopy = [
      'The kiosk takes a 3-shot burst from the camera.',
      'Shots are composed into the selected frame layout.',
      'The session record is sent to the backend so operators can see it.',
      'The guest receives the finished strip as a print.'
    ];
    let workflowIdx = 0;

    const renderWorkflow = (idx: number) => {
      workflowIdx = idx;
      workflowSteps.forEach((el, i) => {
        el.dataset.state = i < idx ? 'done' : i === idx ? 'active' : 'idle';
        if (i === idx) el.setAttribute('aria-current', 'step');
        else el.removeAttribute('aria-current');
      });
      if (workflowDesc) workflowDesc.textContent = workflowCopy[idx];
      if (workflowNext) workflowNext.textContent = idx === workflowCopy.length - 1 ? 'Replay' : 'Next step';
    };

    workflowSteps.forEach((el, i) => el.addEventListener('click', () => renderWorkflow(i)));
    workflowNext?.addEventListener('click', () => {
      renderWorkflow(workflowIdx === workflowCopy.length - 1 ? 0 : workflowIdx + 1);
    });

    // 6. 3D Wireframe Photostrip Starfield (Ported from Hypebox 00-Idle Starfield.jsx)
    const starfieldCanvas = document.getElementById('wireframe-starfield') as HTMLCanvasElement | null;
    const windowStage = document.getElementById('wireframe-window-stage');

    if (starfieldCanvas && windowStage) {
      const ctx = starfieldCanvas.getContext('2d');
      const numStrips = 16;
      const maxDepth = 1000;
      let focalLength = 200;
      let speed = 1.25;

      interface StripItem {
        x: number;
        y: number;
        z: number;
        baseHeight: number;
        accent: boolean;
      }

      const getSpawnPos = () => {
        let px = 0;
        let py = 0;
        do {
          px = (Math.random() - 0.5) * 1800;
          py = (Math.random() - 0.5) * 1400;
        } while (Math.abs(px) < 340 && Math.abs(py) < 240);
        return { x: px, y: py };
      };

      const strips: StripItem[] = Array.from({ length: numStrips }, (_, idx) => {
        const pos = getSpawnPos();
        return {
          x: pos.x,
          y: pos.y,
          z: Math.random() * maxDepth,
          baseHeight: 340 + Math.random() * 260,
          accent: idx % 5 === 0
        };
      });

      const resizeStarfield = () => {
        const rect = windowStage.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        starfieldCanvas.width = rect.width * dpr;
        starfieldCanvas.height = rect.height * dpr;
        if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      window.addEventListener('resize', resizeStarfield);
      resizeStarfield();

      const drawWireframeStrip = (
        c: CanvasRenderingContext2D,
        w: number,
        h: number,
        alpha: number
      ) => {
        const x0 = -w / 2;
        const y0 = -h / 2;

        c.globalAlpha = alpha;
        c.lineWidth = 1;
        c.strokeStyle = 'rgba(255, 255, 255, 0.22)';
        c.strokeRect(x0, y0, w, h);
      };

      const renderStarfield = () => {
        if (!ctx) return;
        // Save current canvas transform and clear the entire backing buffer completely
        ctx.save();
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, starfieldCanvas.width, starfieldCanvas.height);
        ctx.restore();

        const width = windowStage.clientWidth;
        const height = windowStage.clientHeight;

        // Origin aligned further down with the lower logotype position
        const centerX = width / 2;
        const centerY = height * 0.58;

        if (warpFrames > 0) {
          warpFrames--;
          speed += (3.8 - speed) * 0.15;
          focalLength += (320 - focalLength) * 0.1;
        } else {
          speed += (1.25 - speed) * 0.08;
          focalLength += (200 - focalLength) * 0.08;
        }

        strips.sort((a, b) => b.z - a.z);

        for (const strip of strips) {
          strip.z -= speed;

          if (strip.z <= -90) {
            const pos = getSpawnPos();
            strip.x = pos.x;
            strip.y = pos.y;
            strip.z = maxDepth + (Math.random() * 140 - 40);
            strip.baseHeight = 340 + Math.random() * 260;
          }

          const perspective = focalLength / (focalLength + strip.z);
          const projectedX = centerX + strip.x * perspective;
          const projectedY = centerY + strip.y * perspective;
          const scale = Math.max(0.01, perspective);

          // 2*strip aspect ratio (1 strip = 2:6 [1:3], 2*strip = 4:6 [2:3])
          const scaledHeight = strip.baseHeight * scale;
          const scaledWidth = scaledHeight * (2 / 3);

          let opacity = 0.85;
          if (strip.z > maxDepth - 450) {
            opacity *= (maxDepth - strip.z) / 450;
          }
          if (strip.z < 40) {
            opacity *= Math.max(0, (90 + strip.z) / 130);
          }

          if (
            opacity > 0.01 &&
            projectedX + scaledWidth > 0 &&
            projectedX - scaledWidth < width &&
            projectedY + scaledHeight > 0 &&
            projectedY - scaledHeight < height
          ) {
            ctx.save();
            ctx.translate(projectedX, projectedY);
            drawWireframeStrip(ctx, scaledWidth, scaledHeight, Math.max(0, opacity));
            ctx.restore();
          }
        }

        requestAnimationFrame(renderStarfield);
      };

      requestAnimationFrame(renderStarfield);
    }

  </script>

  <style>
    .selector-grid-mask {
      mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
    }
    @keyframes selector-drift-down {
      0% {
        transform: translateY(-50%);
      }
      100% {
        transform: translateY(0%);
      }
    }
    @keyframes selector-drift-up {
      0% {
        transform: translateY(0%);
      }
      100% {
        transform: translateY(-50%);
      }
    }
    .animate-selector-down {
      animation: selector-drift-down 22s linear infinite;
    }
    .animate-selector-up {
      animation: selector-drift-up 18s linear infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .animate-selector-down,
      .animate-selector-up {
        animation: none !important;
      }
    }
  </style>
</RootLayout>
