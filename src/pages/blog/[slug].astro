---
import RootLayout from '../../layouts/RootLayout.astro';
import DevMenu from '../../components/DevMenu.astro';
import BlogOutline from '../../components/BlogOutline.astro';
import AuthorAvatar from '../../components/AuthorAvatar.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { absoluteUrl, pageUrl, SITE_ROOT, AUTHOR_NAME, aiOrganization } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.[^/.]+$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Pre-resolve related project if declared
let relatedProject: any = null;
if (post.data.project) {
  relatedProject = await getEntry(post.data.project);
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const formattedUpdatedDate = post.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const readingTime = (() => {
  const words = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.ceil(words / 200));
  return `${minutes} min read`;
})();

const postSlug = post.id.replace(/\.[^/.]+$/, '');
const articleUrl = pageUrl(`/blog/${postSlug}/`);

interface NormalizedAuthor {
  name: string;
  role: string;
  avatar?: string;
  isAi: boolean;
}

function detectIsAi(name = '', avatar = '', role = '', explicitIsAi?: boolean): boolean {
  if (typeof explicitIsAi === 'boolean') return explicitIsAi;
  const n = name.toLowerCase();
  const a = (avatar || '').toLowerCase();
  const r = (role || '').toLowerCase();
  if (n.includes('yovan')) return false;
  return (
    n.includes('antigravity') ||
    n.includes('claude') ||
    n.includes('gemini') ||
    n.includes('gpt') ||
    n.includes('openai') ||
    n.includes('anthropic') ||
    n.includes('deepmind') ||
    a.includes('agy') ||
    a.includes('cld') ||
    r.includes('language model') ||
    r.includes('coding agent') ||
    r.includes('text generation') ||
    r.includes('generation')
  );
}

const authors: NormalizedAuthor[] = (() => {
  if (post.data.authors && post.data.authors.length > 0) {
    return post.data.authors.map((a: any) => {
      if (typeof a === 'string') {
        const isAi = detectIsAi(a);
        return {
          name: a,
          role: isAi ? 'Autonomous AI Collaborator & Systems Audit' : 'Software Engineer & Systems Architect',
          isAi,
          avatar: isAi ? '/images/agy.png' : (a.toLowerCase().includes('yovan') ? '/images/yg.png' : undefined),
        };
      }
      const isAi = detectIsAi(a.name, a.avatar, a.role, a.isAi);
      return {
        name: a.name,
        role: a.role || (isAi ? 'Autonomous AI Collaborator & Systems Audit' : 'Software Engineer & Systems Architect'),
        avatar: a.avatar || (isAi ? '/images/agy.png' : (a.name.toLowerCase().includes('yovan') ? '/images/yg.png' : undefined)),
        isAi,
      };
    });
  }

  const name = post.data.author || 'Yovan Gunardio Darmawan';
  const isAi = detectIsAi(name, post.data.authorAvatar, post.data.authorRole);
  const role = post.data.authorRole || (isAi ? 'Autonomous Coding Agent & Language Model at Google DeepMind' : 'Software Engineer & Systems Architecture Enthusiast based in Bogor, Indonesia.');
  const avatar = post.data.authorAvatar || (isAi ? '/images/agy.png' : '/images/yg.png');

  return [{ name, role, avatar, isAi }];
})();

  const hasAiAuthor = authors.some((a) => a.isAi);

function resolveImageUrl(img?: string) {
  if (!img) return undefined;
  if (img.startsWith('http://') || img.startsWith('https://')) return img;
  const clean = img.startsWith('/') ? img : `/${img}`;
  return `${base}${clean}`;
}

function formatUrl(url?: string): string {
  if (!url) return '';
  if (url.startsWith('http://') || url.startsWith('https://')) return url;
  const clean = url.startsWith('/') ? url : `/${url}`;
  return `${base}${clean}`;
}

const articleImage = post.data.image || post.data.thumbnail;
const articleImageUrl = resolveImageUrl(articleImage);

const wordCount = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
const aiOrgs = authors
  .filter((a) => a.isAi)
  .map((a) => aiOrganization(a.name))
  .filter((o, i, arr): o is NonNullable<typeof o> => Boolean(o) && arr.findIndex((x) => x?.name === o?.name) === i);

const yovanPerson = { '@type': 'Person', name: AUTHOR_NAME, url: SITE_ROOT };
const isAiOnly = authors.length > 0 && authors.every((a) => a.isAi) && aiOrgs.length > 0;
const attribution = isAiOnly
  ? { author: aiOrgs, editor: yovanPerson }
  : { author: yovanPerson, ...(aiOrgs.length > 0 && { contributor: aiOrgs }) };

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${articleUrl}#article`,
      headline: post.data.title,
      description: post.data.description,
      image: absoluteUrl(articleImage ?? '/og-default.png'),
      datePublished: post.data.publishDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
      url: articleUrl,
      mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
      inLanguage: 'en',
      keywords: post.data.tags.join(', '),
      wordCount,
      ...attribution,
      publisher: yovanPerson,
      isPartOf: { '@type': 'Blog', '@id': `${pageUrl('/blog/')}#blog` },
      ...(relatedProject && { about: { '@type': 'CreativeWork', name: relatedProject.data.title } }),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ROOT },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: pageUrl('/blog/') },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
      ],
    },
  ],
};
---

<RootLayout
  title={post.data.title}
  description={post.data.description}
  image={articleImage}
  imageAlt={post.data.imageAlt}
  type="article"
  keywords={post.data.tags}
  schema={articleSchema}
  noindex={post.data.noindex}
  article={{
    publishedTime: post.data.publishDate,
    modifiedTime: post.data.updatedDate,
    author: isAiOnly ? authors[0].name : AUTHOR_NAME,
    tags: post.data.tags,
  }}
>
  <!-- Reading Progress Bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 w-0 h-[2px] bg-neutral-950 dark:bg-white z-50 transition-[width] duration-75"
    aria-hidden="true"
  ></div>

  <!-- Client-side Markdown Content Enhancers (GFM Callouts & Base-aware Images) -->
  <script is:inline define:vars={{ base }}>
    function enhanceArticleContent() {
      const prose = document.querySelector('.blog-prose');
      if (!prose) return;

      // 1. GitHub Alert / Callout Transformer
      const calloutConfigs = {
        NOTE: {
          title: 'Note',
          borderColor: 'border-blue-200 dark:border-blue-800/60',
          bgColor: 'bg-blue-50/70 dark:bg-blue-950/25',
          textColor: 'text-blue-950 dark:text-blue-200',
          titleColor: 'text-blue-700 dark:text-blue-400',
          icon: `<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
        },
        TIP: {
          title: 'Tip',
          borderColor: 'border-emerald-200 dark:border-emerald-800/60',
          bgColor: 'bg-emerald-50/70 dark:bg-emerald-950/25',
          textColor: 'text-emerald-950 dark:text-emerald-200',
          titleColor: 'text-emerald-700 dark:text-emerald-400',
          icon: `<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>`
        },
        IMPORTANT: {
          title: 'Important',
          borderColor: 'border-purple-200 dark:border-purple-800/60',
          bgColor: 'bg-purple-50/70 dark:bg-purple-950/25',
          textColor: 'text-purple-950 dark:text-purple-200',
          titleColor: 'text-purple-700 dark:text-purple-400',
          icon: `<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`
        },
        WARNING: {
          title: 'Warning',
          borderColor: 'border-amber-200 dark:border-amber-800/60',
          bgColor: 'bg-amber-50/70 dark:bg-amber-950/25',
          textColor: 'text-amber-950 dark:text-amber-200',
          titleColor: 'text-amber-700 dark:text-amber-400',
          icon: `<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`
        },
        CAUTION: {
          title: 'Caution',
          borderColor: 'border-rose-200 dark:border-rose-800/60',
          bgColor: 'bg-rose-50/70 dark:bg-rose-950/25',
          textColor: 'text-rose-950 dark:text-rose-200',
          titleColor: 'text-rose-700 dark:text-rose-400',
          icon: `<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>`
        }
      };

      const blockquotes = prose.querySelectorAll('blockquote');
      blockquotes.forEach((bq) => {
        if (bq.dataset.calloutEnhanced) return;
        const firstP = bq.querySelector('p');
        if (!firstP) return;

        const match = firstP.innerHTML.trim().match(/^\[\!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]/i);
        if (!match) return;

        const type = match[1].toUpperCase();
        const config = calloutConfigs[type];
        if (!config) return;

        bq.dataset.calloutEnhanced = 'true';

        // Strip the marker from the paragraph
        firstP.innerHTML = firstP.innerHTML
          .replace(/^\[\!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\](<br\s*\/?>)?\s*/i, '')
          .trim();
        if (!firstP.innerHTML) {
          firstP.remove();
        }

        // Style the blockquote container as a rounded card with uniform border (NO white left border)
        bq.className = `not-italic my-6 p-4 sm:p-5 rounded-xl shadow-xs font-sans text-sm sm:text-base leading-relaxed callout-${type.toLowerCase()} ${config.textColor}`;

        // Prepend callout header
        const header = document.createElement('div');
        header.className = `flex items-center gap-2 font-sans font-bold text-xs uppercase tracking-wider mb-2 select-none ${config.titleColor}`;
        header.innerHTML = `${config.icon}<span>${config.title}</span>`;
        bq.insertBefore(header, bq.firstChild);
      });

      // 2. Base-aware Images and Broken Image Fallback
      const images = prose.querySelectorAll('img');
      const cleanBase = (base || '').replace(/\/$/, '');

      images.forEach((img) => {
        // Base URL rewrite for root-relative images
        const rawSrc = img.getAttribute('src');
        if (rawSrc && rawSrc.startsWith('/') && !rawSrc.startsWith('//') && cleanBase && !rawSrc.startsWith(cleanBase)) {
          img.src = `${cleanBase}${rawSrc}`;
        }

        // Apply clean media presentation styles
        if (!img.classList.contains('no-style')) {
          img.classList.add('rounded-lg', 'border', 'border-neutral-200/80', 'dark:border-neutral-800/80', 'shadow-xs', 'max-w-full', 'h-auto', 'transition-all');
        }

        const applyFallback = () => {
          if (img.dataset.fallbackApplied) return;
          img.dataset.fallbackApplied = 'true';
          
          const fallback = document.createElement('div');
          fallback.className = 'w-full my-6 p-6 rounded-xl border border-dashed border-neutral-300 dark:border-neutral-700 bg-neutral-100/70 dark:bg-neutral-900/70 flex flex-col items-center justify-center text-center gap-2 text-neutral-500 select-none';
          fallback.innerHTML = `
            <div class="p-2.5 rounded-full bg-neutral-200/60 dark:bg-neutral-800/60 text-neutral-500 dark:text-neutral-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300">Media asset preview unavailable</span>
            <span class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 max-w-sm truncate">${img.getAttribute('alt') || img.getAttribute('src') || 'Asset placeholder'}</span>
          `;
          img.replaceWith(fallback);
        };

        img.addEventListener('error', applyFallback);

        // Check if image already errored before listener was attached
        if (img.complete && img.naturalWidth === 0) {
          applyFallback();
        }
      });

      // 3. Responsive Table Wrapper
      const tables = prose.querySelectorAll('table');
      tables.forEach((table) => {
        if (table.parentElement?.classList.contains('table-scroll-wrapper')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'table-scroll-wrapper my-6 w-full max-w-full overflow-x-auto rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 shadow-xs';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhanceArticleContent);
    } else {
      enhanceArticleContent();
    }
  </script>

  <div class="relative z-10 w-full min-h-screen flex flex-col xl:flex-row items-start">
    <!-- Document Outline & Scrollbar Markers (Component Library & ChatGPT style) -->
    <BlogOutline headings={headings} />

    <main class="w-full flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12 space-y-10 min-w-0 transition-all duration-300">
    <!-- Navigation -->
    <nav aria-label="Breadcrumb" class="pb-2">
      <a
        href={`${base}/blog`}
        class="inline-flex items-center gap-1.5 font-sans text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors"
      >
        <span aria-hidden="true">←</span>
        <span>Back to Blog</span>
      </a>
    </nav>

    <!-- Article Header -->
    <header class="space-y-4 pb-8 border-b border-neutral-200 dark:border-neutral-800">
      <div class="flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400 font-sans flex-wrap">
        <div class="flex items-center gap-2">
          <div class="flex items-center -space-x-1.5">
            {authors.map((author, index) => (
              <AuthorAvatar
                name={author.name}
                avatar={author.avatar}
                isAi={author.isAi}
                size="sm"
                class="ring-2 ring-white dark:ring-neutral-950"
                zIndex={authors.length - index}
              />
            ))}
          </div>
          <span class="font-medium text-neutral-800 dark:text-neutral-200">
            By {authors.map((author, index) => (
              <>
                {index > 0 && index === authors.length - 1 ? (
                  <span class="text-neutral-400 dark:text-neutral-500 font-normal px-1 select-none">&</span>
                ) : index > 0 ? (
                  <span class="text-neutral-400 dark:text-neutral-500 font-normal mr-1 select-none">,</span>
                ) : null}
                <span>{author.name}</span>
              </>
            ))}
          </span>
        </div>

        {hasAiAuthor && (
          <span class="text-[10.5px] px-1.5 py-0.5 rounded bg-neutral-200/80 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 font-mono">
            {authors.length > 1 ? 'AI Co-Author' : 'AI Author'}
          </span>
        )}
        <div class="inline-flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400 font-sans whitespace-nowrap px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 shrink-0">
          <time datetime={post.data.publishDate.toISOString()}>
            {formattedDate}
          </time>
          {post.data.updatedDate && (
            <>
              <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">•</span>
              <span>Updated <time datetime={post.data.updatedDate.toISOString()}>{formattedUpdatedDate}</time></span>
            </>
          )}
          <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">•</span>
          <span>{readingTime}</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-sans font-bold tracking-tight text-neutral-950 dark:text-white leading-tight">
        {post.data.title}
      </h1>

      <p class="font-sans text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-3xl">
        {post.data.description}
      </p>

      <div class="flex items-center gap-1.5 flex-wrap pt-2">
        {relatedProject && (
          <a
            href={`${base}/portfolio-index#${relatedProject.id}`}
            class="inline-flex items-center font-sans text-xs font-medium px-2.5 py-0.5 rounded-full bg-neutral-800 text-neutral-200 dark:bg-neutral-200 dark:text-neutral-900 hover:bg-neutral-700 dark:hover:bg-neutral-300 transition-colors"
          >
            <span>{relatedProject.data.title}</span>
          </a>
        )}
        {post.data.tags.map((tag: string) => (
          <span class="font-sans text-xs px-2.5 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
            {tag}
          </span>
        ))}
      </div>

      <!-- RELATED PROJECT SYSTEM HERO CARD -->
      {relatedProject && (
        <aside class="relative mt-8 p-5 sm:p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/60 shadow-sm">
          <span class="absolute top-0 left-5 sm:left-6 -translate-y-1/2 text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-neutral-100 text-neutral-700 border border-neutral-300 dark:bg-neutral-900 dark:text-neutral-200 dark:border-neutral-500/80 font-sans shadow-xs z-10 select-none">
            Related Project
          </span>
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div class="space-y-2 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-sans text-xs text-neutral-500">
                  {relatedProject.data.category}
                </span>
              </div>
              <h3 class="text-lg sm:text-xl font-sans font-bold text-neutral-950 dark:text-white">
                {relatedProject.data.title}
              </h3>
              <p class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {relatedProject.data.description}
              </p>
              <div class="flex items-center gap-1.5 flex-wrap pt-1">
                {relatedProject.data.tech.map((t: string) => (
                  <span class="font-sans text-xs px-2 py-0.5 rounded-full bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-600 dark:text-neutral-400">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            {relatedProject.data.github && (
              <div class="shrink-0 pt-1">
                <a
                  href={relatedProject.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-sans text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors"
                >
                  <span>GitHub Repository</span>
                </a>
              </div>
            )}
          </div>

          {relatedProject.data.href && (
            <a
              href={formatUrl(relatedProject.data.href)}
              target={relatedProject.data.href.startsWith('http') ? '_blank' : undefined}
              rel={relatedProject.data.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="group overflow-hidden absolute bottom-0 right-5 sm:right-6 translate-y-1/2 inline-flex items-center px-3 py-1 rounded-lg bg-white dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border border-neutral-300 dark:border-neutral-600 font-sans font-medium text-xs hover:border-neutral-500 dark:hover:border-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors shadow-xs z-10 select-none"
            >
              <div class="inline-flex items-center translate-x-[10px] group-hover:translate-x-0 transition-transform duration-200 ease-out">
                <span>Explore Project</span>
                <span class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out" aria-hidden="true">
                  {relatedProject.data.href.startsWith('http') ? '↗' : '→'}
                </span>
              </div>
            </a>
          )}
        </aside>
      )}
    </header>

    <!-- Article Picture / Cover Media -->
    {articleImageUrl && (
      <figure class="my-6 overflow-hidden border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-100 dark:bg-neutral-900 shadow-sm">
        <img
          src={articleImageUrl}
          alt={post.data.imageAlt || post.data.title}
          class="w-full max-h-[560px] object-cover"
          loading="eager"
        />
        {post.data.imageAlt && (
          <figcaption class="px-4 py-2.5 text-xs text-neutral-500 dark:text-neutral-400 font-sans border-t border-neutral-200/60 dark:border-neutral-800/60 bg-neutral-50/50 dark:bg-neutral-950/40">
            {post.data.imageAlt}
          </figcaption>
        )}
      </figure>
    )}

    <!-- Post Body / Markdown Content -->
    <article class="blog-prose font-sans text-neutral-800 dark:text-neutral-200 leading-relaxed space-y-6 max-w-none">
      <Content />
    </article>

    <!-- Article Footer / Author Card & Navigation -->
    <footer class="mt-16 pt-8 border-t border-neutral-200 dark:border-neutral-800 space-y-8">
      <div class="p-5 sm:p-6 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/60 dark:bg-neutral-950/60 shadow-sm space-y-6">
        <div class="flex items-center justify-between gap-4 border-b border-neutral-200/60 dark:border-neutral-800/60 pb-4">
