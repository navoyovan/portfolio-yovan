---
import RootLayout from '../../layouts/RootLayout.astro';
import AuthorAvatar from '../../components/AuthorAvatar.astro';
import { getCollection, getEntry } from 'astro:content';
import { pageUrl, SITE_ROOT, AUTHOR_NAME } from '../../lib/seo';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

function detectIsAi(name = '', avatar = '', role = '', explicitIsAi?: boolean): boolean {
  if (typeof explicitIsAi === 'boolean') return explicitIsAi;
  const n = name.toLowerCase();
  const a = (avatar || '').toLowerCase();
  const r = (role || '').toLowerCase();
  if (n.includes('yovan')) return false;
  return (
    n.includes('antigravity') ||
    n.includes('claude') ||
    n.includes('gemini') ||
    n.includes('gpt') ||
    n.includes('openai') ||
    n.includes('anthropic') ||
    n.includes('deepmind') ||
    a.includes('agy') ||
    a.includes('cld') ||
    r.includes('language model') ||
    r.includes('coding agent') ||
    r.includes('generation')
  );
}

function getPostAuthors(post: any) {
  if (post.data.authors && post.data.authors.length > 0) {
    return post.data.authors.map((a: any) => {
      if (typeof a === 'string') {
        const isAi = detectIsAi(a);
        return {
          name: a,
          isAi,
          avatar: isAi ? '/images/agy.png' : (a.toLowerCase().includes('yovan') ? '/images/yg.png' : undefined),
        };
      }
      const isAi = detectIsAi(a.name, a.avatar, a.role, a.isAi);
      return {
        name: a.name,
        isAi,
        avatar: a.avatar || (isAi ? '/images/agy.png' : (a.name.toLowerCase().includes('yovan') ? '/images/yg.png' : undefined)),
      };
    });
  }
  const name = post.data.author || 'Yovan Gunardio Darmawan';
  const isAi = detectIsAi(name, post.data.authorAvatar, post.data.authorRole);
  const avatar = post.data.authorAvatar || (isAi ? '/images/agy.png' : '/images/yg.png');
  return [{ name, isAi, avatar }];
}

// Pre-resolve related projects for each post
const postsWithProjects = await Promise.all(
  posts.map(async (post) => {
    let project = null;
    if (post.data.project) {
      project = await getEntry(post.data.project);
    }
    return { post, project };
  })
);

function getReadingTime(body?: string): string {
  if (!body) return '1 min read';
  const words = body.trim().split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.ceil(words / 200));
  return `${minutes} min read`;
}

function resolveImageUrl(img?: string) {
  if (!img) return null;
  if (img.startsWith('http://') || img.startsWith('https://')) return img;
  const clean = img.startsWith('/') ? img : `/${img}`;
  return `${base}${clean}`;
}

const blogUrl = pageUrl('/blog/');
const indexablePosts = posts.filter((p) => !p.data.noindex);

const blogSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${blogUrl}#blog`,
      name: 'Technical Writing & Architecture Post-Mortems',
      description: 'Deep dives, post-mortems, and architectural case studies by Yovan Gunardio Darmawan.',
      url: blogUrl,
      author: {
        '@type': 'Person',
        name: AUTHOR_NAME,
        url: SITE_ROOT,
      },
      publisher: {
        '@type': 'Person',
        name: AUTHOR_NAME,
        url: SITE_ROOT,
      },
      blogPost: indexablePosts.map((p) => {
        const slug = p.id.replace(/\.[^/.]+$/, '');
        return {
          '@type': 'BlogPosting',
          headline: p.data.title,
          url: pageUrl(`/blog/${slug}/`),
          datePublished: p.data.publishDate.toISOString(),
          description: p.data.description,
        };
      }),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ROOT },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
      ],
    },
  ],
};
---

<RootLayout
  title="Blog"
  description="Technical post-mortems, software architecture deep dives, and performance engineering case studies."
  keywords={['Software Engineering Blog', 'Performance Optimization', 'Architecture Post-Mortem', 'Astro', 'TypeScript']}
  schema={blogSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    <!-- Header Matching Portfolio Index -->
    <div id="blog-header" class="border-b border-neutral-200 dark:border-neutral-800 pb-8">
      <h1 class="text-3xl sm:text-4xl font-sans font-bold tracking-tight text-neutral-950 dark:text-white">
        Blog
      </h1>
      <p
        data-en="Technical post-mortems, software architecture deep dives, and performance engineering case studies."
        data-id="Analisis teknis, investigasi performa, dan catatan arsitektur sistem."
        class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl font-normal"
      >
        Technical post-mortems, software architecture deep dives, and performance engineering case studies.
      </p>
    </div>

    <!-- Post Grid / Feed -->
    {postsWithProjects.length === 0 ? (
      <div class="p-12 text-center border border-dashed border-neutral-300 dark:border-neutral-800 rounded-lg text-neutral-500 font-sans text-sm">
        <span data-en="No articles published yet. Check back soon!" data-id="Belum ada artikel yang diterbitkan. Silakan kembali lagi nanti!">
          No articles published yet. Check back soon!
        </span>
      </div>
    ) : (
      <div class="space-y-8">
        <!-- Featured Card (Latest Article - Wide) -->
        {postsWithProjects.slice(0, 1).map(({ post, project }) => {
          const postSlug = post.id.replace(/\.[^/.]+$/, '');
          const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            timeZone: 'UTC',
          });

          const postAuthors = getPostAuthors(post);
          const thumbSrc = resolveImageUrl(post.data.thumbnail || post.data.image);

          return (
            <article class="group relative p-6 sm:p-8 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/70 dark:bg-neutral-950/70 hover:border-neutral-400 dark:hover:border-neutral-700 transition-[border-color,box-shadow] duration-200 shadow-sm hover:shadow-md">
              <span class="absolute top-0 left-6 sm:left-8 -translate-y-1/2 text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-neutral-100 text-neutral-600 border border-neutral-300/80 dark:bg-neutral-900 dark:text-neutral-400 dark:border-neutral-800 font-sans shadow-xs z-10 select-none">
                Latest
              </span>
              <div class={thumbSrc ? "grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center" : ""}>
                <div class={thumbSrc ? "lg:col-span-7 flex flex-col justify-between" : ""}>
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                    <div class="flex items-center gap-2.5 flex-wrap">
                      <div class="flex items-center gap-1.5">
                        <div class="flex items-center -space-x-1.5">
                          {postAuthors.map((author, index) => (
                            <AuthorAvatar
                              name={author.name}
                              avatar={author.avatar}
                              isAi={author.isAi}
                              size="xs"
                              class="ring-1 ring-white dark:ring-neutral-950"
                              zIndex={postAuthors.length - index}
                            />
                          ))}
                        </div>
                        <span class="text-xs text-neutral-700 dark:text-neutral-300 font-sans font-medium">
                          By {postAuthors.map((a, i) => (
                            <>
                              {i > 0 && i === postAuthors.length - 1 ? (
                                <span class="text-neutral-400 dark:text-neutral-500 font-normal px-1 select-none">&</span>
                              ) : i > 0 ? (
                                <span class="text-neutral-400 dark:text-neutral-500 font-normal mr-1 select-none">,</span>
                              ) : null}
                              <span>{a.name}</span>
                            </>
                          ))}
                        </span>
                      </div>
                      <div class="inline-flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400 font-sans whitespace-nowrap px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 shrink-0">
                        <time datetime={post.data.publishDate.toISOString()}>
                          {formattedDate}
                        </time>
                        <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">•</span>
                        <span>
                          {getReadingTime(post.body)}
                        </span>
                      </div>
                    </div>
                  </div>

                  <h2 class="text-2xl sm:text-3xl font-sans font-bold text-neutral-950 dark:text-white mb-3 leading-snug">
                    <a href={`${base}/blog/${postSlug}/`} class="focus:outline-none focus-visible:underline group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors">
                      <span class="absolute inset-0" aria-hidden="true"></span>
                      {post.data.title}
                    </a>
                  </h2>

                  <p class="font-sans text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6 max-w-3xl">
                    {post.data.description}
                  </p>

                  <div class="flex items-end justify-between gap-4 pt-3 border-t border-neutral-200/80 dark:border-neutral-800/80">
                    <div class="flex items-center gap-1.5 flex-wrap min-w-0">
                      {project && (
                        <span class="inline-flex items-center text-xs px-2.5 py-0.5 rounded-full bg-neutral-800 text-neutral-200 dark:bg-neutral-200 dark:text-neutral-900 font-sans font-medium">
                          {project.data.title}
                        </span>
                      )}
                      {post.data.tags.map((tag: string) => (
                        <span class="text-xs px-2.5 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 font-sans">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <span class="inline-flex items-center font-sans font-semibold text-xs text-neutral-950 dark:text-white shrink-0 whitespace-nowrap overflow-hidden">
                      <span class="inline-flex items-center translate-x-[10px] group-hover:translate-x-0 transition-transform duration-200 ease-out">
                        <span data-en="Read article" data-id="Baca artikel">Read article</span>
                        <span class="inline-flex items-center justify-center w-3.5 ml-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out" aria-hidden="true">
                          →
                        </span>
                      </span>
                    </span>
                  </div>
                </div>

                {thumbSrc && (
                  <div class="lg:col-span-5 w-full order-first lg:order-last">
                    <div class="relative aspect-[16/10] sm:aspect-[16/9] lg:aspect-[4/3] rounded-lg overflow-hidden border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-100 dark:bg-neutral-900 shadow-inner">
                      <img
                        src={thumbSrc}
                        alt={post.data.imageAlt || post.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                        loading="eager"
                      />
                    </div>
                  </div>
                )}
              </div>
            </article>
          );
        })}

        <!-- Organic Masonry / Bento for Remaining Articles -->
        {postsWithProjects.length > 1 && (
          <div class="columns-1 md:columns-2 gap-6 pt-2">
            {postsWithProjects.slice(1).map(({ post, project }) => {
              const postSlug = post.id.replace(/\.[^/.]+$/, '');
              const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
                timeZone: 'UTC',
              });
              const postAuthors = getPostAuthors(post);
              const thumbSrc = resolveImageUrl(post.data.thumbnail || post.data.image);

              return (
                <article class="break-inside-avoid mb-6 group relative rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/70 dark:bg-neutral-950/70 hover:border-neutral-400 dark:hover:border-neutral-700 transition-[border-color,box-shadow] duration-200 shadow-sm hover:shadow-md flex flex-col overflow-hidden">
                  {thumbSrc && (
                    <div class="relative aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden bg-neutral-100 dark:bg-neutral-900 border-b border-neutral-200/80 dark:border-neutral-800/80">
                      <img
                        src={thumbSrc}
                        alt={post.data.imageAlt || post.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                        loading="lazy"
                      />
                    </div>
                  )}

                  <div class="p-6 sm:p-7 flex flex-col flex-1">
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <div class="flex items-center gap-2 flex-wrap">
                        <div class="flex items-center gap-1.5">
                          <div class="flex items-center -space-x-1.5">
                            {postAuthors.map((author, index) => (
                              <AuthorAvatar
                                name={author.name}
                                avatar={author.avatar}
                                isAi={author.isAi}
                                size="xs"
                                class="ring-1 ring-white dark:ring-neutral-950"
                                zIndex={postAuthors.length - index}
                              />
                            ))}
                          </div>
                          <span class="text-[11px] sm:text-xs text-neutral-700 dark:text-neutral-300 font-sans font-medium">
                            By {postAuthors.map((a, i) => (
                              <>
                                {i > 0 && i === postAuthors.length - 1 ? (
                                  <span class="text-neutral-400 dark:text-neutral-500 font-normal px-1 select-none">&</span>
                                ) : i > 0 ? (
                                  <span class="text-neutral-400 dark:text-neutral-500 font-normal mr-1 select-none">,</span>
                                ) : null}
                                <span>{a.name}</span>
                              </>
                            ))}
                          </span>
                        </div>
                        <div class="inline-flex items-center gap-1.5 text-[11px] sm:text-xs text-neutral-500 dark:text-neutral-400 font-sans whitespace-nowrap px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 shrink-0">
                          <time datetime={post.data.publishDate.toISOString()}>
                            {formattedDate}
                          </time>
                          <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">•</span>
                          <span>
                            {getReadingTime(post.body)}
                          </span>
                        </div>
                      </div>
                    </div>

                    <h3 class="text-xl sm:text-2xl font-sans font-bold text-neutral-950 dark:text-white mb-2 leading-snug">
                      <a href={`${base}/blog/${postSlug}/`} class="focus:outline-none focus-visible:underline group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors">
                        <span class="absolute inset-0" aria-hidden="true"></span>
                        {post.data.title}
                      </a>
                    </h3>

                    <p class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
                      {post.data.description}
                    </p>

                    <div class="flex items-end justify-between gap-3 pt-3 border-t border-neutral-200/60 dark:border-neutral-800/60 mt-auto">
                      <div class="flex items-center gap-1.5 flex-wrap min-w-0">
                        {project && (
                          <span class="inline-flex items-center text-xs px-2.5 py-0.5 rounded-full bg-neutral-800 text-neutral-200 dark:bg-neutral-200 dark:text-neutral-900 font-sans font-medium">
                            {project.data.title}
                          </span>
                        )}
                        {post.data.tags.map((tag: string) => (
                          <span class="text-xs px-2.5 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 font-sans">
                            {tag}
                          </span>
                        ))}
                      </div>

                      <span class="inline-flex items-center font-sans font-semibold text-xs text-neutral-950 dark:text-white shrink-0 whitespace-nowrap overflow-hidden">
                        <span class="inline-flex items-center translate-x-[10px] group-hover:translate-x-0 transition-transform duration-200 ease-out">
                          <span data-en="Read article" data-id="Baca artikel">Read article</span>
                          <span class="inline-flex items-center justify-center w-3.5 ml-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out" aria-hidden="true">
                            →
                          </span>
                        </span>
                      </span>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    )}
  </div>
</RootLayout>
