---
import RootLayout from '../../layouts/RootLayout.astro';
import { getCollection, getEntry } from 'astro:content';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// Pre-resolve related projects for each post
const postsWithProjects = await Promise.all(
  posts.map(async (post) => {
    let project = null;
    if (post.data.project) {
      project = await getEntry(post.data.project);
    }
    return { post, project };
  })
);

function getReadingTime(body?: string): string {
  if (!body) return '1 min read';
  const words = body.trim().split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.ceil(words / 200));
  return `${minutes} min read`;
}

const siteUrl = Astro.site?.toString() || 'https://navoyovan.github.io/portfolio-yovan';

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Technical Writing & Architecture Post-Mortems',
  description: 'Deep dives, post-mortems, and architectural case studies by Yovan Gunardio Darmawan.',
  url: `${siteUrl}/blog`,
  author: {
    '@type': 'Person',
    name: 'Yovan Gunardio Darmawan',
  },
};
---

<RootLayout
  title="Blog | Yovan Gunardio Darmawan"
  description="Technical post-mortems, software architecture deep dives, and performance engineering case studies."
  keywords={['Software Engineering Blog', 'Performance Optimization', 'Architecture Post-Mortem', 'Astro', 'TypeScript']}
  schema={blogSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12">
    <!-- Header Matching Portfolio Index -->
    <div id="blog-header" class="border-b border-neutral-200 dark:border-neutral-800 pb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white">
        Blog
      </h1>
      <p
        data-en="Technical post-mortems, software architecture deep dives, and performance engineering case studies."
        data-id="Analisis teknis, investigasi performa, dan catatan arsitektur sistem."
        class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl font-normal"
      >
        Technical post-mortems, software architecture deep dives, and performance engineering case studies.
      </p>
    </div>

    <!-- Post Grid / Feed -->
    {postsWithProjects.length === 0 ? (
      <div class="p-12 text-center border border-dashed border-neutral-300 dark:border-neutral-800 rounded-lg text-neutral-500 font-sans text-sm">
        <span data-en="No articles published yet. Check back soon!" data-id="Belum ada artikel yang diterbitkan. Silakan kembali lagi nanti!">
          No articles published yet. Check back soon!
        </span>
      </div>
    ) : (
      <div class="space-y-8">
        <!-- Featured Card (Latest Article) -->
        {postsWithProjects.slice(0, 1).map(({ post, project }) => {
          const postSlug = post.id.replace(/\.[^/.]+$/, '');
          const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });

          return (
            <article class="group relative p-6 sm:p-8 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/70 dark:bg-neutral-950/70 hover:border-neutral-400 dark:hover:border-neutral-700 transition-[border-color,box-shadow] duration-200 shadow-sm hover:shadow-md">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-neutral-950 text-white dark:bg-white dark:text-neutral-950 font-sans">
                    Latest
                  </span>
                  {post.data.author && post.data.author !== 'Yovan Gunardio Darmawan' && (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-200/80 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 font-sans font-medium">
                      By {post.data.author}
                    </span>
                  )}
                  <time datetime={post.data.publishDate.toISOString()} class="text-xs text-neutral-500 dark:text-neutral-400 font-sans">
                    {formattedDate}
                  </time>
                  <span class="text-neutral-300 dark:text-neutral-700 font-sans">•</span>
                  <span class="text-xs text-neutral-500 dark:text-neutral-400 font-sans">
                    {getReadingTime(post.body)}
                  </span>
                </div>

                {project && (
                  <span class="inline-flex items-center gap-1.5 text-xs px-2.5 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-800 font-sans">
                    <span class="w-1.5 h-1.5 rounded-full bg-neutral-950 dark:bg-white"></span>
                    <span>{project.data.title}</span>
                  </span>
                )}
              </div>

              <h2 class="text-2xl sm:text-3xl font-sans font-bold text-neutral-950 dark:text-white mb-3 leading-snug">
                <a href={`${base}/blog/${postSlug}`} class="focus:outline-none focus-visible:underline group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors">
                  <span class="absolute inset-0" aria-hidden="true"></span>
                  {post.data.title}
                </a>
              </h2>

              <p class="font-sans text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6 max-w-3xl">
                {post.data.description}
              </p>

              <div class="flex items-center justify-between gap-4 flex-wrap pt-3 border-t border-neutral-200/80 dark:border-neutral-800/80">
                <div class="flex items-center gap-1.5 flex-wrap">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-xs px-2.5 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400 font-sans">
                      {tag}
                    </span>
                  ))}
                </div>

                <span class="inline-flex items-center font-sans font-semibold text-xs text-neutral-950 dark:text-white group-hover:underline underline-offset-4 transition-all">
                  <span data-en="Read article" data-id="Baca artikel">Read article</span>
                </span>
              </div>
            </article>
          );
        })}

        <!-- Remaining Posts Grid -->
        {postsWithProjects.length > 1 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
            {postsWithProjects.slice(1).map(({ post, project }) => {
              const postSlug = post.id.replace(/\.[^/.]+$/, '');
              const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              });

              return (
                <article class="group relative p-6 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/70 dark:bg-neutral-950/70 hover:border-neutral-400 dark:hover:border-neutral-700 transition-[border-color,background-color] duration-200 flex flex-col justify-between shadow-sm">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <div class="flex items-center gap-2 flex-wrap">
                        {post.data.author && post.data.author !== 'Yovan Gunardio Darmawan' && (
                          <span class="text-[11px] px-1.5 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-300 font-sans">
                            {post.data.author}
                          </span>
                        )}
                        <time datetime={post.data.publishDate.toISOString()} class="text-xs text-neutral-500 font-sans">
                          {formattedDate}
                        </time>
                        <span class="text-neutral-300 dark:text-neutral-700 font-sans">•</span>
                        <span class="text-xs text-neutral-500 font-sans">
                          {getReadingTime(post.body)}
                        </span>
                      </div>
                      {project && (
                        <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800 font-sans">
                          {project.data.title}
                        </span>
                      )}
                    </div>

                    <h3 class="text-xl font-sans font-bold text-neutral-950 dark:text-white mb-2 leading-snug">
                      <a href={`${base}/blog/${postSlug}`} class="focus:outline-none focus-visible:underline group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors">
                        <span class="absolute inset-0" aria-hidden="true"></span>
                        {post.data.title}
                      </a>
                    </h3>

                    <p class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
                      {post.data.description}
                    </p>
                  </div>

                  <div class="flex items-center justify-between gap-2 pt-3 border-t border-neutral-200/60 dark:border-neutral-800/60 flex-wrap">
                    <div class="flex items-center gap-1 flex-wrap">
                      {post.data.tags.map((tag: string) => (
                        <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-900 text-neutral-500 font-sans">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <span class="text-xs font-sans font-semibold text-neutral-500 group-hover:text-neutral-950 dark:group-hover:text-white transition-colors">
                      Read
                    </span>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    )}
  </div>
</RootLayout>
