---
import RootLayout from "../layouts/RootLayout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
---

<RootLayout
  title="Section Headers Sandbox (01-04) | Portfolio Workbench"
  description="Isolated comparison and preview sandbox containing all 1, 2, 3, 4 sliced numeral section headers."
  noindex={true}
>
  <main class="min-h-screen bg-[#fcfbf9] dark:bg-[#090909] text-neutral-950 dark:text-neutral-100 py-16 px-4 sm:px-6">
    <div class="w-[94%] sm:w-[86%] lg:w-[80%] mx-auto space-y-20">
      
      <!-- Top Minimal Meta Bar -->
      <div class="border-b border-neutral-200 dark:border-neutral-800 pb-4 flex items-center justify-between font-mono text-xs text-neutral-500">
        <span>SANDBOX // ALL SECTION HEADERS (01 - 04)</span>
        <span>NO BLOAT // SURGICAL ISOLATION</span>
      </div>

      <!-- ========================================== -->
      <!-- SECTION 01 HEADER: OVERVIEW -->
      <!-- ========================================== -->
      <section class="space-y-4">
        <div class="flex items-stretch gap-0 pb-1">
          <!-- Big Section Numeral "1" -->
          <div
            id="overview-numeral-crop"
            class="relative overflow-hidden flex items-start justify-end select-none shrink-0 w-[60px] sm:w-[85px]"
            style="contain: paint;"
          >
            <span
              id="overview-numeral"
              class="relative font-sans font-black leading-none text-neutral-950/40 dark:text-white/40 tracking-[0.5px] shrink-0 select-none"
              aria-hidden="true"
              style="font-size: 92px; left: 8px; top: -6px; display: inline-block;"
            >
              1
            </span>
          </div>

          <!-- Vertical Divider Line -->
          <div class="w-px bg-neutral-300 dark:bg-neutral-800 shrink-0 self-stretch my-0.5" aria-hidden="true"></div>

          <!-- Right Side: Overview label + Headline -->
          <div class="flex-1 flex flex-col justify-center min-w-0 pl-2.5 sm:pl-4 lg:pl-5 py-0.5 gap-1.5">
            <div class="flex items-center justify-between pb-1 border-b border-neutral-200 dark:border-neutral-800 w-full">
              <span class="font-sans font-medium text-[10.5px] sm:text-xs uppercase tracking-[0.5px] text-neutral-500 dark:text-neutral-400">
                OVERVIEW
              </span>
            </div>

            <h2 class="text-[25px] sm:text-3xl md:text-4xl lg:text-5xl font-medium tracking-[0.5px] text-neutral-950 dark:text-white leading-[1.08] font-sans w-full m-0">
              He builds software that makes ideas real.
            </h2>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SECTION 02 HEADER: FEATURED WORK -->
      <!-- ========================================== -->
      <section class="space-y-4">
        <div class="flex items-stretch gap-0 pb-1">
          <!-- Big Section Numeral "2" -->
          <div
            id="projects-numeral-crop"
            class="relative overflow-hidden flex items-start justify-end select-none shrink-0 w-[60px] sm:w-[85px]"
            style="contain: paint;"
          >
            <span
              id="projects-numeral"
              class="relative font-sans font-black leading-none text-neutral-950/40 dark:text-white/40 tracking-[0.5px] shrink-0 select-none"
              aria-hidden="true"
              style="font-size: 92px; left: 9px; top: -6px; display: inline-block;"
            >
              2
            </span>
          </div>

          <!-- Vertical Divider Line -->
          <div class="w-px bg-neutral-300 dark:bg-neutral-800 shrink-0 self-stretch my-0.5" aria-hidden="true"></div>

          <!-- Right Side: Featured Work label + Link + Headline & Subdeck -->
          <div class="flex-1 flex flex-col justify-center min-w-0 pl-2.5 sm:pl-4 lg:pl-5 py-0.5 gap-1.5">
            <div class="flex items-center justify-between pb-1 border-b border-neutral-200 dark:border-neutral-800 w-full">
              <span class="font-sans font-medium text-[10.5px] sm:text-xs uppercase tracking-[0.5px] text-neutral-500 dark:text-neutral-400">
                FEATURED WORK
              </span>
              <a
                href={`${base}/portfolio-index`}
                class="group/action inline-flex items-center gap-1 font-mono text-[10.5px] sm:text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 hover:text-[var(--color-accent,#52FF1A)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded px-1"
              >
                <span>View Full Index</span>
                <span class="inline-block opacity-40 transition-all duration-200 group-hover/action:opacity-100 group-hover/action:translate-x-0.5">
                  →
                </span>
              </a>
            </div>

            <div class="space-y-1.5 pt-0.5">
              <h2 class="text-[25px] sm:text-3xl md:text-4xl lg:text-5xl font-medium tracking-[0.5px] text-neutral-950 dark:text-white leading-[1.08] font-sans w-full m-0">
                Things I've built
              </h2>
              <p class="font-sans text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal tracking-[0.5px] max-w-3xl m-0">
                A collection of projects and products where I tried to solve a problem, learn something new, or just casually build a SaaS multi-tenant B2B ecosystem.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SECTION 03 HEADER: WHAT I CAN BUILD -->
      <!-- ========================================== -->
      <section class="space-y-4">
        <div class="flex items-stretch gap-0 pb-1">
          <!-- Big Section Numeral "3" -->
          <div
            id="capabilities-numeral-crop"
            class="relative overflow-hidden flex items-start justify-end select-none shrink-0 w-[60px] sm:w-[85px]"
            style="contain: paint;"
          >
            <span
              id="capabilities-numeral"
              class="relative font-sans font-black leading-none text-neutral-950/40 dark:text-white/40 tracking-[0.5px] shrink-0 select-none"
              aria-hidden="true"
              style="font-size: 92px; left: 9px; top: -6px; display: inline-block;"
            >
              3
            </span>
          </div>

          <!-- Vertical Divider Line -->
          <div class="w-px bg-neutral-300 dark:bg-neutral-800 shrink-0 self-stretch my-0.5" aria-hidden="true"></div>

          <!-- Right Side: Capabilities label + Headline -->
          <div class="flex-1 flex flex-col justify-center min-w-0 pl-2.5 sm:pl-4 lg:pl-5 py-0.5 gap-1.5">
            <div class="flex items-center justify-between pb-1 border-b border-neutral-200 dark:border-neutral-800 w-full">
              <span class="font-sans font-medium text-[10.5px] sm:text-xs uppercase tracking-[0.5px] text-neutral-500 dark:text-neutral-400">
                WHAT I CAN BUILD
              </span>
            </div>

            <div class="pt-0.5">
              <h2 class="text-[25px] sm:text-3xl md:text-4xl lg:text-5xl font-medium tracking-[0.5px] text-neutral-950 dark:text-white leading-[1.08] font-sans w-full m-0">
                From simple pages to systems that do stuff.
              </h2>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SECTION 04 HEADER: PHILOSOPHY -->
      <!-- ========================================== -->
      <section class="space-y-4">
        <div class="flex items-stretch gap-0 pb-1">
          <!-- Big Section Numeral "4" -->
          <div
            id="philosophy-numeral-crop"
            class="relative overflow-hidden flex items-start justify-end select-none shrink-0 w-[60px] sm:w-[85px]"
            style="contain: paint;"
          >
            <span
              id="philosophy-numeral"
              class="relative font-sans font-black leading-none text-neutral-950/40 dark:text-white/40 tracking-[0.5px] shrink-0 select-none"
              aria-hidden="true"
              style="font-size: 92px; left: 9px; top: -6px; display: inline-block;"
            >
              4
            </span>
          </div>

          <!-- Vertical Divider Line -->
          <div class="w-px bg-neutral-300 dark:bg-neutral-800 shrink-0 self-stretch my-0.5" aria-hidden="true"></div>

          <!-- Right Side: Philosophy label + Headline & Subdeck -->
          <div class="flex-1 flex flex-col justify-center min-w-0 pl-2.5 sm:pl-4 lg:pl-5 py-0.5 gap-1.5">
            <div class="flex items-center justify-between pb-1 border-b border-neutral-200 dark:border-neutral-800 w-full">
              <span class="font-sans font-medium text-[10.5px] sm:text-xs uppercase tracking-[0.5px] text-neutral-500 dark:text-neutral-400">
                PHILOSOPHY
              </span>
            </div>

            <div class="space-y-1.5 pt-0.5">
              <h2 class="text-[25px] sm:text-3xl md:text-4xl lg:text-5xl font-medium tracking-[0.5px] text-neutral-950 dark:text-white leading-[1.08] font-sans w-full m-0">
                <span>I build for the </span><span class="font-normal text-neutral-700 dark:text-neutral-300">thing</span><span>, not the stack.</span>
              </h2>
              <p class="font-serif italic text-neutral-600 dark:text-neutral-300 leading-relaxed text-sm sm:text-base m-0">
                A little bit of webapp in my life, a little bit of vscode by my side...
              </p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
</RootLayout>
