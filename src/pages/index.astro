---
import RootLayout from "../layouts/RootLayout.astro";
import Hero from "../components/Hero.astro";
import Overview from "../components/Overview.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import Section3Capabilities from "../components/Section3Capabilities.astro";
import StatusBadge from "../components/StatusBadge.astro";
import ActionButton from "../components/ActionButton.astro";
import EggLink from "../components/EggLink.astro";
import EasterEggs from "../components/EasterEggs.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;


---

<RootLayout
  title="Yovan Gunardio Darmawan | Software Engineer & Builder"
  description="Hey, I'm Yovan. Software engineer building web apps, touchscreen kiosks, and connected hardware systems. Available for freelance projects."
  keywords={[
    "Yovan Gunardio Darmawan",
    "Software Engineer",
    "Freelance Developer",
    "Web Application Developer",
    "Full-Stack Developer",
    "React Developer",
    "Laravel Developer",
    "Electron Developer",
    "Touchscreen Kiosk Software",
    "Photobooth Software",
    "HYPE-BOX",
    "SEO & Web Optimization",
    "Web Accessibility (a11y)",
    "Indonesia",
  ]}
>
  <!-- page wrapper: position relative so easter eggs scatter through scroll height -->
  <div class="relative">
    <EasterEggs />

    <Hero firstName="Yovan" middleName="Gunardio." />

    <div class="relative z-10 w-[92%] sm:w-[86%] lg:w-[80%] mx-auto space-y-24 pb-0">
      <!-- 01 // OVERVIEW & HERO STATEMENT -->
      <Overview base={base} />

      <!-- 02 // PROJECTS & HYPEBOX -->
      <FeaturedProjects base={base} />


      <!-- 03 // WHAT I CAN BUILD -->
      <Section3Capabilities base={base} />

      <!-- 04 // PHILOSOPHY -->
      <section
        id="philosophy"
        aria-labelledby="heading-philosophy"
        class="scroll-mt-24 pt-16 space-y-8"
      >
        <div class="relative w-screen left-1/2 -translate-x-1/2 px-6 sm:px-12 flex flex-col min-w-0 pb-1 gap-2">
          <!-- Eyebrow Row: Bold Number + Eyebrow Label -->
          <div class="relative flex items-center justify-between pb-1.5 border-b border-neutral-200 dark:border-neutral-800 w-full">
            <span aria-hidden="true" class="absolute -bottom-[5.5px] left-0 font-mono text-[10px] leading-none text-neutral-400/70 dark:text-neutral-600 select-none pointer-events-none">+</span>
            <span aria-hidden="true" class="absolute -bottom-[5.5px] right-0 font-mono text-[10px] leading-none text-neutral-400/70 dark:text-neutral-600 select-none pointer-events-none">+</span>

            <div class="flex items-center gap-2.5">
              <span aria-hidden="true" class="inline-flex flex-col w-[3px] h-3.5 shrink-0 select-none">
                <span class="w-full h-1/2 bg-[var(--color-accent,#BCFF1C)]"></span>
                <span class="w-full h-1/2 bg-[var(--color-accent-complementary,#F2003C)]"></span>
              </span>
              <span class="font-sans font-black leading-none text-neutral-950 dark:text-white tracking-normal select-none text-[15px] sm:text-[16px]">
                4
              </span>
              <span class="font-sans font-medium text-[10.5px] sm:text-xs uppercase tracking-[0.5px] text-neutral-500 dark:text-neutral-400">
                PHILOSOPHY
              </span>
            </div>

            <div aria-hidden="true" class="flex items-center gap-1 select-none pointer-events-none">
              <span class="w-2 h-1 bg-[var(--color-accent,#BCFF1C)]"></span>
              <span class="w-2 h-1 bg-[var(--color-accent-complementary,#F2003C)]"></span>
              <span class="font-mono text-[9px] text-neutral-400 dark:text-neutral-600 pl-1">01—03</span>
            </div>
          </div>

          <!-- Section Headline & Subdeck -->
          <div class="space-y-1.5 pt-0.5">
            <h2
              id="heading-philosophy"
              class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-medium tracking-[0.5px] text-neutral-950 dark:text-white leading-[1.08] font-sans w-full m-0"
            >
                <span data-en="I build for the " data-id="Aku bikin untuk ">I build for the </span><span class="font-normal text-neutral-700 dark:text-neutral-300 underline decoration-[var(--color-accent,#BCFF1C)] decoration-2 underline-offset-4" data-en="thing" data-id="produknya">thing</span><span data-en=", not the stack." data-id=", bukan sekadar stacknya.">, not the stack.</span>
              </h2>
              <!-- 2-line Lyrics Rotator replacing original subdeck -->
              <div
                id="lyrics-rotator-container"
                class="overflow-hidden relative max-w-3xl pt-1 pl-3.5 border-l border-neutral-200 dark:border-neutral-800"
                aria-live="polite"
              >
                <span aria-hidden="true" class="absolute -left-[1px] top-1.5 w-[2px] h-3.5 bg-[var(--color-accent-complementary,#F2003C)]"></span>
                <div
                  id="lyrics-rotator-track"
                  class="relative space-y-1.5 font-serif italic text-neutral-600 dark:text-neutral-300 leading-relaxed transition-transform duration-600 ease-out"
                >
                  <p class="lyrics-line lyrics-line-active m-0">A little bit of webapp in my life,</p>
                  <p class="lyrics-line lyrics-line-edge m-0">a little bit of vscode by my side,</p>
                  <p class="lyrics-line lyrics-line-hidden m-0">a little bit of dashboard all I need,</p>
                  <p class="lyrics-line lyrics-line-hidden m-0">a little bit of touchscreen kiosk what I see,</p>
                  <p class="lyrics-line lyrics-line-hidden m-0">a little bit of 12v in the sun,</p>
                  <p class="lyrics-line lyrics-line-hidden m-0">a little bit of solder all night long,</p>
                  <p class="lyrics-line lyrics-line-hidden m-0">a little bit of LED, here I am,</p>
                  <p class="lyrics-line lyrics-line-hidden m-0">a little bit of git makes me your guy...</p>
                  <!-- Seamless wrap clones -->
                  <p class="lyrics-line lyrics-line-hidden m-0" aria-hidden="true">A little bit of webapp in my life,</p>
                  <p class="lyrics-line lyrics-line-hidden m-0" aria-hidden="true">a little bit of vscode by my side,</p>
                </div>
              </div>
            </div>
          </div>

        <!-- Section 04 High-Contrast Editorial Architecture -->
        <div class="space-y-12 sm:space-y-16 pt-8 sm:pt-12">
          <!-- Top Row: 3 Core Principles (Expanded horizontal editorial spread) -->
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span aria-hidden="true" class="w-1.5 h-1.5 bg-[var(--color-accent,#BCFF1C)]"></span>
                <div class="text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
                  Core Principles
                </div>
              </div>
              <span aria-hidden="true" class="font-mono text-[10px] text-neutral-400 dark:text-neutral-600 select-none">┌───┐</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 divide-y md:divide-y-0 md:divide-x divide-neutral-200 dark:divide-neutral-800 items-stretch pt-2">
              <!-- Principle 01 -->
              <div class="relative flex flex-col space-y-3 pt-6 md:pt-0 md:pr-6 first:pt-0">
                <div class="flex items-baseline gap-2.5">
                  <span class="font-mono text-xs font-light text-[var(--color-accent,#BCFF1C)]">01</span>
                  <h3
                    class="font-sans font-medium text-lg sm:text-xl text-neutral-950 dark:text-white tracking-tight m-0"
                    data-en="Purpose before technology"
                    data-id="Tujuan mendahului teknologi"
                  >
                    Purpose before technology
                  </h3>
                </div>
                <p
                  class="text-sm sm:text-[14.5px] text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal m-0"
                  data-en="Tools serve the outcome. Focus first on what needs to be solved, who uses it, and removing friction."
                  data-id="Alat mengikuti tujuan. Fokus utama pada masalah yang diselesaikan, siapa penggunanya, dan menghilangkan friksi."
                >
                  Tools serve the outcome. Focus first on what needs to be solved,
                  who uses it, and removing friction.
                </p>
              </div>

              <!-- Principle 02 -->
              <div class="relative flex flex-col space-y-3 pt-6 md:pt-0 md:px-6">
                <span aria-hidden="true" class="hidden md:block absolute -top-2 -left-[4.5px] font-mono text-[10px] leading-none text-neutral-400/70 dark:text-neutral-600 select-none pointer-events-none">+</span>
                <div class="flex items-baseline gap-2.5">
                  <span class="font-mono text-xs font-light text-[var(--color-accent-complementary,#F2003C)]">02</span>
                  <h3
                    class="font-sans font-medium text-lg sm:text-xl text-neutral-950 dark:text-white tracking-tight m-0"
                    data-en="Complexity by necessity"
                    data-id="Kompleksitas seperlunya saja"
                  >
                    Complexity by necessity
                  </h3>
                </div>
                <p
                  class="text-sm sm:text-[14.5px] text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal m-0"
                  data-en="Build for what the problem actually demands. No speculative over-engineering, just clean systems that work."
                  data-id="Bangun sesuai kebutuhan nyata. Tanpa over-engineering berlebihan, cukup sistem yang bersih dan tepat sasaran."
                >
                  Build for what the problem actually demands. No speculative
                  over-engineering, just clean systems that work.
                </p>
              </div>

              <!-- Principle 03 -->
              <div class="relative flex flex-col space-y-3 pt-6 md:pt-0 md:pl-6">
                <span aria-hidden="true" class="hidden md:block absolute -top-2 -left-[4.5px] font-mono text-[10px] leading-none text-neutral-400/70 dark:text-neutral-600 select-none pointer-events-none">+</span>
                <div class="flex items-baseline gap-2.5">
                  <span class="font-mono text-xs font-light text-[var(--color-accent,#BCFF1C)]">03</span>
                  <h3
                    class="font-sans font-medium text-lg sm:text-xl text-neutral-950 dark:text-white tracking-tight m-0"
                    data-en="Everything works together"
                    data-id="Semua bagian saling terhubung"
                  >
                    Everything works together
                  </h3>
                </div>
                <p
                  class="text-sm sm:text-[14.5px] text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal m-0"
                  data-en="Great UI is only half the picture. The real craft is tying it cleanly to the backend, data, and hardware underneath."
                  data-id="UI yang baik baru separuh cerita. Kuncinya menghubungkannya secara mulus ke backend, data, dan hardware di baliknya."
                >
                  Great UI is only half the picture. The real craft is tying it
                  cleanly to the backend, data, and hardware underneath.
                </p>
              </div>
            </div>
          </div>

          <!-- Middle Row: Ideal Outcome Benchmark (Quote & nothing on left, disclaimer text on right) -->
          <div class="relative border-t border-neutral-200/80 dark:border-neutral-800/80 pt-10 sm:pt-12">
            <span aria-hidden="true" class="absolute -top-[6px] left-0 font-mono text-[10px] leading-none text-neutral-400/70 dark:text-neutral-600 select-none pointer-events-none">+</span>
            <span aria-hidden="true" class="absolute -top-[6px] right-0 font-mono text-[10px] leading-none text-neutral-400/70 dark:text-neutral-600 select-none pointer-events-none">+</span>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-start">
              <!-- Left: Ideal Outcome Section Label + Quote "___" with (nothing) on the side -->
              <div class="lg:col-span-5 flex flex-col space-y-3.5 sm:space-y-4 select-none">
                <div class="flex items-center gap-2">
                  <span aria-hidden="true" class="w-1.5 h-1.5 bg-[var(--color-accent-complementary,#F2003C)]"></span>
                  <span class="text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 block">
                    Ideal Testimonial Outcome:
                  </span>
                </div>
                <div class="relative inline-flex items-baseline gap-2 sm:gap-2.5 pl-3 border-l-2 border-[var(--color-accent,#BCFF1C)]">
                  <span class="font-serif italic text-4xl sm:text-5xl lg:text-6xl text-neutral-900 dark:text-white leading-none tracking-tight">
                    “___”
                  </span>
                  <span class="font-mono text-xs sm:text-[13px] text-[var(--color-accent-complementary,#F2003C)] font-light">
                    (nothing)
                  </span>
                </div>
              </div>

              <!-- Right: Explanatory paragraph treated like a quiet disclaimer note -->
              <div class="lg:col-span-7 flex flex-col justify-center pt-1 lg:pt-2 space-y-3">
                <p
                  data-en="When the software gets out of the way, and does what it's supposed to do, it leaves nothing for the user to complain about. Great systems shouldn't ask for applause, they just work."
                  data-id="Ketika aplikasinya bekerja mulus tanpa kendala, pengguna nggak punya alasan buat mengeluh. Sistem yang hebat nggak perlu minta tepuk tangan, cukup bekerja sesuai fungsinya."
                  class="font-sans text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed font-normal m-0 max-w-xl"
                >
                  When the software gets out of the way, and does what it's supposed to do, it leaves nothing for the user to complain about. Great systems shouldn't ask for applause, they just work.
                </p>
                <div aria-hidden="true" class="flex items-center gap-1 pt-1 select-none pointer-events-none">
                  <span class="w-3 h-1 bg-[var(--color-accent,#BCFF1C)]"></span>
                  <span class="w-3 h-1 bg-[var(--color-accent-complementary,#F2003C)]"></span>
                  <span class="w-1.5 h-1 bg-neutral-300 dark:bg-neutral-800"></span>
                  <span class="w-1.5 h-1 bg-neutral-300 dark:bg-neutral-800"></span>
                </div>
              </div>
            </div>
          </div>

        </div>

        <style is:global>
          #lyrics-rotator-container {
            -webkit-mask-image: linear-gradient(to bottom, black 65%, transparent 100%);
            mask-image: linear-gradient(to bottom, black 65%, transparent 100%);
          }

          #lyrics-rotator-track.no-transition,
          #lyrics-rotator-track.no-transition .lyrics-line {
            transition: none !important;
          }

          #lyrics-rotator-track .lyrics-line {
            font-size: 0.875rem; /* text-sm: 14px */
            line-height: 1.6;
            letter-spacing: normal;
            transition: transform 500ms cubic-bezier(0.25, 1, 0.5, 1),
                        opacity 500ms cubic-bezier(0.25, 1, 0.5, 1),
                        filter 500ms cubic-bezier(0.25, 1, 0.5, 1),
                        color 350ms ease;
            transform-origin: left center;
            cursor: pointer;
            user-select: none;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
          }

          @media (min-width: 640px) {
            #lyrics-rotator-track .lyrics-line {
              font-size: 1rem; /* text-base: 16px */
            }
          }

          /* Active Focal Lyric: Muted editorial tone */
          #lyrics-rotator-track .lyrics-line-active {
            opacity: 0.88 !important;
            transform: scale(1.02) translateZ(0) !important;
            filter: blur(0px) !important;
            color: #404040 !important; /* neutral-700 instead of harsh #0a0a0a */
            cursor: default;
          }

          .dark #lyrics-rotator-track .lyrics-line-active {
            color: #d4d4d4 !important; /* neutral-300 instead of stark white */
            text-shadow: none !important;
          }

          /* Inactive Defocused Next Lyric: Muted background preview */
          #lyrics-rotator-track .lyrics-line-edge {
            opacity: 0.32 !important;
            transform: scale(0.97) translateZ(0) !important;
            filter: blur(0.8px) !important;
            color: #8c8c8c !important; /* softer neutral */
          }

          .dark #lyrics-rotator-track .lyrics-line-edge {
            color: #737373 !important;
          }

          /* Hover Peek */
          #lyrics-rotator-track .lyrics-line-edge:hover {
            opacity: 0.65 !important;
            filter: blur(0px) !important;
            transform: scale(0.99) translateZ(0) !important;
            color: #525252 !important;
          }

          .dark #lyrics-rotator-track .lyrics-line-edge:hover {
            color: #a3a3a3 !important;
          }

          /* Hidden lines outside 2-line portal */
          #lyrics-rotator-track .lyrics-line-hidden {
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
            filter: blur(2px) !important;
            transform: scale(0.9) translateZ(0) !important;
          }

          @media (prefers-reduced-motion: reduce) {
            #lyrics-rotator-track,
            #lyrics-rotator-track .lyrics-line {
              transition: none !important;
              filter: none !important;
              transform: none !important;
            }
          }
        </style>

        <script>
          function setupPhilosophyAccordions() {
            const items = document.querySelectorAll('.philosophy-item');
            items.forEach((item) => {
              const trigger = item.querySelector('.philosophy-trigger');
              const panel = item.querySelector('.philosophy-panel');
              const chevron = item.querySelector('.chevron-icon');

              if (!trigger || !panel) return;
              if ((trigger as any).__accordionBound) return;
              (trigger as any).__accordionBound = true;

              trigger.addEventListener('click', () => {
                const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
                trigger.setAttribute('aria-expanded', String(!isExpanded));

                if (!isExpanded) {
                  panel.classList.remove('grid-rows-[0fr]', 'opacity-0');
                  panel.classList.add('grid-rows-[1fr]', 'opacity-100');
                  chevron?.classList.add('rotate-180');
                } else {
                  panel.classList.remove('grid-rows-[1fr]', 'opacity-100');
                  panel.classList.add('grid-rows-[0fr]', 'opacity-0');
                  chevron?.classList.remove('rotate-180');
                }
              });
            });
          }

          function setupLyricsRotator() {
            const container = document.getElementById("lyrics-rotator-container");
            const track = document.getElementById("lyrics-rotator-track");
            if (!container || !track) return;

            const items = track.children as HTMLCollectionOf<HTMLElement>;
            if (items.length < 4) return;

            let currentIndex = 0;
            const totalLines = 8;
            let isPaused = false;
            let intervalId: any = null;

            function updateFocus(idx: number) {
              for (let i = 0; i < items.length; i++) {
                const item = items[i];
                if (i === idx) {
                  item.classList.add("lyrics-line-active");
                  item.classList.remove("lyrics-line-edge", "lyrics-line-hidden");
                } else if (i === idx + 1) {
                  item.classList.add("lyrics-line-edge");
                  item.classList.remove("lyrics-line-active", "lyrics-line-hidden");
                } else {
                  item.classList.add("lyrics-line-hidden");
                  item.classList.remove("lyrics-line-active", "lyrics-line-edge");
                }
              }
            }

            function updateHeight() {
              if (items.length >= 2) {
                // Height encompasses exactly the 2 active lines (idx and idx+1)
                const h = (items[1].offsetTop + items[1].offsetHeight) - items[0].offsetTop;
                if (h > 0) {
                  container.style.height = `${h}px`;
                }
              }
            }

            function goToIndex(idx: number) {
              currentIndex = idx;
              track.style.transition = "transform 550ms cubic-bezier(0.25, 1, 0.5, 1)";
              const targetOffset = items[currentIndex]?.offsetTop || 0;
              track.style.transform = `translateY(-${targetOffset}px)`;
              updateFocus(currentIndex);
            }

            function step() {
              if (isPaused) return;
              currentIndex++;
              track.style.transition = "transform 600ms cubic-bezier(0.25, 1, 0.5, 1)";
              const targetOffset = items[currentIndex]?.offsetTop || 0;
              track.style.transform = `translateY(-${targetOffset}px)`;
              updateFocus(currentIndex);

              if (currentIndex >= totalLines) {
                setTimeout(() => {
                  track.classList.add("no-transition");
                  currentIndex = 0;
                  track.style.transform = "translateY(0)";
                  updateFocus(0);
                  void track.offsetHeight;
                  requestAnimationFrame(() => {
                    track.classList.remove("no-transition");
                  });
                }, 620);
              }
            }

            for (let i = 0; i < totalLines; i++) {
              items[i].addEventListener("click", () => {
                goToIndex(i);
              });
            }

            updateFocus(0);
            updateHeight();
            if ("fonts" in document) {
              document.fonts.ready.then(updateHeight);
            }

            const onResize = () => updateHeight();
            window.addEventListener("resize", onResize, { passive: true });

            container.addEventListener("mouseenter", () => {
              isPaused = true;
            });
            container.addEventListener("mouseleave", () => {
              isPaused = false;
            });

            const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (!prefersReducedMotion) {
              intervalId = setInterval(step, 3200);
            }

            const onVisibilityChange = () => {
              if (document.hidden) {
                if (intervalId) clearInterval(intervalId);
                intervalId = null;
              } else if (!prefersReducedMotion && !intervalId) {
                intervalId = setInterval(step, 3200);
                updateHeight();
              }
            };
            document.addEventListener("visibilitychange", onVisibilityChange);

            document.addEventListener(
              "astro:before-swap",
              () => {
                if (intervalId) clearInterval(intervalId);
                window.removeEventListener("resize", onResize);
                document.removeEventListener("visibilitychange", onVisibilityChange);
              },
              { once: true }
            );
          }

          function initSection4() {
            setupPhilosophyAccordions();
            setupLyricsRotator();
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSection4);
          } else {
            initSection4();
          }
          document.addEventListener('astro:page-load', initSection4);
        </script>
      </section>
    </div>
  </div>{/* end page wrapper */}
</RootLayout>
