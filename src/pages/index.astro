---
import RootLayout from "../layouts/RootLayout.astro";
import Hero from "../components/Hero.astro";
import StatusBadge from "../components/StatusBadge.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import ActionButton from "../components/ActionButton.astro";
import ProjectTile from "../components/ProjectTile.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;

const coreStack = [
  {
    name: "Laravel",
    category: "Backend Architecture",
    icon: "ti-brand-laravel",
  },
  { name: "React", category: "UI Engineering", icon: "ti-brand-react" },
  {
    name: "Electron",
    category: "Desktop & Kiosk OS",
    icon: "ti-device-desktop",
  },
  { name: "Astro", category: "Static & Content Web", icon: "ti-brand-astro" },
  {
    name: "Google Cloud Platform",
    category: "Cloud Infrastructure",
    icon: "ti-cloud",
  },
  { name: "Docker", category: "Containerization", icon: "ti-brand-docker" },
];

const supportingStack = [
  { name: "TypeScript", icon: "ti-brand-typescript" },
  { name: "JavaScript", icon: "ti-brand-javascript" },
  { name: "PHP", icon: "ti-brand-php" },
  { name: "Node.js", icon: "ti-brand-nodejs" },
  { name: "Vite", icon: "ti-brand-vite" },
  { name: "Tailwind CSS v4", icon: "ti-brand-tailwind" },
  { name: "CSS Modules", icon: "ti-brand-css3" },
  { name: "WebSockets", icon: "ti-broadcast" },
  { name: "RESTful APIs", icon: "ti-api" },
  { name: "Filament", icon: "ti-layout-dashboard" },
  { name: "SQLite", icon: "ti-database" },
  { name: "MySQL", icon: "ti-brand-mysql" },
  { name: "Google Cloud Storage", icon: "ti-cloud-upload" },
  { name: "SNAP API", icon: "ti-credit-card" },
  { name: "Anime.js", icon: "ti-sparkles" },
  { name: "Leaflet.js", icon: "ti-map" },
  { name: "Chart.js", icon: "ti-chart-line" },
  { name: "Git & GitHub", icon: "ti-brand-github" },
  { name: "GitHub Pages", icon: "ti-brand-git" },
  { name: "OWASP Guidelines", icon: "ti-shield-check" },
];
---

<RootLayout
  title="Yovan Gunardio Darmawan | Software Engineer & Builder"
  description="Hey, I'm Yovan, a developer who likes turning weird ideas into working products. Building web apps, touchscreen kiosks, and physical hardware experiences."
>



  <!-- JAM Digital Clock Floating Popup (Component Library 07: Project Tile / Case Study Card) -->
  <div
    id="egg-popup"
    class="popup-hidden fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 w-[92vw] max-w-[390px] sm:max-w-[420px] flex flex-col font-sans"
  >
    <!-- Floating Dismiss Text Above Popup (Pure Red Text, No Container) -->
    <div class="flex justify-end mb-1">
      <button
        id="egg-popup-close"
        type="button"
        aria-label="Dismiss popup"
        class="font-mono text-xs text-red-500 hover:text-red-600 dark:text-red-400 dark:hover:text-red-300 hover:underline cursor-pointer select-none transition-colors p-0 bg-transparent border-0"
      >
        Dismiss x [esc]
      </button>
    </div>

    <!-- Popup Card -->
    <div class="w-full bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300/80 dark:border-neutral-800 shadow-2xl shadow-black/40 overflow-hidden flex flex-col">
      <!-- Media / Viewfinder Container (Exact Original Jam Digital HTML via Iframe) -->
      <div class="relative w-full aspect-[16/9.5] bg-[#17D4FE] overflow-hidden border-b border-neutral-300/80 dark:border-neutral-800/80 select-none flex items-center justify-center">
        <iframe
          src={`${base}/whatisthis/jAM_jAvaSCriPt.html`}
          title="Jam Digital"
          class="border-0 pointer-events-none select-none shrink-0"
          style="width: 1440px; height: 855px; transform: scale(0.28); transform-origin: center center;"
          loading="eager"
        ></iframe>
      </div>

      <!-- Content Section (Project Tile Format) -->
      <div class="p-4 sm:p-5 flex flex-col flex-1 gap-3">
        <!-- Category Tag -->
        <span class="font-sans text-[11px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold">
          00 // EASTER EGG
        </span>

        <!-- Title -->
        <h3 class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight leading-tight font-heading">
          Jam Digital (JavaScript Clock)
        </h3>

        <!-- Description -->
        <p class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal">
          An early standalone digital clock project built with vanilla JavaScript, CSS text-shadow layering, and DOM timer manipulation.
        </p>

        <!-- Tags Row -->
        <div class="flex flex-wrap gap-1.5 pt-0.5">
          <span class="font-sans text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2.5 py-0.5 rounded">
            VANILLA JS
          </span>
          <span class="font-sans text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2.5 py-0.5 rounded">
            CSS3 SHADOWS
          </span>
          <span class="font-sans text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2.5 py-0.5 rounded">
            SETTIMEOUT
          </span>
        </div>

        <!-- Metadata Footer -->
        <div class="mt-auto pt-3 border-t border-neutral-200/80 dark:border-neutral-800/80 flex items-center">
          <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500 truncate">
            JAM_jAvaSCriPt.html
          </span>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Popup slide/fade animation */
    #egg-popup {
      transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #egg-popup.popup-hidden {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
      pointer-events: none;
    }
    #egg-popup.popup-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    /* Easter egg fragments on the back */
    .egg-static {
      opacity: 0.08;
      user-select: none;
      pointer-events: none;
      transition: opacity 0.2s ease, text-decoration 0.2s ease;
    }
    .egg-label-hover {
      opacity: 0.75 !important;
      text-decoration: underline !important;
      text-underline-offset: 4px;
    }

    /* Hitbox in front */
    .egg-hitbox {
      background: transparent;
      border: none;
      cursor: pointer !important;
      user-select: none;
      opacity: 0;
    }
  </style>

  <script>
    (function () {
      function openPopup() {
        const popup = document.getElementById('egg-popup');
        if (!popup) return;
        popup.classList.remove('popup-hidden');
        popup.classList.add('popup-visible');
      }

      function closePopup() {
        const popup = document.getElementById('egg-popup');
        if (!popup) return;
        popup.classList.remove('popup-visible');
        popup.classList.add('popup-hidden');
      }

      function togglePopup() {
        const popup = document.getElementById('egg-popup');
        if (popup && popup.classList.contains('popup-visible')) {
          closePopup();
        } else {
          openPopup();
        }
      }

      // Mouseover/mouseout for hitbox -> label hover link
      document.addEventListener('mouseover', (e) => {
        const target = e.target as HTMLElement | null;
        const hitbox = target?.closest?.('[data-target-label]') as HTMLElement | null;
        if (hitbox) {
          const labelId = hitbox.getAttribute('data-target-label');
          if (labelId) document.getElementById(labelId)?.classList.add('egg-label-hover');
        }
      });

      document.addEventListener('mouseout', (e) => {
        const target = e.target as HTMLElement | null;
        const hitbox = target?.closest?.('[data-target-label]') as HTMLElement | null;
        if (hitbox) {
          const labelId = hitbox.getAttribute('data-target-label');
          if (labelId) document.getElementById(labelId)?.classList.remove('egg-label-hover');
        }
      });

      // Event delegation on document to guarantee clicks are captured
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        const eggBtn = target.closest('[data-easter="jam-clock"]');
        if (eggBtn) {
          e.preventDefault();
          e.stopPropagation();
          togglePopup();
          return;
        }

        const closeBtn = target.closest('#egg-popup-close, #egg-popup-dismiss');
        if (closeBtn) {
          e.preventDefault();
          closePopup();
          return;
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closePopup();
      });
    })();
  </script>

  <!-- page wrapper — position: relative so easter eggs scatter through scroll height -->
  <div class="relative">

    <!-- ░░ EASTER EGGS — Visual labels in background (z-0) ░░ -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <!-- 01: setTimeout(showTime, 1000); (Hero Top Left) -->
      <span class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[-5deg]" style="top:2%;left:2.5%;">setTimeout(showTime, 1000);</span>
      
      <!-- 02: WS2812B (Hero Right) -->
      <span class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[4deg]" style="top:11%;right:2%;">WS2812B</span>
      
      <!-- 03: GPIO16 (Between Hero & Sec 01) -->
      <span class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[-3deg]" style="top:21%;left:1.5%;">GPIO16</span>
      
      <!-- 04: DateTime.Now (Sec 01 / Sec 02 Gap - ACTIVE EASTER EGG VISUAL) -->
      <span id="egg-label-jam" class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[4deg]" style="top:31%;right:2%;">DateTime.Now</span>
      
      <!-- 05: Node_12 (Sec 02 / Sec 03 Gap) -->
      <span class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[-4deg]" style="top:44%;left:2%;">Node_12</span>
      
      <!-- 06: ASCII_RENDERER (Sec 03 / Sec 04 Gap) -->
      <span class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[3deg]" style="top:55%;right:1.5%;">ASCII_RENDERER</span>
      
      <!-- 07: since(2026); (Sec 04 / Sec 05 Gap) -->
      <span class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[-4deg]" style="top:66%;left:2%;">since(2026);</span>
      
      <!-- 08: process.env.PORT || 8080 -->
      <span class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[5deg]" style="top:75%;right:3%;">process.env.PORT || 8080</span>
      
      <!-- 09: struct Pixel { r: u8, g: u8, b: u8 } (Sec 06 / Sec 07 Gap) -->
      <span class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[2deg]" style="top:89%;left:1.5%;">struct Pixel &#123; r: u8, g: u8, b: u8 &#125;</span>
      
      <!-- 10: 0x7F454C46 (Footer Area) -->
      <span class="egg-static absolute font-mono text-xs text-neutral-600 dark:text-neutral-300 select-none rotate-[-3deg]" style="top:98%;right:2%;">0x7F454C46</span>
    </div>

    <!-- ░░ EASTER EGGS — Clickable Hitbox Layer in Front (z-30) ░░ -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-30">
      <!-- Hitbox for DateTime.Now -> Jam Digital -->
      <button
        type="button"
        data-easter="jam-clock"
        data-target-label="egg-label-jam"
        class="egg-hitbox absolute pointer-events-auto p-3 font-mono text-xs rotate-[4deg]"
        style="top:30.5%;right:1.5%;"
        aria-label="Unlock Jam Digital Easter Egg"
      >
        DateTime.Now
      </button>
    </div>

    <Hero firstName="yovan" middleName="gunardio" lastName="darmawan" />

    <div class="w-[92%] sm:w-[86%] lg:w-[80%] mx-auto space-y-24 pb-28">
    <!-- 01 // OVERVIEW & HERO STATEMENT -->
    <section
      id="intro"
      class="border-t border-neutral-200 dark:border-neutral-800 pt-16 space-y-8"
    >
      <div
        class="flex items-center justify-between pb-2 border-b border-neutral-200 dark:border-neutral-800"
      >
        <span
          class="font-sans text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-bold"
        >
          01 // OVERVIEW
        </span>
      </div>

      <!-- Section Headline Header (Header 1 Full Width) -->
      <h1
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white leading-[1.12] font-heading w-full"
      >
        I build software that makes ideas real.
      </h1>

      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start pt-2"
      >
        <!-- 35% Left Column: Architecture Topology Diagram -->
        <div class="lg:col-span-5 xl:col-span-5 lg:sticky lg:top-24 space-y-4">
          <ArchitectureDiagram />
        </div>

        <!-- 65% Right Column: Narrative, Tech Stack & CTA -->
        <div class="lg:col-span-7 xl:col-span-7 space-y-6">
          <p
            class="text-base sm:text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal"
          >
            Hello, I'm Yovan. I build things for the world wide web and
            occasionally things that talk to machines.
          </p>

          <div
            class="space-y-2.5 py-1.5 pl-4 border-l-2 border-[#52FF1A]/50 font-sans text-sm sm:text-base text-neutral-600 dark:text-neutral-400"
          >
            <p class="flex items-center gap-2.5">
              <span
                class="text-[#52FF1A] text-xs font-mono select-none font-bold"
                >›</span
              >
              <span>A little bit of webapp in my life</span>
            </p>
            <p class="flex items-center gap-2.5">
              <span
                class="text-[#52FF1A] text-xs font-mono select-none font-bold"
                >›</span
              >
              <span>A little bit of vscode by my side</span>
            </p>
            <p class="flex items-center gap-2.5">
              <span
                class="text-[#52FF1A] text-xs font-mono select-none font-bold"
                >›</span
              >
              <span>A little bit of dashboard all I need</span>
            </p>
            <p class="flex items-center gap-2.5">
              <span
                class="text-[#52FF1A] text-xs font-mono select-none font-bold"
                >›</span
              >
              <span>A little bit of touchscreen kiosk  what I see</span>
            </p>
            <p class="flex items-center gap-2.5">
              <span
                class="text-[#52FF1A] text-xs font-mono select-none font-bold"
                >›</span
              >
              <span>A little bit of 12v in the sun</span>
            </p>
            <p class="flex items-center gap-2.5">
              <span
                class="text-[#52FF1A] text-xs font-mono select-none font-bold"
                >›</span
              >
              <span>A little bit of solder all night long</span>
            </p>
            <p class="flex items-center gap-2.5">
              <span
                class="text-[#52FF1A] text-xs font-mono select-none font-bold"
                >›</span
              >
              <span>A little bit of LED, here I am</span>
            </p>
            <p class="flex items-center gap-2.5">
              <span
                class="text-[#52FF1A] text-xs font-mono select-none font-bold"
                >›</span
              >
              <span>A little bit of git makes me your man</span>
            </p>
          </div>

          <p
            class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal"
          >
            I enjoy building things across the stack, from the interface people
            see to the systems making everything run behind the scenes.
          </p>

          <!-- Tech Stack Layout -->
          <div
            class="pt-6 space-y-8 border-t border-neutral-200/80 dark:border-neutral-800/80"
          >
            <div class="flex items-center justify-between">
              <span
                class="font-heading font-bold text-xs sm:text-sm uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
              >
                Core Stack
              </span>
              <span
                class="font-sans text-[11px] text-neutral-400 dark:text-neutral-500 font-medium"
              >
                {coreStack.length} core • {supportingStack.length} supporting
              </span>
            </div>

            <!-- Core Stack (Icon-as-Object: Unboxed, Breathing Grid) -->
            <div
              class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-6 sm:gap-8 pt-1"
            >
              {
                coreStack.map((tech) => (
                  <div class="flex flex-col space-y-2.5 group cursor-default">
                    <div class="text-3xl sm:text-4xl text-neutral-800 dark:text-neutral-200 group-hover:text-[#52FF1A] transition-[transform,color] duration-200 group-hover:-translate-y-1 group-hover:scale-105 inline-flex items-center">
                      <i class={`ti ${tech.icon}`} />
                    </div>
                    <div class="space-y-0.5">
                      <span class="font-heading font-bold text-sm sm:text-base text-neutral-950 dark:text-white block tracking-tight">
                        {tech.name}
                      </span>
                      <span class="font-sans text-[11px] sm:text-xs text-neutral-500 dark:text-neutral-400 block leading-tight group-hover:text-neutral-700 dark:group-hover:text-neutral-300 transition-colors">
                        {tech.category}
                      </span>
                    </div>
                  </div>
                ))
              }
            </div>

            <!-- Supporting Stack (Unboxed / Clean Inline Flow for Visual Weight Balance) -->
            <div class="pt-2 space-y-2.5">
              <span
                class="font-heading font-bold text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500 block"
              >
                Ecosystem & Supporting Tech
              </span>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2.5 pt-0.5">
                {
                  supportingStack.map((tech) => (
                    <div class="inline-flex items-center gap-1.5 text-xs text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors group">
                      <i
                        class={`ti ${tech.icon} text-sm text-neutral-400 dark:text-neutral-500 group-hover:text-[#52FF1A] transition-colors`}
                      />
                      <span class="font-sans font-medium">{tech.name}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 // PROJECTS & HYPEBOX -->
    <section
      id="projects"
      class="border-t border-neutral-200 dark:border-neutral-800 pt-16 space-y-10"
    >
      <div
        class="flex items-center justify-between pb-2 border-b border-neutral-200 dark:border-neutral-800"
      >
        <span
          class="font-sans text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-bold"
        >
          02 // FEATURED WORK
        </span>
        <a
          href={`${base}/portfolio-index`}
          class="text-xs font-semibold text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white transition-colors flex items-center gap-1"
        >
          View Full Index <span>→</span>
        </a>
      </div>

      <!-- Project Intro Copywriting -->
      <div class="space-y-3 max-w-3xl">
        <h2
          class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white leading-tight font-heading"
        >
          Things I've built
        </h2>
        <p
          class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal"
        >
          A collection of experiments, products, and projects where I tried to
          solve a problem, learn something new, or just see "what if?"
        </p>
      </div>

      <!-- Featured Spotlight: Hypebox -->
      <div
        class="border border-neutral-300/80 dark:border-neutral-800 bg-[#f6f4ee] dark:bg-[#141414] p-6 sm:p-8 space-y-8"
      >
        <!-- Hypebox Header -->
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-neutral-200/80 dark:border-neutral-800/80"
        >
          <div class="space-y-1">
            <h3
              class="text-2xl sm:text-3xl font-black tracking-tight text-neutral-950 dark:text-white leading-none font-heading"
            >
              HYPE-BOX
            </h3>
            <p
              class="text-sm font-medium text-neutral-600 dark:text-neutral-400 pt-1"
            >
              A photobooth platform, built from kiosk to backend.
            </p>
          </div>

          <a
            href="https://navoyovan.github.io/hypebox/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-neutral-950 dark:text-white bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 px-4 py-2.5 hover:border-neutral-950 dark:hover:border-white transition-all w-fit"
          >
            <span>Visit Hypebox Site</span>
            <span>↗</span>
          </a>
        </div>

        <p
          class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed max-w-3xl font-normal"
        >
          A connected photo booth system with a touchscreen-optimized Electron kiosk, Laravel backend, management dashboard, realtime communication, and integrated payments, with the broader ecosystem still in development.
        </p>

        <!-- Ecosystem Grid of Sub-systems -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-2">
          <!-- Kiosk Hero Subsystem (Full Width with 35% Screenshot Box) -->
          <div
            class="col-span-1 md:col-span-3 p-6 sm:p-8 border border-neutral-300/90 dark:border-neutral-700/80 bg-white/90 dark:bg-neutral-900/60 shadow-sm"
          >
            <div class="flex flex-col lg:flex-row items-stretch justify-between gap-6 lg:gap-8">
              <!-- 65% Left Column: Copy & Specs & CTA (Bottom-aligned ActionButton) -->
              <div class="w-full lg:w-[65%] flex flex-col justify-between space-y-6">
                <div class="space-y-4">
                  <div class="space-y-2">
                    <span class="text-[11px] font-mono text-neutral-500 font-semibold tracking-wider block">
                      ELECTRON / REACT
                    </span>
                    <div class="flex flex-wrap items-baseline justify-between sm:justify-start sm:gap-4">
                      <h4
                        class="text-xl sm:text-2xl font-bold text-neutral-950 dark:text-white font-heading tracking-tight"
                      >
                        Photobooth Kiosk
                      </h4>
                      <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">
                        Touchscreen & Hardware Engine
                      </span>
                    </div>
                  </div>
                  <p
                    class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed"
                  >
                    Standalone touchscreen software engineered for event kiosks, orchestrating real-time camera feeds, countdown capture loops, physical thermal printing, and seamless offline-tolerant hardware communication.
                  </p>
                </div>
                <div class="pt-3">
                  <ActionButton
                    variant="secondary"
                    size="md"
                    href="https://navoyovan.github.io/photobooth-kiosk-demo/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-fit text-xs sm:text-sm"
                  >
                    Launch Kiosk Demo ↗
                  </ActionButton>
                </div>
              </div>

