  <style>
    /* Popup slide/fade animation */
    .egg-popup-modal {
      transition:
        opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .egg-popup-modal.popup-hidden {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
      pointer-events: none;
    }
    .egg-popup-modal.popup-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    /* Easter egg fragments on the back */
    .egg-static {
      opacity: 0.08;
      user-select: none;
      pointer-events: none;
      transition:
        opacity 0.2s ease,
        text-decoration 0.2s ease;
    }
    .egg-label-hover {
      opacity: 0.75 !important;
      text-decoration: underline !important;
      text-underline-offset: 4px;
    }

    /* Hitbox in front */
    .egg-hitbox {
      background: transparent;
      border: none;
      cursor: pointer !important;
      user-select: none;
      opacity: 0;
    }
  </style>

  <script>
    (function () {
      let lastFocusedElement: HTMLElement | null = null;

      function closeAllPopups() {
        document.querySelectorAll(".egg-popup-modal").forEach((p) => {
          const el = p as HTMLElement;
          el.style.transform = "";
          el.style.opacity = "";
          el.style.transition = "";
          el.classList.remove("popup-visible");
          el.classList.add("popup-hidden");
        });
        document.querySelectorAll(".egg-popup-modal video").forEach((v) => {
          const video = v as HTMLVideoElement;
          video.pause();
          video.currentTime = 0;
        });
        const backdrop = document.getElementById("egg-backdrop");
        if (backdrop) {
          backdrop.classList.remove("opacity-100", "pointer-events-auto");
          backdrop.classList.add("opacity-0", "pointer-events-none");
        }
        document.documentElement.style.overflow = "";
        document.body.style.overflow = "";

        if (lastFocusedElement && document.contains(lastFocusedElement)) {
          lastFocusedElement.focus();
        }
        lastFocusedElement = null;
      }

      function openPopup(id: string) {
        lastFocusedElement = document.activeElement as HTMLElement | null;
        closeAllPopups();
        const popup = document.getElementById(id);
        if (!popup) return;
        const iframe = popup.querySelector(
          "iframe[data-src]",
        ) as HTMLIFrameElement | null;
        if (iframe && !iframe.src) {
          iframe.src = iframe.dataset.src || "";
        }
        const video = popup.querySelector(
          "video[data-src]",
        ) as HTMLVideoElement | null;
        if (video) {
          if (!video.src) {
            video.src = video.dataset.src || "";
          }
          video.play().catch(() => {});
        }
        popup.style.transform = "";
        popup.style.opacity = "";
        popup.style.transition = "";
        popup.classList.remove("popup-hidden");
        popup.classList.add("popup-visible");

        // Focus close button inside popup for screen readers & keyboard users
        requestAnimationFrame(() => {
          const closeBtn = popup.querySelector<HTMLElement>(".egg-popup-close");
          closeBtn?.focus();
        });

        // Only lock background scroll and activate backdrop overlay on mobile screens (< 640px)
        if (window.innerWidth < 640) {
          const backdrop = document.getElementById("egg-backdrop");
          if (backdrop) {
            backdrop.classList.remove("opacity-0", "pointer-events-none");
            backdrop.classList.add("opacity-100", "pointer-events-auto");
          }
          document.documentElement.style.overflow = "hidden";
          document.body.style.overflow = "hidden";
        }
      }

      function togglePopup(id: string) {
        const popup = document.getElementById(id);
        if (popup && popup.classList.contains("popup-visible")) {
          closeAllPopups();
        } else {
          openPopup(id);
        }
      }

      // Ensure desktop resize cleanly clears any mobile scroll locks
      window.addEventListener("resize", () => {
        if (window.innerWidth >= 640) {
          document.documentElement.style.overflow = "";
          document.body.style.overflow = "";
          const backdrop = document.getElementById("egg-backdrop");
          if (backdrop) {
            backdrop.classList.remove("opacity-100", "pointer-events-auto");
            backdrop.classList.add("opacity-0", "pointer-events-none");
          }
        }
      });

      // Backdrop dismiss click and touchmove block
      const backdrop = document.getElementById("egg-backdrop");
      if (backdrop) {
        backdrop.addEventListener("click", () => {
          closeAllPopups();
        });
        backdrop.addEventListener(
          "touchmove",
          (e) => {
            if (e.cancelable) e.preventDefault();
          },
          { passive: false },
        );
      }

      // Touch swipe-down to dismiss on mobile
      document.querySelectorAll(".egg-popup-modal").forEach((popupEl) => {
        const popup = popupEl as HTMLElement;
        let startY = 0;
        let currentY = 0;
        let isDragging = false;
        let startTime = 0;

        popup.addEventListener(
          "touchstart",
          (e) => {
            if (!popup.classList.contains("popup-visible")) return;
            if ((e.target as HTMLElement)?.closest(".egg-popup-close")) return;
            startY = e.touches[0].clientY;
            currentY = startY;
            startTime = Date.now();
            isDragging = true;
            popup.style.transition = "none";
          },
          { passive: true },
        );

        popup.addEventListener(
          "touchmove",
          (e) => {
            if (!isDragging) return;
            currentY = e.touches[0].clientY;
            const deltaY = currentY - startY;
            if (deltaY > 0) {
              if (e.cancelable) e.preventDefault();
              popup.style.transform = `translateY(${deltaY}px)`;
              popup.style.opacity = `${Math.max(0.1, 1 - deltaY / 280)}`;
            }
          },
          { passive: false },
        );

        const endDrag = () => {
          if (!isDragging) return;
          isDragging = false;
          const deltaY = currentY - startY;
          const duration = Date.now() - startTime;
          const velocity = deltaY / (duration || 1);

          popup.style.transition = "";

          // If dragged down > 60px or fast flick downward (> 0.4px/ms)
          if (deltaY > 60 || (velocity > 0.4 && deltaY > 20)) {
            popup.style.transform = "translateY(120px)";
            popup.style.opacity = "0";
            setTimeout(() => {
              closeAllPopups();
            }, 180);
          } else {
            popup.style.transform = "";
            popup.style.opacity = "";
          }
        };

        popup.addEventListener("touchend", endDrag, { passive: true });
        popup.addEventListener("touchcancel", endDrag, { passive: true });
      });

      // Mouseover/mouseout for hitbox -> label hover link
      document.addEventListener("mouseover", (e) => {
        const target = e.target as HTMLElement | null;
        const hitbox = target?.closest?.(
          "[data-target-label]",
        ) as HTMLElement | null;
        if (hitbox) {
          const labelId = hitbox.getAttribute("data-target-label");
          if (labelId)
            document.getElementById(labelId)?.classList.add("egg-label-hover");
        }
      });

      document.addEventListener("mouseout", (e) => {
        const target = e.target as HTMLElement | null;
        const hitbox = target?.closest?.(
          "[data-target-label]",
        ) as HTMLElement | null;
        if (hitbox) {
          const labelId = hitbox.getAttribute("data-target-label");
          if (labelId)
            document
              .getElementById(labelId)
              ?.classList.remove("egg-label-hover");
        }
      });

      // Event delegation on document to guarantee clicks are captured
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        const eggBtn = target.closest("[data-easter]");
        if (eggBtn) {
          e.preventDefault();
          e.stopPropagation();
          const easterType = eggBtn.getAttribute("data-easter");
          if (easterType === "jam-clock") {
            togglePopup("egg-popup-clock");
          } else if (easterType === "modpe") {
            togglePopup("egg-popup-modpe");
          } else if (easterType === "ws2812b" || easterType === "gpio") {
            togglePopup("egg-popup-ws2812b");
          }
          return;
        }

        const closeBtn = target.closest(".egg-popup-close");
        if (closeBtn) {
          e.preventDefault();
          closeAllPopups();
          return;
        }
      });

      // Keyboard Trap & Escape Handling for Dialog Modals
      document.addEventListener("keydown", (e) => {
        const activePopup = document.querySelector<HTMLElement>(
          ".egg-popup-modal.popup-visible",
        );
        if (!activePopup) return;

        if (e.key === "Escape") {
          e.preventDefault();
          closeAllPopups();
          return;
        }

        if (e.key === "Tab") {
          const focusables = Array.from(
            activePopup.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
            ),
          ).filter(
            (el) => !el.hasAttribute("disabled") && el.offsetParent !== null,
          );

          if (focusables.length === 0) return;
          const firstEl = focusables[0];
          const lastEl = focusables[focusables.length - 1];

          if (e.shiftKey) {
            if (document.activeElement === firstEl) {
              e.preventDefault();
              lastEl.focus();
            }
          } else {
            if (document.activeElement === lastEl) {
              e.preventDefault();
              firstEl.focus();
            }
          }
        }
      });
    })();
  </script>

